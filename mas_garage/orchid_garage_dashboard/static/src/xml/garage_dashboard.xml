<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ── KPI Card ──────────────────────────────────────────────────────── -->
    <t t-name="orchid_garage_dashboard.KpiCard">
        <div t-attf-class="gd-kpi-card #{props.color} #{props.onClick ? 'gd-kpi-clickable' : ''}"
             t-on-click="props.onClick">
            <div class="gd-kpi-body">
                <div class="gd-kpi-value">
                    <t t-if="props.loading">
                        <span class="gd-skeleton"/>
                    </t>
                    <t t-else="">
                        <t t-esc="props.value"/>
                    </t>
                </div>
                <div class="gd-kpi-label"><t t-esc="props.label"/></div>
                <t t-if="props.sub">
                    <div class="gd-kpi-sub">
                        <t t-if="props.loading"><span class="gd-skeleton gd-skeleton-sm"/></t>
                        <t t-else=""><t t-esc="props.sub"/></t>
                    </div>
                </t>
            </div>
            <!-- Visible icon box (right side) -->
            <div class="gd-kpi-icon-wrap">
                <i t-attf-class="fa #{props.icon}"/>
            </div>
        </div>
    </t>

    <!-- ── Main Dashboard ────────────────────────────────────────────────── -->
    <t t-name="orchid_garage_dashboard.Dashboard">
        <div class="gd-root">

            <!-- Hero Banner Card (white card, dark-teal left, diagonal slash, light right) -->
            <div class="gd-hero-card">
                <div class="gd-hero-dark">
                    <div class="gd-hero-eyebrow">GARAGE CONTROL</div>
                    <h1 class="gd-hero-title">
                        <i class="fa fa-wrench"/>Dashboard
                    </h1>
                    <p class="gd-hero-sub">Job orders and invoices</p>
                </div>
                <div class="gd-hero-light">
                    <button class="gd-refresh-btn" t-on-click="refresh" t-att-disabled="state.loading">
                        <i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''}"/>
                        Refresh
                    </button>
                </div>
            </div>

            <!-- Section: Active Operations -->
            <div class="gd-section-label">Active Operations</div>
            <div class="gd-grid gd-grid-3">
                <KpiCard
                    label="'Pending Jobs'"
                    value="fmt(state.data.pending_job_count)"
                    icon="'fa-clock-o'"
                    color="'kpi-amber'"
                    loading="state.loading"
                    onClick.bind="openPendingJobs"
                />
                <KpiCard
                    label="'Closed Jobs'"
                    value="fmt(state.data.closed_job_count)"
                    sub="'Total: ' + fmtMoney(state.data.closed_amount_total)"
                    icon="'fa-check-circle'"
                    color="'kpi-green'"
                    loading="state.loading"
                    onClick.bind="openClosedJobs"
                />
                <KpiCard
                    label="'Invoice Pending'"
                    value="fmt(state.data.invoice_pending_count)"
                    sub="'Outstanding: ' + fmtMoney(state.data.invoice_pending_amount_total)"
                    icon="'fa-file-text-o'"
                    color="'kpi-red'"
                    loading="state.loading"
                    onClick.bind="openInvoicePending"
                />
            </div>

        </div>
    </t>

</templates>
