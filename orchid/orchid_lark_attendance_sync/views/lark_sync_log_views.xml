<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_lark_sync_log_view_list" model="ir.ui.view">
        <field name="name">od.lark.sync.log.view.list</field>
        <field name="model">od.lark.sync.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'" create="false" edit="false">
                <field name="date"/>
                <field name="state"/>
                <field name="employees_processed"/>
                <field name="attendances_created"/>
                <field name="attendances_updated"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="od_lark_sync_log_view_form" model="ir.ui.view">
        <field name="name">od.lark.sync.log.view.form</field>
        <field name="model">od.lark.sync.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="state"/>
                        <field name="employees_processed"/>
                        <field name="attendances_created"/>
                        <field name="attendances_updated"/>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="od_lark_sync_log_action" model="ir.actions.act_window">
        <field name="name">Lark Sync Logs</field>
        <field name="res_model">od.lark.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="od_menu_lark_sync_log"
              name="Lark Sync Logs"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="od_lark_sync_log_action"
              groups="hr.group_hr_manager"
              sequence="100"/>
</odoo>
