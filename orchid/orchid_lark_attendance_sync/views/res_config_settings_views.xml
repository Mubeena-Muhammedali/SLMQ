<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_res_config_settings_view_form_lark" model="ir.ui.view">
        <field name="name">od.res.config.settings.view.form.lark.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="after">
                <block title="Lark Attendance Sync" name="lark_attendance_sync">
                    <setting string="Lark Platform"
                             help="Choose Feishu (China) or Lark (International) depending on where your custom app was created.">
                        <field name="od_lark_domain" required="1" class="w-75"/>
                    </setting>
                    <setting string="App Credentials"
                             help="App ID / App Secret of the custom app created in the Lark or Feishu Developer Console, with Attendance read/write scopes granted and API Integration enabled in the Attendance Admin console.">
                        <div class="mt8">
                            <label for="od_lark_app_id" string="App ID"/>
                            <field name="od_lark_app_id"/>
                        </div>
                        <div class="mt8">
                            <label for="od_lark_app_secret" string="App Secret"/>
                            <field name="od_lark_app_secret" password="True"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
