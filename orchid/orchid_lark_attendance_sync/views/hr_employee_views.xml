<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_hr_employee_view_form_lark" model="ir.ui.view">
        <field name="name">od.hr.employee.view.form.lark.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="od_lark_user_id"/>
            </xpath>
        </field>
    </record>
</odoo>
