<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">od.res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group" position="before">
                <div class="alert alert-info" role="alert"
                        invisible="not od_registration_url">
                    <strong>Share this link with the vendor:</strong>
                    <field name="od_registration_url" widget="CopyClipboardChar" readonly="1"/>
                    <div class="text-muted">
                        The vendor can only edit their data.
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_od_vendor_document_view"
                        type="object" icon="fa-list-ol"
                        invisible="od_vendor_document_count == 0">
                    <field string="Documents" name="od_vendor_document_count"
                           widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="od_cr_number"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="od_category"/>
            </xpath>
            <xpath expr="//group/group/div" position="after">
                <field name="od_vendor_code" invisible="not od_vendor_code"/>
            </xpath>


        </field>
    </record>
</odoo>