<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od_vendor_document_type_list" model="ir.ui.view">
        <field name="name">od.vendor.document.type.list</field>
        <field name="model">od.vendor.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level" widget="badge"
                       decoration-danger="level == 'mandatory'"
                       decoration-warning="level == 'conditional'"
                       decoration-success="level == 'recommended'"/>
                <field name="has_expiry" widget="boolean_toggle"/>
                <field name="applies_to"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_od_vendor_document_type_form" model="ir.ui.view">
        <field name="name">od.vendor.document.type.form</field>
        <field name="model">od.vendor.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="level"/>
                        <field name="applies_to"/>
                        <field name="has_expiry"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_od_vendor_document_type_search" model="ir.ui.view">
        <field name="name">od.vendor.document.type.search</field>
        <field name="model">od.vendor.document.type</field>
        <field name="arch" type="xml">
            <search string="Document Types">
                <field name="name"/>
                <filter string="Mandatory" name="filter_mandatory" domain="[('level','=','mandatory')]"/>
                <filter string="Expiry Tracked" name="filter_expiry" domain="[('has_expiry','=',True)]"/>
                <group>
                    <filter string="Level" name="groupby_level" context="{'group_by': 'level'}"/>
                    <filter string="Applies To" name="groupby_applies_to" context="{'group_by': 'applies_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_od_vendor_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">od.vendor.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Configure the Required Documents Checklist
            </p>
            <p>
                Each vendor registration automatically picks up the document
                types that apply to it: "All Vendors" documents always apply,
                the others apply once the matching Category is selected.
            </p>
        </field>
    </record>

    <menuitem id="menu_od_vendor_document_type"
              name="Document Types"
              parent="purchase.menu_purchase_config"
              action="action_od_vendor_document_type"
              sequence="2"/>

</odoo>
