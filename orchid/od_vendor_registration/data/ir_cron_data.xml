<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled action to sent mail about the document expiry.-->
        <record id="od_ir_cron_scheduler_vendor_document_reminder" model="ir.cron">
            <field name="name">Orchid Vendor Document Expiration</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_od_vendor_document"/>
            <field name="state">code</field>
            <field name="code">model.od_mail_reminder()</field>
        </record>
    </data>
</odoo>
