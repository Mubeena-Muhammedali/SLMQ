<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od_vendor_registration_link_wizard_form" model="ir.ui.view">
        <field name="name">od.vendor.registration.link.wizard.form</field>
        <field name="model">od.vendor.registration.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor Self-Registration Link">
                <div class="alert alert-info" role="alert">
                    Share this link so vendors can register themselves from
                    scratch. Anyone with the link can create a new
                    registration.
                </div>
                <group>
                    <field name="link" widget="CopyClipboardChar" readonly="1"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
