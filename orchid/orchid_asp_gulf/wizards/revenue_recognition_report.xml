<?xml version="1.0"?>
<odoo>
    <record id="od_revenue_recognition_report_wiz_view_form" model="ir.ui.view">
        <field name="name">od.revenue.recognition.report.wiz.form</field>
        <field name="model">od.revenue.recognition.report.wiz</field>
        <field name="arch" type="xml">
            <form string="Revenue Recognition Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="excel_file" filename="file_name"/>
                        <field name ="file_name" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="od_revenue_recognition_report_wiz_action" model="ir.actions.act_window">
        <field name="name">Revenue Recognition Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">od.revenue.recognition.report.wiz</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="od_revenue_recognition_report_wiz_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>