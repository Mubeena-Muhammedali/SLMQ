<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_asp_inherit" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="account.product_template_form_view"/>
            <field name="arch" type="xml">
                <field name="property_account_expense_id" position="before">
                    <field name="od_property_account_subscription_id" groups="account.group_account_readonly"/>
                </field>
                <field name="property_account_income_id" position="before">
                    <field name="od_property_account_revenue_id" groups="account.group_account_readonly"/>
                </field>
            </field>
        </record>
        <record id="product_product_template_form_view_asp_inherit" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <group name="group_standard_price" position="inside">
                    <field name="od_avg_cost"/>
                    <field name="od_revenue_type"/>
                    <field name="od_company_currency_id" invisible="1"/>
                </group>
            </field>
        </record>
        <record id="product_template_only_form_view_asp_inherit" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <field name="default_code" position="after">
                    <field name="od_supplier_ref"/>
                    <field name="od_revenue_type"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
