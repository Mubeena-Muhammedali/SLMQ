<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_product_correction_tree_view">
            <field name="name">od.product.correction.tree</field>
            <field name="model">od.product.correction</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Product Correction Utility" default_order="id desc">
                    <field name="name"/>
                    <field name="record_type"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="od_product_correction_form_view">
            <field name="name">od.product.correction.form</field>
            <field name="model">od.product.correction</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Product Correction Utility">
                    <header>
                        <button name="button_confirm" string="Confirm" invisible='state != "draft"' class="oe_highlight" type="object" confirm="Are you sure that you want to confirm the record?"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="record_type"
                                    readonly="state != 'draft'"
                                    required="1"/>

                                <field name="sale_id"
                                    readonly="state != 'draft'"
                                    required="record_type == 'sale'"
                                    invisible="record_type != 'sale'"
                                    options="{'no_quick_create':True,'no_create_edit':True}"/>

                                <field name="contract_id"
                                    readonly="state != 'draft'"
                                    required="record_type in ('contract', 'contract_name')"
                                    invisible="record_type not in ('contract', 'contract_name')"
                                    options="{'no_quick_create':True,'no_create_edit':True}"/>

                                <field name="old_contract_name"
                                    readonly="1"
                                    force_save="1"
                                    invisible="record_type != 'contract_name'"/>

                                <field name="new_contract_name"
                                    readonly="state != 'draft'"
                                    required="record_type == 'contract_name'"
                                    invisible="record_type != 'contract_name'"/>

                                <field name="company_id" invisible="1"/>
                                <field name="name" invisible="1"/>
                                <field name="description"/>

                            </group>
                        </group>
                        <field name="remarks" placeholder="Remarks...."/>
                        <notebook>
                            <page string="Prouct Lines"
                                name="product_line_ds"
                                invisible="record_type != 'sale'">

                                <field name="product_line_ds"
                                    mode="list"
                                    readonly="state != 'draft'">

                                    <list editable="top">

                                        <field name="sale_line_id"
                                            domain="[('order_id','=',parent.sale_id),('display_type','=',False)]"
                                            options="{'no_quick_create':True,'no_create_edit':True}"
                                            column_invisible="parent.state != 'draft'"/>

                                        <field name="sale_line_display_name"
                                            readonly="1"
                                            force_save="1"
                                            column_invisible="parent.state != 'confirm'"/>

                                        <field name="method" required="1"/>

                                        <field name="old_product_id"
                                            readonly="1"
                                            force_save="1"/>

                                        <field name="new_product_id"
                                            options="{'no_quick_create':True,'no_create_edit':True}"
                                            readonly="method != 'Update'"
                                            required="method == 'Update'"
                                            force_save="1"/>

                                        <field name="old_description"
                                            readonly="1"
                                            force_save="1"/>

                                        <field name="new_description"
                                            readonly="method != 'Update'"
                                            required="method == 'Update'"
                                            force_save="1"/>

                                        <field name="price_adjustment_line"
                                            options="{'no_quick_create':True,'no_create_edit':True}"
                                            readonly="method != 'Deletion'"
                                            required="method == 'Deletion'"
                                            force_save="1"
                                            domain="[('id','!=',sale_line_id),('order_id','=',parent.sale_id),('display_type','=',False)]"/>

                                        <field name="price_subtotal"
                                            readonly="1"
                                            force_save="1"/>

                                        <field name="company_id" invisible="1"/>
                                        <field name="utility_id" invisible="1"/>

                                    </list>
                                </field>
                            </page>
                           <page string="Contract Lines"
                                name="contract_lines"
                                invisible="record_type != 'contract'">

                                <field name="contract_line_ids"
                                    mode="list"
                                    readonly="state != 'draft'">

                                    <list editable="top">

                                        <field name="contract_line_id"
                                            domain="[('order_id','=',parent.contract_id)]"
                                            options="{'no_quick_create':True,'no_create_edit':True}"
                                            column_invisible="parent.state != 'draft'"/>

                                        <field name="contract_line_display_name"
                                            readonly="1"
                                            force_save="1"
                                            column_invisible="parent.state != 'confirm'"/>

                                        <field name="method"
                                            required="1"/>

                                        <field name="old_product_id"
                                            readonly="1"
                                            force_save="1"/>

                                        <field name="new_product_id"
                                            options="{'no_quick_create':True,'no_create_edit':True}"
                                            readonly="method != 'Update'"
                                            required="method == 'Update'"
                                            force_save="1"/>

                                        <field name="old_description"
                                            readonly="1"
                                            force_save="1"/>

                                        <field name="new_description"
                                            readonly="method != 'Update'"
                                            required="method == 'Update'"
                                            force_save="1"/>

                                        <field name="price_adjustment_line"
                                            options="{'no_quick_create':True,'no_create_edit':True}"
                                            readonly="method != 'Deletion'"
                                            required="method == 'Deletion'"
                                            force_save="1"
                                            domain="[('id','!=',contract_line_id),('order_id','=',parent.contract_id)]"/>

                                        <field name="company_id" invisible="1"/>
                                        <field name="utility_id" invisible="1"/>

                                        <field name="price_subtotal"
                                            readonly="1"
                                            force_save="1"
                                            optional="hide"/>

                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="od_product_correction_filter_view">
            <field name="name">od.product.correction.filter</field>
            <field name="model">od.product.correction</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="name"/>
                    <group>
                        <filter name="saleOrder" string="Sale Order" context="{'group_by': 'name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_od_product_correction_view">
            <field name="name">Product Correction Utility</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.product.correction</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="od_product_correction_filter_view"/>
        </record>
    </data>
</odoo>

