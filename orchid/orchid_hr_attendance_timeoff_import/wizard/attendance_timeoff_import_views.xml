<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od_hr_attendance_timeoff_import_wizard_form" model="ir.ui.view">
        <field name="name">od.hr.attendance.timeoff.import.wizard.form</field>
        <field name="model">od.hr.attendance.timeoff.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Attendance / Time Off">
                <group>
                    <div colspan="2" class="text-muted mb-2">
                        1. Download the template below.<br/>
                        2. Fill in one row per employee per day, starting row 2: Employee Name,
                        Date, Hours worked, Time Off Type and/or Time off (hours - e.g. 8 = a
                        full day off). Any number of employees and dates can go in the same
                        file.<br/>
                        3. If both Hours and Time Off are filled for a day, they're reconciled
                        against the employee's standard daily hours (e.g. 5 hours worked + a
                        Sick-off out of an 8-hour day becomes 5 hours Attendance and 3 hours
                        Time Off). If only Time Off Type is filled, any remaining hours up to
                        the standard day are logged as Attendance automatically.<br/>
                        4. Upload the completed file and click "Upload &amp; Process".<br/>
                        <b>Date format:</b> use DD/MM/YYYY (e.g. 23/07/2026). YYYY-MM-DD and
                        MM/DD/YYYY are also accepted, as are real Excel date cells.
                    </div>
                    <button name="action_download_template" type="object"
                            string="Download Template" class="btn-secondary"
                            icon="fa-download"/>
                </group>
                <group>
                    <field name="import_filename" invisible="1"/>
                    <field name="import_file" filename="import_filename" string="Timesheet File"/>
                </group>
                <group invisible="not error_log">
                    <field name="error_log" readonly="1" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Upload &amp; Process"
                            class="btn-primary" icon="fa-upload"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_od_hr_attendance_timeoff_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Attendance / Time Off</field>
        <field name="res_model">od.hr.attendance.timeoff.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="menu_od_hr_attendance_timeoff_import"
              name="Import Attendance / Time Off"
              parent="hr_attendance.menu_hr_attendance_overview"
              action="action_od_hr_attendance_timeoff_import_wizard"
              sequence="10"/>

</odoo>
