<odoo>
    <template id="report_invoice_document_garage_details" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="after">
            <t t-if="o.move_type == 'out_invoice'">
                <t t-set="garage_fields" t-value="o._get_garage_invoice_details()"/>
    
                <t t-foreach="range(0, len(garage_fields), 7)" t-as="i">
                    <div class="row mb-4">
                        <t t-foreach="garage_fields[i:i+7]" t-as="field">
                            <div class="col">
                                <strong t-out="field[0]"/>
                                <div t-out="field[1]"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </xpath>

        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' page ')]" position="inside">
            <t t-if="o.move_type == 'out_invoice'">
                <div class="mt-4 pt-2" style="page-break-inside:avoid;">
                    <p class="mb-1">
                        <strong>Terms and Condition:</strong>
                    </p>
                    <p class="mb-3">
                        I hereby certify that I am fully satisfied with the works carried out by MAS Garage and indemnify the garage of any potential losses, damages or liabilities that may occur after taking delivery of vehicle.
                    </p>
                    <p class="mb-4" style="font-size:11px;">
                        <strong>The repaired vehicle is checked and received in good condition.</strong>
                    </p>
                    <div class="row mt-5" style="font-size:11px;">
                        <div class="col-6 text-center">
                            <div style="border-top:1px solid #000; width:80%; margin:0 auto; padding-top:5px;">
                                Customer's Signature
                            </div>
                        </div>
                        <div class="col-6 text-center">
                            <div style="border-top:1px solid #000; width:80%; margin:0 auto; padding-top:5px;">
                                Authorized Signature
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='informations']/div[@name='due_date']" position="replace">
            <t t-if="o.move_type == 'out_invoice'">
                <t t-set="sale_order" t-value="o.invoice_line_ids.mapped('sale_line_ids.order_id')[:1]"/>
    
                <div class="col" t-if="sale_order" name="due_date">
                    <strong>In Date</strong>
                    <div t-field="sale_order.date_order" t-options="{&quot;format&quot;: &quot;MM/dd/yyyy&quot;}"/>
                </div>
            </t>
            <t t-else="">
                <div class="col" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                    <strong>Due Date</strong>
                    <div t-field="o.invoice_date_due">2023-10-31</div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='informations']/div[@name='origin']/strong" position="replace">
            <strong>Job Card</strong>
        </xpath>

        <xpath expr="//div[@id='informations']/div[@name='reference']" position="replace">
            <t t-if="o.move_type == 'out_invoice'">
                <div class="col" t-if="o.invoice_user_id" name="reference">
                    <strong>Salesperson</strong>
                    <div t-field="o.invoice_user_id.name"/>
                </div>
            </t>
            <t t-else="">
                <div class="col" t-if="o.ref" name="reference">
                    <strong>Reference</strong>
                    <div t-field="o.ref">INV/2023/00001</div>
                </div>
            </t>
        </xpath>

         <xpath expr="//t[@name='no_shipping']/div[@id='partner_vat_no_shipping']" position="after">
            <div t-if="o.partner_id.phone">
                <i class="fa fa-phone"/> 
                <span t-field="o.partner_id.phone"/>
            </div>
        </xpath>

        <xpath expr="//t[@name='address_same_as_shipping']/div[@id='partner_vat_address_same_as_shipping']" position="after">
            <div t-if="o.partner_id.phone">
                <i class="fa fa-phone"/> 
                <span t-field="o.partner_id.phone"/>
            </div>
        </xpath>

        <xpath expr="//t[@name='address_not_same_as_shipping']/div[@id='partner_vat_address_not_same_as_shipping']" position="after">
            <div t-if="o.partner_id.phone">
                <i class="fa fa-phone"/> 
                <span t-field="o.partner_id.phone"/>
            </div>
        </xpath>
        
    </template>
</odoo>
