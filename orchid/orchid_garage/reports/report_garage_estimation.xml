<odoo>

    <template id="report_garage_estimation_document">
        <t t-call="web.external_layout">
            <div class="page">
                <!-- HEADING -->
                <div class="text-center mb-4">
                    <h2>
                        <strong>Estimation -<span t-field="o.name"/></strong>
                    </h2>
                </div>
                <!-- TOP INFO TABLE -->
                <!-- CUSTOMER + VEHICLE INFO -->

                <table class="table table-borderless" style="width:100%;">
                    <tr>
                        <td><strong>Name</strong></td>
                        <td>:<span t-field="o.partner_id"/></td>
                        <td><strong>Date</strong></td>
                        <td>:<span t-field="o.date"/></td>
                    </tr>

                    <tr>
                        <td><strong>Address</strong></td>
                        <td>:<span t-field="o.partner_id.contact_address"/></td>
                        <td><strong>Brand</strong></td>
                        <td>:<span t-field="o.brand_id"/></td>
                    </tr>

                    <tr>
                        <td><strong>Email</strong></td>
                        <td>:<span t-field="o.partner_id.email"/></td>
                        <td><strong>Model</strong></td>
                        <td>:<span t-field="o.model_id"/></td>
                    </tr>

                    <tr>
                        <td><strong>Contact No</strong></td>
                        <td>:<span t-field="o.partner_id.phone"/></td>
                        <td><strong>VIN No</strong></td>
                        <td>:<span t-field="o.vin_no"/></td>
                    </tr>

                    <tr>
                        <td><strong>TRN</strong></td>
                        <td>:<span t-field="o.partner_id.vat"/></td>
                        <td><strong>Plate No</strong></td>
                        <td>:<span t-field="o.vehicle_id"/></td>
                    </tr>

                    <tr>
                        <td><strong>User</strong></td>
                        <td>:<span t-field="o.user_id"/></td>
                        <td><strong>Color</strong></td>
                        <td>:<span t-field="o.colour"/></td>
                    </tr>

                    <tr>
                        <td></td>
                        <td></td>
                        <td><strong>Km</strong></td>
                        <td>:<span t-field="o.kms"/>
                            <span style="margin-left:25px;">
                                <strong>Year</strong>
                            </span>:<span t-field="o.year"/>
                        </td>
                    </tr>
                </table>

                <!-- ESTIMATION LINES -->

                <table class="table table-sm" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:5%;">Sl No</th>
                            <th style="width:35%;">Description</th>
                            <th style="width:20%;">Remarks</th>
                            <th style="width:10%;" class="text-end">Unit Price</th>
                            <th style="width:10%;" class="text-center">Qty</th>
                            <th style="width:20%;" class="text-end">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="sl_no" t-value="1"/>
                        <t t-set="section_total" t-value="0"/>
                        <t t-foreach="o.line_ids.filtered(lambda x:x.product_id.id!=x.company_id.sale_discount_product_id.id)" t-as="line">
                            <!-- SECTION -->
                            <t t-if="line.display_type == 'line_section'">
                                <!-- PREVIOUS SECTION TOTAL -->
                                <t t-if="section_total">
                                    <tr>
                                        <td colspan="5" class="text-end"><strong>Section Total</strong></td>
                                        <td class="text-end"><strong><span t-esc="section_total"/></strong></td>
                                    </tr>
                                </t>

                                <!-- RESET -->
                                <t t-set="section_total" t-value="0"/>
                                <!-- SECTION ROW -->
                                <tr style="background-color:#e9ecef;">
                                    <td colspan="6">
                                        <strong><span t-field="line.name"/></strong>
                                    </td>
                                </tr>
                            </t>

                            <!-- NOTE -->

                            <t t-elif="line.display_type == 'line_note'">
                                <tr>
                                    <td colspan="6">
                                        <em><span t-field="line.name"/></em>
                                    </td>
                                </tr>
                            </t>

                            <!-- NORMAL LINE -->

                            <t t-else="">
                                <tr>
                                    <td>
                                        <span t-esc="sl_no"/>
                                    </td>

                                    <td>
                                        <span t-field="line.name"/>
                                    </td>

                                    <td>
                                        <span t-field="line.remarks"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.unit_price"/>
                                    </td>

                                    <td class="text-center">
                                        <span t-field="line.qty"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.price_total"/>
                                    </td>

                                </tr>

                                <!-- COUNTERS -->
                                <t t-set="sl_no" t-value="sl_no + 1"/>
                                <t t-set="section_total" t-value="section_total + line.price_total"/>
                            </t>
                        </t>
                        <!-- LAST SECTION TOTAL -->

                        <tr>
                            <td colspan="5" class="text-end"><strong>Section Total</strong></td>
                            <td class="text-end"><strong><span t-esc="section_total"/></strong></td>
                        </tr>
                    </tbody>
                </table>


                <!-- REMARKS + TOTALS -->
                <div class="row">
                    <div class="col-4">
                        <strong>Remarks :</strong>
                        <br/>
                        <span t-field="o.remarks"/>
                    </div>
                    <div class="col-8">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td>
                                    <strong>Amount</strong>
                                </td>
                                <td class="text-end">
                                    <span t-field="o.amount_before_discount"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Discount</strong>
                                </td>
                                <td class="text-end">
                                    <span t-field="o.discount_amount"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Gross Amount</strong>
                                </td>
                                <td class="text-end">
                                    <span t-field="o.amount_untaxed"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>VAT</strong>
                                </td>
                                <td class="text-end">
                                    <span t-field="o.amount_tax"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Total Amount</strong>
                                </td>
                                <td class="text-end">
                                    <strong><span t-field="o.amount_total"/></strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                        


                <!-- AMOUNT IN WORDS -->

                <div class="mt-3">
                    <strong>Amount in Words :</strong>
                    <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                </div>


                <!-- NOTES -->
                <div class="mt-4"><span t-field="o.note"/></div>

                <!-- SIGNATURE -->
                <div class="mt-5" style="width:250px; float:right; text-align:center;">Customer's Signature</div>
            </div>
        </t>
    </template>

    <template id="report_garage_estimation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="orchid_garage.report_garage_estimation_document"/>
            </t>
        </t>
    </template>
</odoo>
