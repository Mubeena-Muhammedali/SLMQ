<odoo>

    <record id="view_garage_discount_wizard_form" model="ir.ui.view">
        <field name="name">garage.discount.wizard.form</field>
        <field name="model">garage.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Discount">
                <group>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>
            </form>
        </field>
    </record>
</odoo>