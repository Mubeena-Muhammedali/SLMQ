<odoo>

    <!-- =========================================================
        VEHICLE
    ========================================================== -->

    <record id="view_garage_vehicle_tree" model="ir.ui.view">
        <field name="name">garage.vehicle.tree</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="plate_no"/>
                <field name="partner_id"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="vin_no"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_garage_vehicle_form" model="ir.ui.view">
        <field name="name">garage.vehicle.form</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="plate_no"/>
                            <field name="partner_id"/>
                            <field name="brand_id"/>
                            <field name="model_id" context="{'default_brand_id':brand_id}"/>
                        </group>
                        <group>
                            <field name="vin_no"/>
                            <field name="colour"/>
                            <field name="year"/>
                            <field name="kms"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garage_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">garage.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- vehicle brand TREE VIEW -->

