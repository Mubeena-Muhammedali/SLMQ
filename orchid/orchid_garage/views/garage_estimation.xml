<odoo>

  <!-- SEARCH VIEW -->

  <record id="view_garage_estimation_search" model="ir.ui.view">
    <field name="name">garage.estimation.search</field>
    <field name="model">garage.estimation</field>
    <field name="arch" type="xml">
      <search string="Search Estimations">
        <field name="vehicle_id"
               string="Vehicle"
               filter_domain="['|', ('vin_no', 'ilike', self), ('vehicle_id', 'ilike', self)]"/>
        <field name="partner_id"/>
        <field name="model_id"/>
        <field name="user_id"/>
        <field name="salesperson_id"/>
        <field name="date"/>
        <field name="state"/>

        <filter string="Draft" name="estimation_draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Confirmed" name="estimation_confirmed" domain="[('state', '=', 'confirmed')]"/>
        <filter string="Completed" name="estimation_completed" domain="[('state', '=', 'completed')]"/>

        <group>
          <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
          <filter string="Vehicle Model" name="group_by_model" context="{'group_by': 'model_id'}"/>
          <filter string="Service Advisor" name="group_by_user" context="{'group_by': 'user_id'}"/>
          <filter string="Salesperson" name="group_by_salesperson" context="{'group_by': 'salesperson_id'}"/>
          <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
          <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- TREE VIEW -->

  <record id="view_garage_estimation_tree" model="ir.ui.view">
    <field name="name">garage.estimation.tree</field>
    <field name="model">garage.estimation</field>
    <field name="arch" type="xml">
      <list>
          <field name="name"/>
          <field name="partner_id"/>
          <field name="vehicle_id"/>
          <field name="brand_id"/>
          <field name="model_id"/>
          <field name="user_id"/>
          <field name="salesperson_id"/>
          <field name="state"/>
      </list>
    </field>
  </record>

  <!-- FORM VIEW -->

  <record id="view_garage_estimation_form" model="ir.ui.view">
    <field name="name">garage.estimation.form</field>
    <field name="model">garage.estimation</field>
    <field name="arch" type="xml">

      <form string="Garage Estimation">
        <!-- HEADER -->
        <header>

          <button name="action_confirm"
            string="Confirm"
            type="object"
            class="btn-primary"
            invisible="state != 'draft'"/>

          <button name="action_complete"
            string="Create Sale Order"
            type="object"
            class="btn-success"
            invisible="state != 'confirmed'"/>

          <button name="action_reset_to_draft"
            string="Reset to Draft"
            type="object"
            invisible="state != 'confirmed'"/>

          <field name="state"
           widget="statusbar"
           statusbar_visible="draft,confirmed,completed"/>

        </header>

          <!-- SHEET -->

        <sheet>

          <div class="oe_button_box" name="button_box">
            <button name="action_view_sale_order"
              type="object"
              class="oe_stat_button"
              icon="fa-file-text-o" string="Sale Order"
              invisible="not sale_order_id"/>
          </div>

          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>

            <!-- TOP -->

          <group>
            <group>
              <field name="partner_id" readonly="state != 'draft'" options="{'no_quick_create': True}"/>
              <field name="date" readonly="state != 'draft'"/>
              <field name="user_id" readonly="state != 'draft'"/>
              <field name="salesperson_id" readonly="state != 'draft'" options="{'no_create': True}"/>
              <field name="currency_id" required="1"/>
              <field name="remarks"/>
            </group>

            <group>
              <field name="vehicle_id" readonly="state != 'draft'" context="{'default_partner_id':partner_id}"/>
              <field name="brand_id" readonly="state != 'draft'"/>
              <field name="model_id" readonly="state != 'draft'" context="{'default_brand_id':brand_id}"/>
              <field name="vin_no" readonly="state != 'draft'"/>
              <field name="colour" readonly="state != 'draft'"/>
              <field name="kms" readonly="state != 'draft'"/>
              <field name="year" readonly="state != 'draft'"/>
              <field name="company_id" invisible="1"/>
            </group>
          </group>

            <!-- LINES -->

          <notebook>
            <page string="Estimation Lines">
              <field name="line_ids" widget="section_and_note_one2many" readonly="state != 'draft'">
                <list editable="bottom">
                  <control>
                    <create name="add_line_control" string="Add a line"/>
                    <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                    <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                  </control>
                  <field name="display_type" column_invisible="True"/>
                  <field name="company_id" column_invisible="1"/>
                  <field name="sequence" widget="handle"/>
                  <field name="product_id" required="not display_type"/>
                  <field name="name" widget="section_and_note_text"/>
                  <field name="remarks"/>
                  <field name="qty"/>
                  <field name="unit_price"/>
                  <field name="tax_ids" widget="many2many_tags" invisible="display_type"/>
                  <field name="price_subtotal" readonly="1" invisible="display_type"/>
                  <field name="price_total" readonly="1" invisible="display_type"/>
                </list>
              </field>
              <div class="float-end d-flex gap-1 mb-2" name="so_button_below_order_lines">
                <button string="Discount" name="action_open_discount_wizard" type="object" class="btn btn-secondary" groups="sale.group_discount_per_so_line" invisible="state != 'draft'"/>
              </div>
              <group name="note_group" col="6" class="mt-2 mt-md-0">
                <group colspan="4" class="order-1 order-lg-0">
                  <field colspan="2" name="note" nolabel="1" placeholder="Terms and conditions..."/>
                </group>
                <group class="oe_subtotal_footer oe_right">
                  <field name="amount_before_discount" readonly="1"/>
                  <field name="discount_amount" readonly="1"/>
                  <field name="amount_untaxed" readonly="1"/>
                  <field name="amount_tax" readonly="1"/>
                  <field name="amount_total" readonly="1" class="oe_subtotal_footer_separator"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <!-- CHATTER -->
        <chatter/>
      </form>
    </field>
  </record>

  <!-- ACTION -->

  <record id="action_garage_estimation" model="ir.actions.act_window">
    <field name="name">Estimations</field>
    <field name="res_model">garage.estimation</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_garage_estimation_search"/>
  </record>

</odoo>
