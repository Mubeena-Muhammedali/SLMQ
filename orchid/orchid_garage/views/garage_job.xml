<odoo>
    <record id="view_garage_job_search" model="ir.ui.view">
        <field name="name">garage.job.search</field>
        <field name="model">garage.job</field>
        <field name="arch" type="xml">
            <search string="Search Jobs">
                <field name="vehicle_id"
                       string="Vehicle"
                       filter_domain="['|', ('vehicle_id.vin_no', 'ilike', self), ('vehicle_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="vehicle_model_id"/>
                <field name="salesperson_id"/>
                <field name="date"/>
                <field name="state"/>

                <filter string="Draft" name="job_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="job_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="job_completed" domain="[('state', '=', 'completed')]"/>

                <group>
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Vehicle Model" name="group_by_vehicle_model" context="{'group_by': 'vehicle_model_id'}"/>
                    <filter string="Salesperson" name="group_by_salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garage_job_tree" model="ir.ui.view">
        <field name="name">garage.job.tree</field>
        <field name="model">garage.job</field>
        <field name="arch" type="xml">
            <list string="Jobs">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="state"/>
                <field name="priority" widget="priority"/>
                <field name="due_date_out"/>
            </list>
        </field>
    </record>

    <record id="view_garage_job_form" model="ir.ui.view">
        <field name="name">garage.job.form</field>
        <field name="model">garage.job</field>
        <field name="arch" type="xml">
            <form string="Job Card">
                <header>
                    <button name="action_start"
                            string="Start"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_progress,completed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">

                            <field name="purchase_order_count"
                                   widget="statinfo"
                                   string="Purchases"/>

                        </button>
                        <button name="action_view_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <field name="sale_order_id"
                                   widget="statinfo"
                                   string="Quotation"/>
                        </button>
                    </div>
                    
                    <!-- SMART HEADER BOX -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="sale_order_id" invisible="1"/>
                            <field name="priority" widget="priority"/>
                            <field name="due_date_out"/>
                        </group>

                        <group>
                            <field name="colour"/>
                            <field name="charger_type_id"/>
                            <field name="sub_status_id"/>
                            <field name="promo_no"/>
                            <field name="check_list_remarks"/>
                        </group>
                    </group>
                    <!-- NOTEBOOK -->
                    <notebook>
                        <page string="Job Details">
                            <field name="line_ids" widget="section_and_note_one2many" readonly="state == 'completed'">
                                <list editable="bottom">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence"
                                           widget="handle"/>

                                    <field name="display_type"
                                           column_invisible="1"/>

                                    <field name="product_id"
                                           required="not display_type"/>

                                    <field name="name" widget="section_and_note_text"/>
                                    <field name="remarks"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags" invisible="display_type"/>
                                    <field name="price_subtotal" readonly="1" invisible="display_type"/>
                                    <field name="price_total" readonly="1" invisible="display_type"/>

                                    <field name="company_id"
                                           optional="hide"/>

                                </list>

                            </field>

                        </page>
                        <!-- ESTIMATION TAB -->
                        <page string="Estimation">
                            <group>
                                <group>
                                    <field name="estimation_no" readonly="1"/>
                                    <field name="customer_contact_no"/>
                                    <field name="brand_id"/>
                                    <field name="vehicle_id"/>
                                    <field name="vehicle_engine_id"/>
                                    <field name="cylinder_id"/>
                                </group>

                                <group>
                                    <field name="job_category_id"/>
                                    <field name="order_type_id"/>
                                    <field name="status_id"/>
                                    <field name="coupen_no"/>
                                    <field name="next_service_reminder_date"/>
                                </group>
                            </group>
                            <group>
                                <field name="remarks"/>
                            </group>
                        </page>

                        <!-- INSPECTION TAB -->
                        <page string="Inspection">
                            <group>
                                <group>
                                    <field name="customer_approval"/>
                                    <field name="vehicle_vin_no"/>
                                    <field name="vehicle_model_id"/>
                                    <field name="vehicle_year"/>
                                    <field name="kms"/>
                                </group>
                                <group>
                                    <field name="lpo_no"/>
                                    <field name="re_do_job"/>
                                    <field name="driver_name_id"/>
                                    <field name="salesperson_id"/>
                                    <field name="lead_source_id"/>
                                </group>
                            </group>
                            <group>
                                <field name="inspection_detail"/>
                            </group>

                            <group>
                                <field name="tyre_check"/>
                            </group>

                            <group>
                                <field name="attachment_ids"
                                       widget="many2many_binary"/>
                            </group>
                        </page>

                        <page string="Delivery &amp; Technical Details">
                            <group>
                                <group>
                                    <field name="advisor_id"/>
                                    <field name="supervisor_id"/>
                                    <field name="technician_id"/>
                                    <field name="estimated_job_completion_time"/>
                                    <field name="job_completion_time"
                                           readonly="1"/>
                                </group>

                                <group>
                                    <field name="brought_name_id"/>
                                    <field name="mulkiya_name_id"/>
                                    <field name="delivery_date"/>
                                    <field name="received_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_garage_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">garage.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_garage_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Job Card
            </p>
        </field>
    </record>


</odoo>
