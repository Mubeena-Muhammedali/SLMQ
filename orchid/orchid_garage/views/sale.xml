<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="od_action_close_job"
                        type="object"
                        string="Close"
                        class="btn-secondary"
                        invisible="od_job_status != 'in_progress'"/>
                <button name="od_action_create_purchase_order"
                        type="object"
                        string="Create Purchase Order"
                        class="btn-secondary"
                        invisible="od_job_status != 'in_progress'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="od_action_view_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not od_purchase_order_count or od_job_status != 'in_progress'">
                    <field name="od_purchase_order_count" widget="statinfo" string="Purchases"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od_estimation_id" readonly="1"/>
                <field name="od_analytic_account_id" invisible="1"/>
                <field name="od_job_status" readonly="1"/>
            </xpath>
            <xpath expr="//button[@name='action_view_invoice']" position="before">

                <button name="action_view_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="od_payment_count == 0">

                    <field name="od_payment_count"
                        widget="statinfo"
                        string="Payments"/>

                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Garage Details">
                    <group>
                        <group>
                            <field name="od_date"/>
                            <field name="od_vehicle_id"/>
                            <field name="od_brand_id"/>
                            <field name="od_model_id"/>
                            <field name="od_vin_no"/>
                            <field name="od_colour"/>
                            <field name="od_kms"/>
                            <field name="od_year"/>
                        </group>
                        <group>
                            <field name="od_customer_contact_no"/>
                            <field name="od_charger_type_id"/>
                            <field name="od_check_list_remarks"/>
                            <field name="od_due_date_out"/>
                            <field name="od_promo_no"/>
                            <field name="od_sub_status_id"/>
                            <field name="od_priority"/>
                            <field name="od_vehicle_engine_id"/>
                            <field name="od_cylinder_id"/>
                            <field name="od_job_category_id"/>
                            <field name="od_next_service_reminder_date"/>
                            <field name="od_coupen_no"/>
                            <field name="od_order_type_id"/>
                            <field name="od_status_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="od_remarks"/>
                    </group>
                </page>
                <page string="Inspection">
                    <group>
                        <group>
                            <field name="od_customer_approval"/>
                            <field name="od_vehicle_vin_no"/>
                            <field name="od_vehicle_model_id"/>
                            <field name="od_vehicle_year"/>
                            <field name="od_lpo_no"/>
                        </group>
                        <group>
                            <field name="od_re_do_job"/>
                            <field name="od_driver_name_id"/>
                            <field name="od_salesperson_id"/>
                            <field name="od_lead_source_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="od_inspection_detail"/>
                        <field name="od_tyre_check"/>
                    </group>
                </page>
                <page string="Delivery &amp; Technical Details">
                    <group>
                        <group>
                            <field name="od_advisor_id"/>
                            <field name="od_supervisor_id"/>
                            <field name="od_technician_id"/>
                            <field name="od_estimated_job_completion_time"/>
                            <field name="od_job_completion_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="od_brought_name_id"/>
                            <field name="od_mulkiya_name_id"/>
                            <field name="od_delivery_date"/>
                            <field name="od_received_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="od_sale_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.garage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od_vehicle_id" optional="hide"/>
                <field name="od_estimation_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="od_job_status" widget="badge" decoration-info="od_job_status in ('draft','in_progress')"/>
            </xpath>
        </field>
    </record>

    <record id="od_quotation_tree_inherit" model="ir.ui.view">
        <field name="name">quotation.tree.garage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od_vehicle_id" optional="hide"/>
                <field name="od_estimation_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="od_job_status" widget="badge" decoration-info="od_job_status in ('draft','in_progress')"/>
            </xpath>
        </field>
    </record>

    <record id="od_sale_order_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.garage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od_vehicle_id"
               filter_domain="['|', ('od_vin_no', 'ilike', self), ('od_vehicle_id', 'ilike', self)]"/>
                <field name="od_estimation_id"/>
                <field name="od_job_status"/>
            </xpath>
            <xpath expr="//filter[@name='activities_overdue']" position="before">
                <separator/>
                <filter string="Pending Jobs" name="pending_jobs" domain="[('od_job_status', 'in', ('draft', 'in_progress'))]"/>
                <filter string="Closed Jobs" name="closed_jobs" domain="[('od_job_status', '=', 'closed')]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='customer']" position="after">
                <filter name="customer" string="Job Status" context="{'group_by': 'od_job_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>
