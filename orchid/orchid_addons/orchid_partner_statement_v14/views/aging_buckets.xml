<odoo>
    <template id="aging_buckets">
        <p>
            <b>Aging Report at <span t-esc="d['end']"/> in <span t-esc="display_currency.name"/>:</b>
        </p>
        <table class="table table-sm table-statement">
            <thead style="border-bottom:1px solid white;">
                <tr style="border-bottom:1px solid black;">
                    <t t-foreach="bucket_labels" t-as="bl">
                        <th class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                            <span t-esc="bl"/>
                        </th>
                    </t>
                </tr>
            </thead>
            <t t-set="buckets" t-value="currency['buckets']"/>
            <tbody>
                <tr>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('current', 0.0)"/>
                    </td>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('b_1_30', 0.0)"/>
                    </td>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('b_30_60', 0.0)"/>
                    </td>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('b_60_90', 0.0)"/>
                    </td>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('b_90_120', 0.0)"/>
                    </td>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('b_over_120', 0.0)"/>
                    </td>
                    <td class="amount" style="font-size:13px;border-right:1px solid white;border-left:1px solid white;">
                        <span t-esc="buckets.get('balance', 0.0)"/>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>
</odoo>
