<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_bank_voucher_inherit">
          <field name="name">account.move.bank.inherit</field>
          <field name="model">account.move</field>
          <field name="inherit_id" ref="account.view_move_form"/>
          <field name="arch" type="xml">
            <field name="move_type" position="after"><field name="od_is_bank_voucher" invisible="1"/></field>
          </field>
        </record>
        <record id="action_move_bank_voucher" model="ir.actions.act_window">
            <field name="name">Bank &amp; Cash Vouchers</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_move_tree"/>
            <field name="search_view_id" ref="account.view_account_move_filter"/>
            <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True, 'default_od_is_bank_voucher':True,'default_journal_id':7}</field>
            <field name="domain">[('journal_id.type','in',['bank','cash']),('od_is_bank_voucher','=',True)]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a journal entry
              </p><p>
                A journal entry consists of several journal items, each of
                which is either a debit or a credit transaction.
              </p>
            </field>
        </record>
        <menuitem id="menu_action_bank_voucher" name="Bank &amp; Cash Vouchers" action="action_move_bank_voucher" groups="account.group_account_readonly" parent="account.menu_finance_entries_accounting_miscellaneous" sequence="3"/>
    </data>
</odoo>