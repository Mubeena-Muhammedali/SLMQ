<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_payment_form_od_pdc_inherit" model="ir.ui.view">
        <field name="name">account.payment.od.pdc.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
        	<button name="action_post" position="after">
                <button name="release" string="Release" type="object" class="oe_highlight"  attrs="{'invisible': ['|','|',('payment_method_code', '=', 'manual'),('state', '!=', 'posted'),('od_released', '=', True)]}"/>
            </button>
            <field name="move_id" position="after">
                <field name="od_bank_account" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="is_clearing" attrs="{'readonly': [('state', '!=', 'draft')],'invisible': [('payment_method_code', '=', 'manual')]}"/>
                <field name="od_clearing_account" attrs="{'readonly': [('state', '!=', 'draft')],'invisible': [('is_clearing', '=', False)],'required': [('is_clearing', '=',True)]}"/>
                <field name="od_released" readonly="1" attrs="{'invisible': [('od_released', '=', False)]}"/>
                <field name="od_release_move_id" readonly="1" attrs="{'invisible': [('od_release_move_id', '=', False)]}"/>
             </field>
        </field>
    </record>

    <record id="od_view_payment_check_printing_search" model="ir.ui.view">
            <field name="name">od_view_payment_check_printing_search</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account_check_printing.view_payment_check_printing_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='checks_to_send']" position="after">
                    <separator/>
                    <field name="effective_date" string="Cheque Date"/>
                    <field name="cheque_reference" string="Cheque No"/>
                    <separator/>
                </xpath>
            </field>
    </record>

</odoo>

