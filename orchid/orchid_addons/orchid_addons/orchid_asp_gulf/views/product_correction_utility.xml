<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_product_correction_tree_view">
            <field name="name">od.product.correction.tree</field>
            <field name="model">od.product.correction</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Product Correction Utility" default_order="id desc">
                    <field name="name"/>
                    <field name="record_type"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="od_product_correction_form_view">
            <field name="name">od.product.correction.form</field>
            <field name="model">od.product.correction</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Product Correction Utility">
                    <header>
                        <button name="button_confirm" string="Confirm" states='draft' class="oe_highlight" type="object" confirm="Are you sure that you want to confirm the record?"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="record_type" attrs="{'readonly':[('state','!=','draft')]}" required="1"/>
                                <field name="sale_id" attrs="{'readonly':[('state','!=','draft')],'required':[('record_type','=','sale')],'invisible':[('record_type','!=','sale')]}" options="{'no_quick_create':True,'no_create_edit':True}"/>
                                <field name="contract_id" attrs="{'readonly':[('state','!=','draft')],'required':[('record_type','in',('contract','contract_name'))],'invisible':[('record_type','not in',('contract','contract_name'))]}" options="{'no_quick_create':True,'no_create_edit':True}"/>
                                <field name="old_contract_name" readonly="1" force_save="1"  attrs="{'invisible':[('record_type','!=','contract_name')]}"/>
                                <field name="new_contract_name" attrs="{'readonly':[('state','!=','draft')],'required':[('record_type','=','contract_name')],'invisible':[('record_type','!=','contract_name')]}"/>
                                <field name="company_id" invisible="1"/>
                                <field name="name" invisible="1"/>
                                <field name="description"/>

                            </group>
                            <group>
                            </group>
                        </group>
                        <field name="remarks" placeholder="Remarks...."/>
                        <notebook>
                            <page string="Prouct Lines" name="product_line_ds" attrs="{'invisible':[('record_type','!=','sale')]}">
                                <field name="product_line_ds" mode="tree" attrs="{'readonly':[('state','!=','draft')]}">
                                    <tree editable="top">
                                        <field name="sale_line_id" domain="[('order_id','=',parent.sale_id),('display_type','=',False)]" options="{'no_quick_create':True,'no_create_edit':True}" attrs="{'column_invisible':[('parent.state','!=','draft')]}"/>
                                        <field name="sale_line_display_name" readonly="1" force_save="1" attrs="{'column_invisible':[('parent.state','!=','confirm')]}"/>
                                        <field name="method" required="1"/>
                                        <field name="old_product_id" readonly="1" force_save="1"/>
                                        <field name="new_product_id" options="{'no_quick_create':True,'no_create_edit':True}" attrs="{'readonly':[('method','!=','Update')],'required':[('method','=','Update')]}" force_save="1"/>
                                        <field name="old_description" readonly="1" force_save="1"/>
                                        <field name="new_description" attrs="{'readonly':[('method','!=','Update')],'required':[('method','=','Update')]}" force_save="1"/>
                                        <field name="price_adjustment_line" options="{'no_quick_create':True,'no_create_edit':True}" attrs="{'readonly':[('method','!=','Deletion')],'required':[('method','=','Deletion')]}" force_save="1" domain="[('id','!=',sale_line_id),('order_id','=',parent.sale_id),('display_type','=',False)]"/>
                                        <field name="price_subtotal" readonly="1" force_save="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="utility_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Contract Lines" name="contract_lines" attrs="{'invisible':[('record_type','!=','contract')]}">
                                <field name="contract_line_ids" mode="tree" attrs="{'readonly':[('state','!=','draft')]}">
                                    <tree editable="top">
                                        <field name="contract_line_id" domain="[('order_id','=',parent.contract_id)]" options="{'no_quick_create':True,'no_create_edit':True}" attrs="{'column_invisible':[('parent.state','!=','draft')]}"/>
                                        <field name="contract_line_display_name" readonly="1" force_save="1" attrs="{'column_invisible':[('parent.state','!=','confirm')]}"/>
                                        <field name="method" required="1"/>
                                        <field name="old_product_id" readonly="1" force_save="1"/>
                                        <field name="new_product_id" options="{'no_quick_create':True,'no_create_edit':True}" attrs="{'readonly':[('method','!=','Update')],'required':[('method','=','Update')]}" force_save="1"/>
                                        <field name="old_description" readonly="1" force_save="1"/>
                                        <field name="new_description" attrs="{'readonly':[('method','!=','Update')],'required':[('method','=','Update')]}" force_save="1"/>
                                        <field name="price_adjustment_line" options="{'no_quick_create':True,'no_create_edit':True}" attrs="{'readonly':[('method','!=','Deletion')],'required':[('method','=','Deletion')]}" force_save="1" domain="[('id','!=',contract_line_id),('order_id','=',parent.contract_id)]"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="utility_id" invisible="1"/>
                                        <field name="price_subtotal" readonly="1" force_save="1" optional="hide"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                      <field name="message_follower_ids" widget="mail_followers"/>
                      <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="od_product_correction_filter_view">
            <field name="name">od.product.correction.filter</field>
            <field name="model">od.product.correction</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="name"/>
                    <group expand="0" string="Group By">
                        <filter name="saleOrder" string="Sale Order" domain="[]" context="{'group_by': 'name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_od_product_correction_view">
            <field name="name">Product Correction Utility</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.product.correction</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_product_correction_tree_view"/>
            <field name="search_view_id" ref="od_product_correction_filter_view"/>
        </record>
    </data>
</odoo>

