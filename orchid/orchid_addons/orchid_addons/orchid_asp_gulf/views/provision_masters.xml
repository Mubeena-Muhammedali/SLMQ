        <record id="utm_medium_view_form" model="ir.ui.view">
            <field name="name">utm.medium.view.form</field>
            <field name="model">utm.medium</field>
            <field name="inherit_id" ref="utm.utm_medium_view_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="od_channel_id"/>
                </field>
            </field>
        </record>

        <record id="utm_source_view_form" model="ir.ui.view">
            <field name="name">utm.source.view.form</field>
            <field name="model">utm.source</field>
            <field name="inherit_id" ref="utm.utm_source_view_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="od_channel_id"/>
                </field>
            </field>
        </record>
        <record model="ir.ui.view" id="view_utm_campaign_view_search">
            <field name="name">utm.campaign.view.search</field>
            <field name="model">utm.campaign</field>
            <field name="inherit_id" ref="utm.view_utm_campaign_view_search"/>
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </field>
            </field>
        </record>
        <record model="ir.ui.view" id="view_utm_campaign_view_search">
            <field name="name">utm.campaign.view.search</field>
            <field name="model">utm.campaign</field>
            <field name="inherit_id" ref="utm.view_utm_campaign_view_search"/>
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </field>
            </field>
        </record>
        <record id="od_utm_source_view_search" model="ir.ui.view">
            <field name="name">od.utm.source.view.search</field>
            <field name="model">utm.source</field>
            <field name="arch" type="xml">
                <search string="Search UTM Source">
                    <field name="name"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

    </data>
</odoo>