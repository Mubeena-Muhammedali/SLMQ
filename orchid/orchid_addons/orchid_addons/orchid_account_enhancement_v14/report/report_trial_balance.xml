                                    <td class="text-right"><b>Credit</b></td>
                                    <td class="text-right"><b>Balance</b></td>
                                </tr>
                                <!-- <t t-set="" -->
                                <tr t-foreach="Accounts" t-as="account">
                                    <t  t-if="account['d_type']=='account' ">
                                        <td>
                                            <span t-att-style="style" t-esc="account['code']"/>
                                        </td>
                                        <td>
                                            <span style="color: white;" t-esc="'..'"/>
                                            <span t-att-style="style" t-esc="account['name']"/>
                                        </td>
                                        <td class="text-right">
                                             <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_debit']))"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_credit']))"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_balance']))"/>
                                        </td>
                                        <td class="text-right">
                                             <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_debit']))"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_credit']))"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_balance']))"/>
                                        </td>

                                        <td class="text-right">
                                             <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_debit']))"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_credit']))"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_balance']))"/>
                                        </td>
                                    </t>
                                    <t  t-else="">
                                        
                                        <td colspan="2">
                                            <span style="color: white;" t-esc="'..'"/>
                                            <b><span t-att-style="style" t-esc="account['name']"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_debit']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_credit']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_balance']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_debit']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_credit']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_balance']))"/></b>
                                        </td>

                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_debit']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_credit']))"/></b>
                                        </td>
                                        <td class="text-right">
                                            <b><span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_balance']))"/></b>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="(data['detail']) and not (data['groupby'])">
                        <table class="table table-sm table-reports">
                            <thead>
                                <tr style="border-top:solid white 1px;">
                                    <th style="border-top:solid white 1px;" ></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;" ></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;"></th>
                                    <th style="border-top:solid white 1px;" ></th>
                                    <th style="border-top:solid white 1px;" ></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr  style="background-color:#D4D3D0;">
                                    <td colspan="2"/>
                                    <td colspan="3"><center><b>Opening</b></center></td>
                                    <td colspan="3"><center><b>Current</b></center></td>
                                    <td colspan="3"><center><b>Closing</b></center></td>
                                </tr>
                                <tr>
                                    <td>Code</td>
                                    <td>Account</td>
                                    <td class="text-right"><b>Debit</b></td>
                                    <td class="text-right"><b>Credit</b></td>
                                    <td class="text-right"><b>Balance</b></td>
                                    <td class="text-right"><b>Debit</b></td>
                                    <td class="text-right"><b>Credit</b></td>
                                    <td class="text-right"><b>Balance</b></td>
                                    <td class="text-right"><b>Debit</b></td>
                                    <td class="text-right"><b>Credit</b></td>
                                    <td class="text-right"><b>Balance</b></td>
                                </tr>
                                <!-- <t t-set="" -->
                                <tr t-foreach="Accounts" t-as="account">
                                    <td>
                                        <span t-att-style="style" t-esc="account['code']"/>
                                    </td>
                                    <td>
                                        <span style="color: white;" t-esc="'..'"/>
                                        <span t-att-style="style" t-esc="account['name']"/>
                                    </td>
                                    <td class="text-right">
                                         <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_debit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_credit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['open_balance']))"/>
                                    </td>
                                    <td class="text-right">
                                         <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_debit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_credit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['current_balance']))"/>
                                    </td>

                                    <td class="text-right">
                                         <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_debit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_credit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-att-style="style" t-esc="'{0:,.2f}'.format(float(account['close_balance']))"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
