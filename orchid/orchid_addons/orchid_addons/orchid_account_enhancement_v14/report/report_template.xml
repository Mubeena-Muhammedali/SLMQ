<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_report_template_tree_view">
            <field name="name">od.report.template.tree</field>
            <field name="model">od.report.template</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
			    <tree string="Report Template" default_order="sequence">
                    <field name="sequence"/>
                    <field name="name" />
                    <field name="display_details"/>
                    <field name="report_value"/>
                    <field name="sign"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="od_report_template_form_view">
            <field name="name">od.report.template.form</field>
            <field name="model">od.report.template</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Report Template">
					<sheet>
                        <group>
                            <group>
                                <field name="account_grp_id"/>
                                <field name="sequence" />
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="name"/>
                                <field name="display_details"/>
                                <field name="sign" required="1"/>
                                <field name="report_value"/>
                                <field name="report_template_id" attrs="{'invisible':[('display_details','!=','report_value')],'required':[('display_details','=','report_value')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="accounts" string="Accounts" attrs="{'invisible':[('display_details','!=','accounts')]}">
                                <field name="account_account_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="template_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="groups" string="Groups" attrs="{'invisible':[('display_details','!=','compute')]}">
                                <field name="account_group_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="template_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_od_report_template">
            <field name="name">Report Template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.report.template</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_report_template_tree_view"/>
        </record>

        <menuitem id="od_report_template_menu" name="Report Template" parent="account.account_account_menu" action="action_od_report_template" sequence="13"/>
    </data>
</odoo>