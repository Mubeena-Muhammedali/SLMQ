<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_asset_register_wiz_form" model="ir.ui.view">
        <field name="name">od.asset.register.wiz.form</field>
        <field name="model">od.asset.register.wiz</field>
        <field name="arch" type="xml">
            <form string="Asset Register">
                <group>
                    <group>
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                    </group>
                    <group>
                        <field name="report_type" required="1" widget="radio"/>
                        <field name="category_ids" widget="many2many_tags"/>
                        <field name="company_id" invisible="1"/>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_excel" string="Excel" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>
    <record id="od_asset_register_wiz_action" model="ir.actions.act_window">
        <field name="name">Asset Register</field>
        <field name="res_model">od.asset.register.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="od_asset_register_wiz_menu" action="od_asset_register_wiz_action" parent="account.account_reports_management_menu" sequence="5"/>
</odoo>