<?xml version="1.0"?>
<odoo>
    <record id="od_merge_revenue_line_wiz_view_form" model="ir.ui.view">
        <field name="name">od.merge.revenue.line.wiz.form</field>
        <field name="model">od.merge.revenue.line.wiz</field>
        <field name="arch" type="xml">
            <form string="Merge Revenue Lines">
                <group>
                    <group>
                        <field name="payment_id" readonly="1"/>
                        <label for="period_from"/>
                        <div name="period_div" class="d-flex">
                            <field name="period_from" required="1"/>
                            <span class="oe_inline o_form_label mx-3 oe_read_only">To</span>
                            <!-- Bigger margin on the left because in edit mode the external link button covers the text -->
                            <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">To</span>
                            <field name="period_to" required="1"/>
                        </div>
                        <label for="merge_from_period"/>
                        <div name="merge_period_div" class="d-flex">
                            <field name="merge_from_period" required="1"/>
                            <span class="oe_inline o_form_label mx-3 oe_read_only">To</span>
                            <!-- Bigger margin on the left because in edit mode the external link button covers the text -->
                            <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">To</span>
                            <field name="merge_to_period" required="1"/>
                        </div>
                    </group>
                    <group></group>
                </group>
                <footer>
                    <button name="merge_lines" type="object" class="oe_highlight" string="Merge"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="od_merge_revenue_line_wiz_action" model="ir.actions.act_window">
        <field name="name">Merge Revenue Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">od.merge.revenue.line.wiz</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="od_merge_revenue_line_wiz_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
