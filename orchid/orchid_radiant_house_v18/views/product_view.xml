<?xml version="1.0"?>
<odoo>
    <data>
        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="/form/sheet/div[@name='options']" position="after">
                    <group>
                        <field name="od_product_type"/>
                        <field name="od_customer_id"  invisible="od_product_type != 'finished_product'" required="od_product_type == 'finished_product'" context="{'default_customer_rank':1, 'default_company_type':'company'}" options="{'no_quick_create':1}"/>
                        <field name="od_supplier_id"  invisible="od_product_type == 'finished_product'" required="od_product_type == 'raw_material'" context="{'default_supplier_rank':1, 'default_company_type':'company'}" options="{'no_quick_create':1}"/>
                    </group>
                </xpath>
                <xpath expr="//page[@name='sales']" position="after" >
                <page string="Product Specification" invisible="od_product_type != 'finished_product'">
                    <group>
                        <group>
                            <field name="od_proof_request_id" invisible="1" force_save="1"/>
                            <field name="od_die_id" />
                            <field name="od_raw_material_id" />
                            <field name="od_application"/>
                            <field name="od_application_temp"/>
                            <field name="od_storage_temp" />
                            <field name="od_lbw" />
                            <field name="od_prod_to_be_filled" />
                            <field name="od_container_type" />
                             <field name="od_wdg_direction" />
                             <field name="od_wdg_direction_back" />
                             <field name="od_product_segment"/>
                        </group>
                        <group>
                            <field name="od_continouse_print"/>
                            <field name="od_print_finishing"/>
                            <field name="od_sec_printing"/>
                        </group>
                        <group>
                            <field name='od_no_of_colors_1' />
                            <field name="od_width" />
                            <field name="od_length" />
                            <field name="od_printing_process" />
                            <field name="od_screen" />
                            <field name="od_hot_foil" />
                            <field name="od_cold_foil" />
                            <field name="od_cold_foil_light"/>
                            <field name="od_holographic_foil"/>
                            <field name="od_silver_foil"/>
                            <field name="od_glossy_lamination"/>
                            <field name="od_matt_lamination"/>
                            <field name="od_plain"/>
                            <field name="od_printed"/> 
                            <field name="od_micron"/>
                            <field name="od_yards"/>
                            <field name="od_inch"/>
                            <field name="od_rolls"/>
                            <field name="od_box"/>
                            <field name="od_plastic"/>
                            <field name="od_inkout"/>
                            <field name="od_inkin"/>
                        </group>
                        <group>
                            <field name="od_type_of_primer"/>
                            <field name="od_digital_ink" />
                            <field name="od_embossing"/>
                        </group>
                        <group>
                           <field name="od_adhesive"/>
                         <field name="od_color_matching_ref"/>
                         <field name="od_pms_no"/>
                         <field name="od_conv_format"/>
                         <field name="od_core"/>
                        </group>
                        <group>
                           <field name="od_printing_sude"/>
                           <field name="od_speacial_req"/>
                           <field name="od_speacial_req_id" widget="many2many_tags"/>
                           <field name="od_art_ref_no"/>
                           <field name="od_art_work_code"/>
                           <field name="od_type_of_printing"/>
                        </group>
                    </group>
                    <separator string="__________________________________________________________________________"/>
                        <group>
                            <group>
                                <field name="od_pcs_roll" />
                                <field name="od_pack_roll" />
                            </group>
                            <group>
                                <field name="od_of_roll" />
                                <field name="od_cartons" />
                                <field name="od_pallet_spec" />
                            </group>
                            <group colspan="4">
                                <field name="od_note_spec" />
                            </group>
                        </group>

                    </page>
                    <page string="Die Specification" invisible="od_product_type != 'diecut'">
                        <group>
                            <group>
                                <field name='od_die_type' />
                                <field name="od_material2" required="od_product_type == 'diecut'"/>
                                <field name="od_mat_id" domain="[('od_product_type','=','raw_material')]" required="od_product_type == 'diecut'"/>
                            </group>
                            <group>
                                <field name="od_face2" />
                                <field name="od_gsm" />
                                <field name="od_micron" />
                            </group>
                            <group>
                                <field name="od_liner3" required="od_product_type == 'diecut'" />
                                <field name="od_gsm2" />
                                <field name="od_micron2" />
                            </group>
                            <group>
                                <field name="od_width_of_label" required="od_product_type == 'diecut'"/>
                                <field name="od_cylinder_teeth_1" required="od_product_type == 'diecut'"/>
                                <field name="od_machine2" />
                                <!-- <field name="od_shape"/> -->
                                <field name="od_shape_id" />
                                <field name="od_cutting" required="od_product_type == 'diecut'"/>
                            </group>
                            <group>
                                <field name="od_length_of_label" required="od_product_type == 'diecut'"/>
                                <field name="od_repeat_in_mm" required="od_product_type == 'diecut'"/>
                                <field name="od_radius_corner" required="od_product_type == 'diecut'"/>
                                <field name="od_material_width" />
                            </group>
                            <group>
                                <field name="od_ups_across" required="od_product_type == 'diecut'"/>
                                <field name="od_gap_across" required="od_product_type == 'diecut'"/>
                            </group>
                            <group>
                              <field name="od_ups_around" required="od_product_type == 'diecut'"/>
                              <field name="od_gap_around" required="od_product_type == 'diecut'"/>
                            </group>
                        </group>
                    </page>
                    <page string="Raw Material Specification" invisible="od_product_type not in ('diecut','raw_material')">
                        <group col="6" colspan="2">
                            <field name="od_face_stock2" />
                            <field name="od_face_stock_type2" />
                            <field name="od_raw_thickness" />
                        </group>
                        <group col="4" colspan="2">
                           <field name="od_adhesive_raw2" />
                           <field name="od_adhesive_thick" />
                        </group>
                        <group col="4" colspan="2">
                           <field name="od_raw_liner3" />
                            <field name="od_raw_liner_thickness" />
                        </group>
                        <group>
                         <field name="od_raw_width" />
                        <field name="od_avg_conversion_rate"/>
                        <!-- attrs="{'invisible':[('uom_id','!=',5442)]}"/> -->
                        </group>
                    </page>
                    <page string="Overhead" invisible="type != 'service'">
                        <group>
                            <group>
                                <field name="od_auto" />
                                <field name="od_default" />
                            </group>
                            <group>
                                <field name="od_timebase" />
                                <field name="od_only_in_firstproduction" />
                            </group>
                        </group>
                        <group>
                            <field name="od_overhead_pdts">
                                <list editable="bottom">
                                    <field name="product_id" required="1"/>
                                    <field name="eval_code" required="1"/>
                                    <field name="uom_id"/>
                                    <field name="machine_id" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                        <field name="od_eval_code" invisible="not od_auto"/>
                    </page>

                </xpath>
                <xpath expr="//page[@name='sales']" position="after">
                    <page name="orchid_config" string="Product Configuration" >
                        <group>
                            <group>
                                <field name="orchid_brand_id" />
                                <field name="orchid_type_id"  />
                                <field name="orchid_sub_type_id"  />
                                <!-- <field name="orchid_country_id" /> -->
                            </group>
                            <group>
                                <field name="orchid_group_id"  />
                                <field name="orchid_sub_group_id"  />
                                <field name="orchid_class_id"  />
                                <!-- <field name="orchid_hscode_id" /> -->
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="od_product_template_form_view_inherited_from_tax" model="ir.ui.view">
            <field name="name">product.template</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='taxes_id']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <field name="categ_id" position="before">
                    <field name="od_production_uom_id" options="{'no_create': True}"/>
                    <field name="od_machine_pp"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
