<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="payment_reference" position="after">
                    <field name="od_picking_name"/>
                </field>
                <!-- Customer Order Before Quantity -->
                <xpath expr="//notebook/page/field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                    <field name="od_customer_order"/>
                    <field name="od_customer_uom_id" force_save="1" domain="[('id','in',(1,31,32,5,28))]" options="{'no_create':1,'no_create_edit':1}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>