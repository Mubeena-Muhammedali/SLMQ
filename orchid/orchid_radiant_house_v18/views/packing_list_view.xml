<?xml version="1.0"?>
<odoo>
    <data>
      <record id="view_from_stock_picking_form_inherit" model="ir.ui.view">
           <field name="name">stock.picking</field>
           <field name="model">stock.picking</field>
           <field name="inherit_id" ref="stock.view_picking_form"/>
           <field name="arch" type="xml">
                 <page name="extra" position="after">
                     <page string="Packing List">
                        <button name="od_copy" type="object" string="Duplicate" invisible="not od_packing_list_ids"/>
                         <field name="od_packing_list_ids">
                             <list editable="bottom">
                                 <field name="product_id"/>
                                 <field name="pallet_no"/>
                                 <field name="carton_number"/>
                                 <field name="no_of_cartons"/>
                                 <field name="labels_per_reel"/>
                                 <field name="reels_per_carton"/>
                                 <field name="labels_per_carton"/>
                                 <field name="total"/>
                                 <field name="gross_weight"/>
                                 <field name="net_weight"/>
                                 <field name="check"/>
                                 <field name="od_duplicate"/>
                             </list>
                        </field>
                    </page>
                </page>

                <!-- Quantity On hand After Quantity -->
                <xpath expr="//notebook/page/field[@name='move_ids_without_package']/list/field[@name='quantity']" position="after">
                    <field name="od_qty_on_hand" readonly="1" force_save="1"/>
                </xpath>

           </field>
      </record>
    </data>
</odoo>
