<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp.orchid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="mrp" position="inside">
                <block title="Other Info" name="od_other_info">
                    <group>
                        <!-- Left column -->
                        <group>
                            <field name="od_ink_id"/>
                            <field name="od_overhead_journal_id"/>
                            <field name="od_production_acc_id"/>
                        </group>

                        <!-- Right column -->
                        <group>
                            <field name="od_overhead_product_id"/>
                            <field name="od_overhead_account_id"/>
                            <field name="def_slitting_loc_id"/>
                        </group>
                    </group>
                </block>
            </app>
        </field>
    </record>


</odoo>
