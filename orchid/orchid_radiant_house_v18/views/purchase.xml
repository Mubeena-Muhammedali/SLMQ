<?xml version="1.0"?>
<odoo>
    <data>

        <!-- Inherit po Order Form View -->
        <record id="purchase_order_form" model="ir.ui.view">
            <field name="name">od.purchase.order</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='date_planned']" position="before">
                    <field name="od_last_po_date" readonly="1" force_save="1"/>
                    <field name="od_last_purchase_price" readonly="1" force_save="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
