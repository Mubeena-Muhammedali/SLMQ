<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_od_estimation_list" model="ir.ui.view">
      <field name="name">od.estimation.list</field>
      <field name="model">od.estimation</field>
      <field name="arch" type="xml">
        <list string="Estimations">
          <field name="name"/>
          <field name="estimation_date"/>
          <field name="partner_id"/>
          <field name="project_detail"/>
          <field name="estimation_product_id"/>
          <field name="quantity_of_rolls"/>
          <field name="selling_price"/>
          <field name="total_sales"/>
          <field name="user_id"/>
          <field name="state" widget="badge"/>
        </list>
      </field>
    </record>

    <record id="view_od_estimation_search" model="ir.ui.view">
      <field name="name">od.estimation.search</field>
      <field name="model">od.estimation</field>
      <field name="arch" type="xml">
        <search string="Estimations">
          <field name="name"/>
          <field name="partner_id"/>
          <field name="project_detail"/>
          <field name="estimation_product_id"/>
          <field name="user_id"/>
          <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
          <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
          <filter name="converted" string="Quotation Created" domain="[('state','=','converted')]"/>
          <group expand="0" string="Group By">
            <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
            <filter name="group_responsible" string="Responsible" context="{'group_by': 'user_id'}"/>
            <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="view_od_estimation_form" model="ir.ui.view">
      <field name="name">od.estimation.form</field>
      <field name="model">od.estimation</field>
      <field name="arch" type="xml">
        <form string="Estimation">
          <header>
            <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_create_sales_quotation" string="Create Sales Quotation" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
            <button name="action_set_draft" string="Set to Draft" type="object" invisible="state not in ('confirmed','cancel')"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancel','converted')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,converted"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_sales_quotation" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not quotation_id">
                <field name="quotation_id" widget="statinfo" string="Sales Quotation"/>
              </button>
            </div>
            <div class="oe_title">
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="partner_id"/>
                <field name="project_detail"/>
                <field name="estimation_product_id"/>
                <field name="quotation_id" invisible="1"/>
              </group>
              <group>
                <field name="estimation_date"/>
                <field name="valid_until"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" invisible="1"/>
              </group>
            </group>

            <notebook>
              <page name="parameters" string="Parameters">
                <group>
                  <group>
                    <field name="width"/>
                    <field name="height"/>
                    <field name="across"/>
                    <field name="paper_width" readonly="1"/>
                    <field name="sheets_per_roll"/>
                    <field name="margin_option" readonly="1"/>
                    <field name="price_per_roll" readonly="1"/>
                    <field name="die_cutter_cost" readonly="1"/>
                  </group>
                  <group>
                    <field name="paper_price"/>
                    <field name="no_of_colors"/>
                    <field name="number_of_plates"/>
                    <field name="gap_across"/>
                    <field name="gap_around"/>
                    <field name="price" readonly="1"/>
                  </group>
                </group>
              </page>

              <page name="additional_costing" string="Additional Costing">
                <group>
                  <group>
                    <field name="quantity_of_rolls"/>
                    <field name="number_of_around"/>
                    <field name="cost_of_plates" readonly="1"/>
                    <field name="include_varnish"/>
                    <field name="varnish_cost" readonly="1"/>
                    <field name="ink_cost" readonly="1"/>
                    <field name="die_cutter_cost"/>
                    <field name="foil_width" readonly="1"/>
                    <field name="foil_cost" readonly="1"/>
                    <field name="lamination_width" readonly="1"/>
                    <field name="lamination_cost" readonly="1"/>
                  </group>
                  <group>
                    <field name="rolls_per_master" readonly="1"/>
                    <field name="price_of_master" readonly="1"/>
                    <field name="total_liner_meters" readonly="1"/>
                    <field name="total_cost_of_paper" readonly="1"/>
                    <field name="extra_line_wastage"/>
                    <field name="include_printing_wastage"/>
                    <field name="extra_wastage_for_printing" readonly="1"/>
                    <field name="total_linear_meter" readonly="1"/>
                    <field name="cost_of_paper_with_waste" readonly="1"/>
                  </group>
                </group>
              </page>

              <page name="machine_cost" string="Machine Cost">
                <group>
                  <group>
                    <field name="machine_name"/>
                    <field name="machine_cost_per_hour"/>
                    <field name="machine_speed"/>
                    <field name="make_ready_time"/>
                  </group>
                  <group>
                    <field name="roll_changeover_time" readonly="1"/>
                    <field name="machine_time_min" readonly="1"/>
                    <field name="total_machine_hours" readonly="1"/>
                    <field name="total_machine_cost" readonly="1"/>
                    <field name="uv_lamp_cost" readonly="1"/>
                    <field name="additional_ribbon_cost" readonly="1"/>
                  </group>
                </group>
              </page>

              <page name="total_costing" string="Total Costing">
                <group>
                  <group>
                    <field name="margin_option"/>
                    <field name="margin" invisible="1"/>
                    <field name="total_cost" readonly="1"/>
                    <field name="total_sales" readonly="1"/>
                    <field name="price_per_roll" readonly="1"/>
                  </group>
                  <group>
                    <field name="net_profit" widget="percentage" readonly="1"/>
                    <field name="actual_profit" readonly="1"/>
                    <field name="selling_price" readonly="1"/>
                  </group>
                </group>
              </page>

              <page name="cylinder_repeat" string="Cylinder / Repeat">
                <group>
                  <group>
                    <field name="cylinder_height_1"/>
                    <field name="cylinder_around_1"/>
                    <field name="cylinder_teeth_size_id"/>
                    <field name="cylinder_teeth_1" readonly="1"/>
                  </group>
                  <group>
                    <field name="repeat_length_1" readonly="1"/>
                    <field name="cylinder_gap_around_1" readonly="1"/>
                  </group>
                </group>
              </page>

              <page name="notes" string="Notes">
                <field name="note" placeholder="Internal estimation notes, mapping notes, or customer requirements..."/>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_od_estimation_product_list" model="ir.ui.view">
      <field name="name">od.estimation.product.list</field>
      <field name="model">od.estimation.product</field>
      <field name="arch" type="xml">
        <list string="Estimation Products" editable="bottom">
          <field name="name"/>
          <field name="price" widget="float"/>
          <field name="currency_id" groups="base.group_multi_currency"/>
        </list>
      </field>
    </record>

    <record id="view_od_estimation_product_form" model="ir.ui.view">
      <field name="name">od.estimation.product.form</field>
      <field name="model">od.estimation.product</field>
      <field name="arch" type="xml">
        <form string="Estimation Product">
          <sheet>
            <group>
              <field name="name"/>
              <field name="price" widget="float"/>
              <field name="currency_id" groups="base.group_multi_currency"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_od_estimation_product_search" model="ir.ui.view">
      <field name="name">od.estimation.product.search</field>
      <field name="model">od.estimation.product</field>
      <field name="arch" type="xml">
        <search string="Estimation Products">
          <field name="name"/>
        </search>
      </field>
    </record>

    <record id="view_od_estimation_teeth_size_list" model="ir.ui.view">
      <field name="name">od.estimation.teeth.size.list</field>
      <field name="model">od.estimation.teeth.size</field>
      <field name="arch" type="xml">
        <list string="Teeth Size" editable="bottom">
          <field name="teeth"/>
          <field name="length"/>
        </list>
      </field>
    </record>

    <record id="view_od_estimation_teeth_size_form" model="ir.ui.view">
      <field name="name">od.estimation.teeth.size.form</field>
      <field name="model">od.estimation.teeth.size</field>
      <field name="arch" type="xml">
        <form string="Teeth Size">
          <sheet>
            <group>
              <field name="teeth"/>
              <field name="length"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_od_estimation_teeth_size_search" model="ir.ui.view">
      <field name="name">od.estimation.teeth.size.search</field>
      <field name="model">od.estimation.teeth.size</field>
      <field name="arch" type="xml">
        <search string="Teeth Size">
          <field name="teeth"/>
          <field name="length"/>
        </search>
      </field>
    </record>

    <record id="action_od_estimation_teeth_size" model="ir.actions.act_window">
      <field name="name">Teeth Size</field>
      <field name="res_model">od.estimation.teeth.size</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_od_estimation_teeth_size_search"/>
    </record>

    <record id="action_od_estimation_product" model="ir.actions.act_window">
      <field name="name">Estimation Products</field>
      <field name="res_model">od.estimation.product</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_od_estimation_product_search"/>
    </record>

    <record id="action_od_estimation" model="ir.actions.act_window">
      <field name="name">Estimation</field>
      <field name="res_model">od.estimation</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_od_estimation_search"/>
      <field name="context">{'search_default_draft': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create an estimation before a sales quotation.
        </p>
      </field>
    </record>
  </data>
</odoo>
