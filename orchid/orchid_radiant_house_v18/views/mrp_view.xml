<?xml version="1.0"?>
<odoo>
  <data>
    <!-- Inherited MRP Production Form -->
    <record id="od_mrp_production_inherit_orchid" model="ir.ui.view">
      <field name="name">mrp.production.form.orchid</field>
      <field name="model">mrp.production</field>
      <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
      <field name="arch" type="xml">

        <!-- Extra fields after company -->
        <field name="user_id" position="after">
          <!-- <field name="od_cylinder" invisible="1"/> -->
          <field name="od_analytic_id"/>
          <field name="od_mrp_id"
            domain="[('product_id','=',product_id)]"
            invisible="od_plate_manufacturing"
            readonly="state != 'draft'"/>
          <field name="od_plate_manufacturing" invisible="1"/>
        </field>

        <!-- Config Page -->
        <xpath expr="/form/sheet/notebook" position="inside">
          <page name="od_config" string="Configuration">
            <group>
              <group>
                <field name="od_sale_order_line_id" groups="base.group_system"/>
                <field name="od_machine_id" domain="[('od_machine_pp','=',True)]" readonly="state != 'draft'"/>
                <field name="od_landed_cost_ids" widget="many2many_tags" invisible="1"/>
                <field name="od_start" readonly="state in ('done','cancel')"/>
                <field name="od_stop" readonly="state in ('done','cancel')"/>
                <field name="od_ideal" invisible="1"/>
                <field name="od_machine_minute"
                  invisible="od_plate_manufacturing"
                   readonly="state in ('done','cancel')"/>
                <field name="od_machine_extra_minute"
                  invisible="od_plate_manufacturing or not od_digital"
                   readonly="state in ('done','cancel')"/>
                <field name="od_machine_hrs"
                  invisible="od_plate_manufacturing"
                   readonly="state in ('done','cancel')"/>
                <field name="od_hours" digits="[12,4]" invisible="od_plate_manufacturing"/>
              </group>
              <group>
                <field name="od_new_die" invisible="od_plate_manufacturing" readonly="state != 'draft'"/>
                <field name="od_online_die" invisible="od_plate_manufacturing"/>
                <field name="od_flat_bed_die" invisible="od_plate_manufacturing"/>
                <field name="od_old_flat_bed_die" invisible="od_plate_manufacturing"/>
                <field name="od_new_order" invisible="od_plate_manufacturing" readonly="state != 'draft'"/>
                <field name="od_repeat_job" invisible="od_plate_manufacturing" readonly="state != 'draft'"/>
                <field name="od_repeat_correction" invisible="od_plate_manufacturing" readonly="state != 'draft'"/>
                <field name="od_existing_die" invisible="od_plate_manufacturing"/>
                <field name="od_new_plate" invisible="od_plate_manufacturing" readonly="state != 'draft'"/>
                <field name="od_consumedbalance" readonly="state == 'done'" invisible="od_plate_manufacturing"/>
                <field name="od_validity_date" invisible="od_plate_manufacturing"/>
                <field name="od_digital" invisible="od_plate_manufacturing"/>
                <field name="od_remarks"/>
                <field name="od_date_finished" force_save="1" readonly="1" invisible="0"/>
              </group>
            </group>
          </page>
        </xpath>

        <!-- Components tab extra fields -->
        <xpath expr="/form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']" position="before">
          <group>
            <group>
              <field name="od_cylinder" readonly="1" force_save="1"/>
              <field name="od_good_mtr"/>
              <field name="od_make_ready_waste" invisible="od_plate_manufacturing"/>
            </group>
            <group>
              <field name="od_process_waste"/>
              <field name="od_misc_waste" invisible="od_plate_manufacturing"/>
              <field name="od_total_reqd_mtr" invisible="od_plate_manufacturing"/>
            </group>
            <group>
              <field name="od_printing_time" invisible="od_plate_manufacturing"/>
              <field name="od_make_ready_time" invisible="od_plate_manufacturing"/>
              <field name="od_cleaning_time" invisible="od_plate_manufacturing"/>
              <field name="od_costing_computed" invisible="1"/>
            </group>
          </group>
        </xpath>

        <!-- Replace tree with list for raw moves -->
        <!-- <xpath expr="/form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list/field[@name='product_uom']" position="replace"/> -->
        <!-- <xpath expr="/form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list/field[@name='product_id']" position="after">
          <field name="product_uom"
            domain="[('od_manufacturing','=',True)]"
            options="{'no_open': True, 'no_create': True}"
            groups="uom.group_uom"
            readonly="state != 'draft' and id != False"/>
        </xpath> -->
        <xpath expr="/form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list/field[@name='quantity']" position="after">
          <field name="od_consumed" readonly="1"/>
          <field name="od_product_uom" readonly="1"/>
        </xpath>

        <!-- Overhead page -->
        <xpath expr="/form/sheet/notebook/page[@name='components']" position="after">
          <page string="Overhead">
            <field name="od_overhead_line" readonly="state != 'ready'">
              <list editable="bottom">
                <field name="product_id" domain="[('type','=','service')]"/>
                <field name="qty" digits="[12,4]"/>
                <field name="uom_id" optional="hide" force_save="1"/>
                <field name="od_auto"/>
                <field name="cost" readonly="od_auto"/>
              </list>
            </field>
            <group>
              <field name="od_overhead_manual" class="oe_right"/>
              <field name="od_overhead_auto" class="oe_right"/>
              <field name="od_overhead_total" class="oe_right"/>
              <field name="od_raw_material_cost" invisible="1"/>
            </group>
          </page>
          <page name="od_intercompany" string="Inter Company Transfers">
            <field name="od_intercompany_transfer_ids" readonly="state in ('done','cancel')">
              <list editable="bottom">
                <field name="product_id" required="1"/>
                <field name="qty" sum="QTY"/>
                <field name="price_unit"/>
                <field name="from_company_id" required="1" options="{'no_create':1,'no_create_edit':1}"/>
                <field name="company_id" column_invisible="1"/>
                <field name="mrp_id" column_invisible="1"/>
                <field name="state" optional="hide" readonly="1" force_save="1"/>
                <button name="button_validate" string="Validate" type="object" invisible="state != 'Draft'"/>
              </list>
            </field>
          </page>

          <!-- Costing Sheet -->
          <page string="Costing sheet">
            <separator string="Finished Product"/>
            <field name="cost_sheet_lines_fp" readonly="1">
              <list create="false">
                <field name="production_id" column_invisible="1"/>
                <field name="product_id" readonly="1"/>
                <field name="unit_cost" digits="[12,4]"/>
                <field name="qty"/>
                <field name="amount" sum="Total"/>
              </list>
            </field>

            <separator string="Raw Material"/>
            <field name="cost_sheet_lines_rm" readonly="1">
              <list create="false">
                <field name="production_id" column_invisible="1"/>
                <field name="product_id"/>
                <field name="unit_cost" digits="[12,4]"/>
                <field name="qty"/>
                <field name="amount" sum="Total"/>
              </list>
            </field>

            <separator string="Overhead"/>
            <field name="cost_sheet_lines_oh" readonly="1">
              <list create="false">
                <field name="production_id" column_invisible="1"/>
                <field name="product_id"/>
                <field name="unit_cost" digits="[12,4]"/>
                <field name="qty" digits="[12,4]"/>
                <field name="uom_id" optional="show" force_save="1"/>
                <field name="amount" sum="Total"/>
              </list>
            </field>

            <group>
              <group>
                <field name="od_price_unit" invisible="od_plate_manufacturing"/>
              </group>
              <group/>
            </group>
          </page>
        </xpath>

        <!-- Buttons -->
        <xpath expr="//div[@name='button_box']" position="inside">
          <button string="Journal Entry" type="object" name="od_action_view_account_moves"
            class="oe_stat_button" icon="fa-list" invisible="state != 'done'"/>
        </xpath>
        <xpath expr="//button[@name='action_cancel']" position="after">
          <button name="od_create_costing_sheet" string="Compute"
            type="object" class="oe_highlight" invisible="state != 'done'"/>
        </xpath>
        <xpath expr="/form/sheet/group[1]/group[1]" position="inside">
          <label for="od_customer_order" string="Customer Order"/>
          <div class="o_row align-items-center" style="gap:4px;">
              <field name="od_customer_order"
                     class="oe_inline text-start text-truncate"
                     readonly="1"
                     force_save="1"
                     style="width:auto!important; flex:0 0 auto;"/>
              <field name="od_customer_uom_id"
                     options="{'no_open': True, 'no_create': True}"
                     readonly="1"
                     force_save="1"
                     style="width:70px!important; flex:0 0 auto; margin-left:4px;"/>
          </div>

        </xpath>
      </field>
    </record>

    <!-- Plate Manufacturing Action -->
    <record id="od_mrp_plate_action" model="ir.actions.act_window">
      <field name="name">Plate Manufacturing</field>
      <field name="res_model">mrp.production</field>
      <field name="domain">[('od_plate_manufacturing', '=', True)]</field>
      <field name="context">{'default_od_new_die': 0, 'default_od_plate_manufacturing': 1, 'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}</field>
      <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
      <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Click to create a Plate Manufacturing.
        </p>
      </field>
    </record>

    <!-- Manufacturing Orders Action Override to include the domain -->
    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
      <field name="name">Manufacturing Orders</field>
      <field name="path">manufacturing</field>
      <field name="res_model">mrp.production</field>
      <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
      <field name="view_id" eval="False"/>
      <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
      <field name="context">{'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}</field>
      <field name="domain">[('picking_type_id.active', '=', True), ('od_plate_manufacturing', '=', False)]</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          No manufacturing order found. Let's create one.
        </p><p>
          Use Manufacturing Orders (MO) to build finished products while consuming components: i.e. 1 Table = 4 Table Legs + 1 Table Top
        </p>
      </field>
    </record>

    <record id="view_mrp_production_filter_inherit" model="ir.ui.view">
      <field name="name">mrp.production.filter.orchid</field>
      <field name="model">mrp.production</field>
      <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
      <field name="arch" type="xml">
        <filter name="filter_ready" position="after">
          <separator/>
          <filter name="od_filter_done_today" string="Done Today" domain="[('state','=','done'),('od_date_finished', '=', context_today().strftime('%Y-%m-%d'))] " />
          <separator/>
        </filter>
      </field>
    </record>

    <record id="mrp_production_tree_view_inherit" model="ir.ui.view">
      <field name="name">mrp.production.tree.orchid</field>
      <field name="model">mrp.production</field>
      <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
      <field name="arch" type="xml">
        <field name="product_id" position="before">
          <field name="od_partner_id" readonly="1" force_save="1"/>
          <field name="od_salesman_id" readonly="1" force_save="1"/>
        </field>
        <field name="product_id" position="after">
          <field name="od_product_segment" readonly="1" force_save="1"/>
        </field>
      </field>
    </record>

    <record id="view_picking_form" model="ir.ui.view">
      <field name="name">stock.picking</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom']" position="after">
          <field name="od_produced_qty" force_save="1" readonly="1"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
