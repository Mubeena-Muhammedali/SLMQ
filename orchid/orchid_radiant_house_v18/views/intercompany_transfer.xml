<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_od_intercompany_transfer_tree" model="ir.ui.view">
        <field name="name">od.intercompany.transfer.tree</field>
        <field name="model">od.intercompany.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="from_company_id"/>
                <field name="company_id" string="To Company"/>
                <field name="po_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_od_intercompany_transfer_form" model="ir.ui.view">
        <field name="name">od.intercompany.transfer.form</field>
        <field name="model">od.intercompany.transfer</field>
        <field name="arch" type="xml">
            <form string="Intercompany Transfer">

                <!-- HEADER -->
                <header>
                    <button name="button_submit" type="object" string="Submit"
                        class="btn-primary"
                        invisible="state != 'Draft'"/>

                    <button name="button_validate" type="object" string="Validate"
                        class="btn-success"
                        invisible="state != 'Submitted'" confirm="Are you sure that you want to validate this transfer?"/>

                    <button name="button_draft" type="object" string="Set to Draft"
                        class="btn-secondary"
                        invisible="state != 'Submitted'"/>

                    <button name="button_cancel" type="object" string="Cancel"
                        class="btn-secondary"
                        invisible="state in ('Cancelled','Validated')"/>
                    
                    <field name="state" widget="statusbar"/>
                </header>

                <!-- BODY -->
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_transfers"
                            class="oe_stat_button"
                            icon="fa-building-o"
                            type="object"
                            invisible="state != 'Validated'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Transfers</span>
                            </div>
                        </button> 
                    </div>

                    <!-- Title -->
                    <h1 class="oe_title">
                        <field name="name" placeholder="Transfer Reference" readonly="1"/>
                    </h1>

                    <!-- Main Fields -->
                    <group>
                        <group>
                            <field name="date" required="1" readonly="state != 'Draft'"/>
                            <field name="from_company_id" required="1" readonly="state != 'Draft'"  options="{'no_create':1,'no_create_edit':1}" domain="[('id','!=',company_id)]"/>
                            <field name="company_id" required="1" readonly="1" force_save="1" options="{'no_create':1,'no_create_edit':1}"/>
                            <field name="user_id" readonly="1" options="{'no_create':1,'no_create_edit':1}"/>
                        </group>

                        <group>
                            <field name="po_id" readonly="state != 'Draft'" options="{'no_create_edit':1,'no_create':1}" domain="[('company_id','=',from_company_id),('state','in',('purchase','done'))]"/>
                            <button name="load_po_lines" string="Load Purchase Lines" type="object" class="oe_highlight" invisible="state !='Draft' or not po_id"/>
                            <field name="remarks" readonly="state != 'Draft'"/>
                            <field name="transfer_picking_ids" readonly="1" invisible="1" force_save="1"/>
                        </group>
                    </group>

                    <!-- LINES SECTION -->
                    <notebook>
                        <page string="Transfer Lines" invisible="po_id">
                            <field name="line_ids" 
                                readonly="state != 'Draft'"
                                nolabel="1">
                                
                                <list editable="bottom">
                                    <field name="product_id" required="1" options="{'no_create':1,'no_create_edit':1}"/>
                                    <field name="qty" required="1"/>
                                    <field name="price_unit" force_save="1"/>
                                    <field name="transfer_picking_id" readonly="1" column_invisible="1" force_save="1"/>
                                    <field name="receive_picking_id" readonly="1" column_invisible="1" force_save="1"/>
                                    <field name="state" readonly="1" column_invisible="1" force_save="1"/>
                                </list>

                            </field>
                        </page>
                        <page string="Transfer Lines" invisible="not po_id">
                            <field name="line_ids" 
                                readonly="state != 'Draft'"
                                nolabel="1">
                                
                                <list create="0">
                                    <field name="product_id" required="1" options="{'no_create':1,'no_create_edit':1}" readonly="1" force_save="1"/>
                                    <field name="qty" required="1"/>
                                    <field name="price_unit"/>
                                    <field name="transfer_picking_id" readonly="1" column_invisible="1" force_save="1"/>
                                    <field name="receive_picking_id" readonly="1" column_invisible="1" force_save="1"/>
                                    <field name="state" readonly="1" column_invisible="1" force_save="1"/>
                                </list>

                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_od_intercompany_transfer" model="ir.actions.act_window">
        <field name="name">Intercompany Transfers</field>
        <field name="res_model">od.intercompany.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
