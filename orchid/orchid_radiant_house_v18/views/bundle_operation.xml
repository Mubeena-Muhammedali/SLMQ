<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record model="ir.ui.view" id="nn_bundle_retail_list">
        <field name="name">n2n.bundle.list.view</field>
        <field name="model">n2n.bundle</field>
        <field name="arch" type="xml">
            <list  default_order="id desc" string="Bundle" >
                <field name="name"/>
                <field name="bundle_date"/>
                <field name="bundle_type"/>
                <field name="state"/>
            </list>
       </field>
    </record>



    <record model="ir.ui.view" id="nn_bundle_retail_form">
        <field name="name">n2n.bundle.form.view</field>
        <field name="model">n2n.bundle</field>
        <field name="arch" type="xml">
            <form string="Bundle">

               <header>
                    <button name="compute_cost_for_items" string="Compute" type="object" class="oe_right oe_highlight" invisible = "bundle_type == 'unpacking' or state in ('done','draft')"/>
                    <button name="output_transfer" string="Output Transfer" type="object" class="oe_right oe_highlight" invisible = "state in ('done','draft')"/>
                    <button name="distribute" string="Distribute" type="object" class="oe_right oe_highlight" invisible = "bundle_type == 'packing' or state in ('done','draft')"/>
                    <button name="input_transfer" string="Input Transfer" type="object" class="oe_right oe_highlight" invisible = "state in ('done','partial')"/>
                    <button name="action_force_date" string="Force Date Update" type="object" class="oe_highlight" invisible = "state in ('partial','draft')"/> 
                    <field name="state" widget="statusbar" statusbar_visible="draft,partial,done" readonly="1"/>
               </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_bundle_stock_moves"
                            class="oe_stat_button"
                            icon="fa-building-o"
                            type="object"
                            invisible="state != 'done'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">StockMove</span>
                            </div>
                        </button>
                    </div>

                    <group>
                       <group>
                            <field name="name" />
                            <field name="bundle_date" readonly = "state in ('done','partial')" required="1"/>
                            <field name="location_id" readonly="state =='done'"/>
                            <field name="force_date"/>
                       </group>
                         
                    <group>
                        <field name="document_date" readonly="1" force_save="1"/>
                        <field name="bundle_type"  readonly = "1" force_save="1"/>
                        <field name="bundle_loc_id" readonly = "1" force_save="1"/>
                        <field name="journal_id" readonly = "1" force_save="1"/>
                    </group>
                    </group>
                    <group>
                        <separator string="Output Product (s)" colspan="4"/>    <field name="bundle_pack_line" nolabel="1" readonly="state =='done'">
                            <list string="Pack" editable="bottom">
                                <field name="product_id" options="{'no_create': True, 'no_create_edit':True}" readonly = "state in ('done','partial')"/>
                                <field name="lot_id"  context="{'product_id': product_id,'location_id':parent.location_id}" readonly = "state in ('done','partial')"/>
                                <field name="quantity" readonly = "state in ('done','partial')"/>
                                <field name="price"/>
                                <field name="sub_total" sum="total"/>
                                <field name="state"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer oe_right" colspan="2" name="Total">
                            <field name="pack_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </group>

                        <!-- <group colspan="4">
                          <group>
                                <button name="compute_cost_for_items" string="Compute" type="object" class="oe_right oe_highlight" invisible = "bundle_type == 'unpacking' or state in ('done','draft')"/> 
                          </group>
                          <group>
                                <button name="output_transfer" string="Output Transfer" type="object" class="oe_right oe_highlight" invisible = "state in ('done','draft')"/> 
                          </group>
                        </group>
                        <group colspan="4">
                                <button name="distribute" string="Distribute" type="object" class="oe_right oe_highlight" invisible = "bundle_type == 'packing' or state in ('done','draft')"/>     
                        </group> -->
                    </group>
                    <group>
                        <group>
                            <separator string="Input Product (s)"/>
                        </group>
                    </group> 
                    <group>
                        <field name="bundle_unpack_line" nolabel="1" readonly="state =='done'">
                            <list string="Items" editable="bottom">
                                <field name="product_id" options="{'no_create': True, 'no_create_edit':True}" readonly = "state in ('done','partial')"/>
                                <field name="lot_id" context="{'product_id': product_id,'location_id':parent.location_id}" readonly="state !='draft'" />
                                 <field name="available_qty" readonly = "state in ('done','partial')"/>
                                <field name="quantity" readonly = "state in ('done','partial')"/>
                                <field name="price" readonly="0"/>
                                <field name="sub_total" sum="Total"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="Total">
                        <field name="unpack_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                    </group>

                    <!-- <group>
                        <button name="input_transfer" string="Input Transfer" type="object" class="oe_right oe_highlight" invisible = "state in ('done','partial')"/>
                    </group> -->
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- <record id="view_bundle_operation_filter" model="ir.ui.view">
        <field name="name">bundle.operation.select</field>
        <field name="model">n2n.bundle</field>
        <field name="arch" type="xml">
            <search string="Search Bundle Operation">
                <filter name="name" string="Bundle operation"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Bundle Date" domain="[]" context="{'group_by':'bundle_date'}"/>
                    <filter string="Operation" domain="[]" context="{'group_by':'bundle_type'}"/>
                    <filter string="Status" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record> -->


    <record model="ir.actions.act_window" id="action_nn_bundle_retail">
        <field name="name">Bundle Operation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">n2n.bundle</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="view_bundle_operation_filter"/> -->
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add new Bundle Operations. 
            </p>
        </field>
    </record>
  <menuitem id="menu_bundle" name="Bundle Packing Operation" action="action_nn_bundle_retail" parent="stock.menu_stock_warehouse_mgmt" sequence="38"/>
  
 </data>
</odoo>





































