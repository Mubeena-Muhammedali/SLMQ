<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="od_inventory_adjustment_view_form" model="ir.ui.view">
            <field name="name">od.inventory.adjustment.form</field>
            <field name="model">od.inventory.adjustment</field>
            <field name="arch" type="xml">    
                <form string="Inventory Adjustment">
                    <header>
                        <button name="create_adjustment" string="Create Adjustment" invisible="state != 'draft'" type="object" class="oe_highlight" />
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <h1 class="oe_title">
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="date" required="1" readonly="state != 'draft'"/>
                                <field name="location_id" required="1" readonly="state != 'draft'"/>
                                <!-- <field name="account_id" required="0" readonly="state != 'draft'"/> -->
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="remarks"/>
                                <field name="user_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="data_file" readonly=" state != 'draft' " filename="file_name" widget="binary"/>
                                <field name="file_name" invisible="1"/>
                                <button name="upload_data" string="Upload" type="object" class="oe_highlight" invisible="data_file == False or state != 'draft'" />
                            </group>
                        </group>
                        <notebook>
                            <page name="product_page" string="Products">
                                <field name="line_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="tracking" readonly="1" force_save="1" column_invisible="1"/>
                                        <field name="product_id" required="1"/>
                                        <field name="lot_id" column_invisible="1"  readonly="tracking not in ['serial', 'lot']" context="{'default_product_id': product_id}" force_save="1"/>
                                         <field name="on_hand_qty" readonly="1" force_save="1"/>
                                        <field name="counted_qty"/>
                                        <field name="differnce_qty" force_save="1" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="od_inventory_adjustment_view_list" model="ir.ui.view">
            <field name="name">od.inventory.adjustment.list</field>
            <field name="model">od.inventory.adjustment</field>
            <field name="arch" type="xml">    
                <list string="Inventory Adjustment" default_order="id desc">
                    <field name="date"/> 
                    <field name="name"/> 
                    <field name="user_id"/> 
                    <field name="state"/>
                </list>
            </field>
        </record>
        
        <record id="action_od_inventory_adjustment" model="ir.actions.act_window">
            <field name="name">Inventory Adjustment</field>
            <field name="res_model">od.inventory.adjustment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="od_inventory_adjustment_view_list"/>
        </record>

        <menuitem 
            id="menu_od_inventory_adjustment"
            name="Inventory Adjustment"
            parent="stock.menu_stock_adjustments"
            sequence="2"
            action="action_od_inventory_adjustment"/>
    </data>
</odoo>

