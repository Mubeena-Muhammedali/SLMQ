<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="orchid_issue_raw_materials_list">
            <field name="name">orchid.issue.raw.materials.list.view</field>
            <field name="model">orchid.issue.raw.materials</field>
            <field name="arch" type="xml">
                <list string="Issue Raw Materials" default_order="id desc">
                    <field name="name"/>
                    <field name="mo_id" invisible="0"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="orchid_issue_raw_materials_form">
            <field name="name">orchid.issue.raw.materials.form.view</field>
            <field name="model">orchid.issue.raw.materials</field>
            <field name="arch" type="xml">
                <form string="Issue Raw Materials">
                    <header>
                        <button name="confirm_issue_qty" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="receive_materials" string="Receive Materials" type="object" class="oe_highlight" invisible="state != 'confirm'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <!-- <field name="state" invisible="1"/> -->
                                <field name="product_id"/>
                                <field name="mo_id" invisible="0"/>
                            </group>
                        </group>
                        <group>
                            <field name="raw_material_line" nolabel="1" readonly="state == 'confirm'">
                                <list string="Raw Materials" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom"/>
                                    <field name="product_uom2"/>
                                    <field name="planned"/>
                                    <field name="issued"/>
                                    <field name="returned"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_orchid_issue_raw_materials">
            <field name="name">Issue Raw Materials</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orchid.issue.raw.materials</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
	            Click to add new Bundle Operations. 
                </p>
            </field>
        </record>

        <record id="od_mrp_production_inhrting_from_raw_material" model="ir.ui.view">
            <field name="name">mrp.production</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <button name="button_mark_done" position="before">
                    <field name="od_material_issued" force_save="1" invisible="1"/>
                    <button name="od_issue_materials" type="object" string="Issue Raw Materials" class="oe_highlight" invisible="od_material_issued"/>
                </button>
                <xpath expr="/form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list/field[@name='quantity']" position="after">
                    <field name="od_issued" readonly="1" force_save="1"/>
                    <field name="od_returned" readonly="1" force_save="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
	
