<?xml version="1.0"?>
<odoo>
    <data>
        <record id="sale_order_tree_inherit" model="ir.ui.view">
            <field name="name">od.sale.order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <field name="invoice_status" position="after">
                    <field name="od_production_status" force_save="1" readonly="1"/>
                </field>
                <field name="invoice_status" position="before">
                    <field name="od_total_cost" force_save="1" readonly="1"/>
                    <field name="od_margin" force_save="1" readonly="1"/>
                </field>
            </field>
        </record>

        <!-- Inherit Sale Order Form View -->
        <record id="view_order_form_inherit" model="ir.ui.view">
            <field name="name">od.sale.order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Show MO Created Flag -->
                <field name="user_id" position="after">
                    <field name="od_mo_created" readonly="1" force_save="1"/>
                    <field name="od_analytic_account_id" readonly="1"/>
                </field>

                <!-- Additional Buttons -->
                <button name="action_confirm" position="before">

                    <button name="od_action_create_mo" string="Create MO" type="object" class="oe_highlight"
                            invisible="state in ('draft','cancel') or od_mo_created"/>
                </button>

                <!-- Customer Order Before Quantity -->
                <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                    <field name="od_customer_order"/>
                    <field name="od_customer_uom_id" domain="[('id','in',(1,31,32,5,28))]" options="{'no_create':1,'no_create_edit':1}"/>
                    <field name="od_create_mo" force_save="1" optional="show" readonly="od_mrp_ids or qty_delivered"/>
                </xpath>

                <!-- Quantity On hand After Quantity -->
                <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                    <field name="od_qty_on_hand" readonly="1" force_save="1"/>
                </xpath>

                <!-- Additional Line Fields -->
                <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                    <field name="od_cost" readonly="1" force_save="1" optional="hide" digits="[12,4]"/>
                    <field name="od_total_cost" readonly="1" force_save="1" optional="hide" digits="[12,4]"/>
                    <field name="od_margin" readonly="1" force_save="1" optional="hide"/>
                    <field name="od_mrp_ids" widget="many2many_tags" force_save="1" optional="hide"/>
                </xpath>

                <!-- Last Price After UoM -->
                <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_uom']" position="after">
                    <field name="od_last_price" optional="hide"/>
                </xpath>
                <field name="client_order_ref" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="commitment_date" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="payment_term_id" position="after">
                    <field name="client_order_ref" string="LPO NUmber"/>
                    <field name="od_lpo_date"/>
                    <field name="commitment_date"/>
                    <field name="od_print_without_price"/>
                    <field name="od_margin" readonly="1" force_save="1"/>
                </field>
                <xpath expr="//notebook/page/field[@name='order_line']/list" position="inside">
                    <field name="od_proof_request_ids" widget="many2many_tags" column_invisible="1"/>
                    <button name="od_create_proof_request" string="Create Proof Request" type="object" invisible="od_proof_request_ids or od_mrp_ids or (not od_create_mo)"/>
                    <button name="od_view_proof_request" string="View Proof Request" type="object" invisible="not od_proof_request_ids"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
