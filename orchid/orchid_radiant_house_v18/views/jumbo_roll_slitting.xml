<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="orchid_jumboroll_slitting_list">
	        <field name="name">orchid.jumboroll.slitting.list.view</field>
	        <field name="model">orchid.jumboroll.slitting</field>
	        <field name="arch" type="xml">
	            <list string="Jumbo Roll Slitting" >
	                <field name="date"/>
	                <field name="name"/>
	                <field name="location_id"/>
	                <field name="state"/>
	            </list>
	       </field>
	    </record>

        <record model="ir.ui.view" id="orchid_jumboroll_slitting_form">
	        <field name="name">orchid.jumboroll.slitting.form.view</field>
	        <field name="model">orchid.jumboroll.slitting</field>
	        <field name="arch" type="xml">
	            <form string="Jumbo Roll Slitting">
	                <header>
	                  <field name="state" widget="statusbar" statusbar_visible="draft,done" readonly="1"/>
	                </header>
	            	<sheet>
	            		<div class="oe_button_box" name="button_box">
		                    <button name="action_get_slitting_stock_moves"
		                        class="oe_stat_button"
		                        icon="fa-building-o"
		                        type="object"
		                        invisible="state != 'done'">
		                        <div class="o_form_field o_stat_info">
		                            <span class="o_stat_text">StockMove</span>
		                        </div>
		                    </button> 
	                  	</div>

	            		<div class="oe_title">
	                        <h1><field name="name" class="oe_inline"/></h1>
	                    </div>
	                	<group>
	                  		<group>
	                        	<field name="location_id" />
	                  		</group>
		                  	<group>
						       <field name="date" />
						       <field name="company_id" force_save="1" invisible="1"/>
		                  </group>
	                  	</group>

	                  	<group>
	                        <separator string="Output Product (s)" colspan="4"/>
                            <field name="output_line" nolabel="1" readonly="state in ('done','partial')">
                                <list string="Output" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="price" readonly="1" force_save="1"/>
                                    <field name="sub_total" sum="total" force_save="1"/>
                                    <field name="company_id" force_save="1" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="Total">
	                            <field name="output_qty_total" class="oe_subtotal_footer_separator" widget="monetary"/>
	                        </group>
	                        <group>
		                       
	                          	<group>
                                	<button name="output_transfer" string="Output Transfer" type="object" class="oe_right oe_highlight" invisible="state in ('done','draft')"/> 
	                          	</group>
	                        </group>
                       	</group>
                        
                        <group>
                        	<separator string="Input Product (s)" colspan="4"/>
                            <field name="input_line" nolabel="1" readonly="state in ('done','partial')">
                                <list string="Items" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                 	<field name="available_qty" readonly="1" force_save="1"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="price" readonly="1" force_save="1"/>
                                    <field name="sub_total" sum="Total" force_save="1"/>
                                    <field name="company_id" force_save="1" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="Total">
                                <field name="input_qty_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                            <group>
                                <button name="input_transfer" string="Input Transfer" type="object" class="oe_right oe_highlight" invisible="state in ('done','partial')"/>
                            </group>
                        </group>
		           	</sheet>
		       </form>
		    </field>
	  	</record>

        <record model="ir.actions.act_window" id="action_orchid_jumboroll_slitting">
	        <field name="name">Jumbo Roll Slitting</field>
	        <field name="type">ir.actions.act_window</field>
	        <field name="res_model">orchid.jumboroll.slitting</field>
	        <field name="view_mode">list,form</field>
         	<field name="help" type="html">
	          <p class="oe_view_nocontent_create">
	            Click to add new Bundle Operations. 
	          </p>
	        </field>
	    </record>
		
		  <!-- movelinesview -->
		<record model="ir.actions.act_window" id="od_action_jumboroll_moves">
            <field name="name">Inventory Moves</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.move.line</field>
            <field name="view_mode">list,form</field>
        </record> 

    </data>
</odoo>