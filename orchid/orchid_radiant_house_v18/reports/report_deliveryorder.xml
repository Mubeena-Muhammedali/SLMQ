<odoo>
    <template id="report_deliveryorder_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="row">
                        <div class="col-xs-6 text-center">
                            <h3>Delivery Order</h3>
                        </div>
                    </div>

                    <table class="table table-bordered" style="width:100%; border-collapse: collapse; margin-top: 20px;">
                        <tr>
                            <td style="width:60%">
                                <strong>Customer</strong><br/>
                                <t t-if="o.partner_id">
                                    <strong><t t-esc="o.partner_id.name"/></strong><br/>
                                    
                                    <!-- Street and Street2 -->
                                    <t t-if="o.partner_id.street">
                                        <t t-esc="o.partner_id.street"/>
                                        <t t-if="o.partner_id.street2">, <t t-esc="o.partner_id.street2"/></t>
                                        <br/>
                                    </t>
                                    <t t-elif="o.partner_id.street2">
                                        <t t-esc="o.partner_id.street2"/><br/>
                                    </t>

                                    <!-- City, State, Zip -->
                                    <t t-if="o.partner_id.city">
                                        <t t-esc="o.partner_id.city"/>
                                        <t t-if="o.partner_id.state_id">, <t t-esc="o.partner_id.state_id.name"/></t>
                                        <t t-if="o.partner_id.zip">, <t t-esc="o.partner_id.zip"/></t>
                                        <br/>
                                    </t>
                                    <t t-elif="o.partner_id.state_id or o.partner_id.zip">
                                        <t t-if="o.partner_id.state_id"><t t-esc="o.partner_id.state_id.name"/></t>
                                        <t t-if="o.partner_id.zip">, <t t-esc="o.partner_id.zip"/></t>
                                        <br/>
                                    </t>

                                    <!-- Country -->
                                    <t t-if="o.partner_id.country_id">
                                        <t t-esc="o.partner_id.country_id.name"/><br/>
                                    </t>

                                    <!-- Phone / Mobile -->
                                    <t t-if="o.partner_id.phone">
                                        <t t-esc="o.partner_id.phone"/><br/>
                                    </t>
                                    <t t-if="o.partner_id.mobile">
                                        <t t-esc="o.partner_id.mobile"/><br/>
                                    </t>
                                </t>
                                <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping">
                                    TRN: <span t-field="o.partner_id.vat"/>
                                </div>

                            </td>
                            <td style="width:13%;border-right:1px solid white;">
                                <strong>No.</strong><br/>
                                <strong>Date</strong><br/>
                                <strong>LPO No.</strong><br/>
                                <strong>Pmt. Term</strong><br/>
                                <!-- <strong>Salesman</strong> -->
                            </td>
                            <td style="width:27%">
                                :&#160;<span t-field="o.name"/><br/>
                                :&#160;<span t-field="o.scheduled_date"/><br/>
                                :&#160;<span t-field="o.sale_id.client_order_ref"/><br/>
                                :&#160;<span t-field="o.sale_id.payment_term_id.name"/><br/>
                                <!-- :&#160;<span t-field="o.sale_id.user_id.name"/> -->
                            </td>
                        </tr>
                    </table>

                    <table style="width:100%; border-collapse: collapse; border:0;">
                        <thead style="background-color:#f2f2f2; font-size:11px; font-weight:bold;">
                            <tr>
                                <th class="text-start" style="border:0; padding:8px 4px;"><strong>S No.</strong></th>
                                <th class="text-start" style="border:0; padding:8px 4px;"><strong>Item Code</strong></th>
                                <th class="text-start" style="border:0; padding:8px 4px;"><strong>Description</strong></th>
                                <th class="text-end text-nowrap" style="border:0; padding:8px 4px;"><strong>Quantity</strong></th>
                                <th class="text-end text-nowrap" style="border:0; padding:8px 4px;"><strong>Unit Price</strong></th>
                                <th class="text-end" style="border:0; padding:8px 4px;"><strong>Taxes</strong></th>
                                <th class="text-end" style="border:0; padding:8px 4px;"><strong>Amount</strong></th>
                            </tr>
                        </thead>

                        <tbody>
                            <tbody>
                                <t t-set="counter" t-value="1"/>
                                <t t-foreach="o.move_ids_without_package" t-as="line">
                                    <tr>
                                        <td style="padding:8px 4px;">
                                            <span t-esc="counter"/>
                                        </td>
                                        <td style="padding:8px 4px;">
                                            <span t-esc="line.product_id.default_code or ''"/>
                                        </td>
                                        <td style="padding:8px 4px;">
                                            <span t-esc="line.product_id.name"/>
                                        </td>
                                        <td class="text-end" style="padding:8px 4px;">
                                            <!-- <span t-esc="'%.2f' % line.product_uom_qty"/> -->
                                            <span t-esc="'%.2f' % line.quantity"/>
                                        </td>
                                        <td class="text-end" style="padding:8px 4px;">
                                            <span t-esc="'%.2f' % line.price_unit"/>
                                        </td>
                                        <td class="text-end" style="padding:8px 4px;">
                                            <!-- <span t-esc="'%.2f' % (line.product_uom_qty * line.price_unit)"/> -->
                                            <span t-esc="'%.2f' % (line.quantity * line.price_unit)"/>
                                        </td>
                                        <td class="text-end" style="padding:8px 4px;">
                                            <span t-esc="''"/>
                                        </td>
                                    </tr>
                                    <t t-set="counter" t-value="counter + 1"/>
                                </t>
                            </tbody>

                        </tbody>
                    </table>
                    <br/>
                    <p>
                        <strong>Remarks:</strong><br/>
                        <field name="o.note"/>
                    </p>

                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <div class="row">
                        <div class="col-6">
                            <strong>Customer's Signature</strong>
                        </div>
                        <div class="col-5 col-offset-1" style="text-align:right;">
                            <strong><span t-field="o.company_id"/></strong><br/>
                            <strong>Authorized Signatory</strong>
                        </div>
                    </div><br/>
                    Received in good conditions.
                </div>
            </t>
        </t>
    </template>

    <template id="report_deliveryorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="orchid_radiant_house_v18.report_deliveryorder_document"/>
            </t>
        </t>
    </template>
</odoo>