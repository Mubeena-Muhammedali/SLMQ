<odoo>
    <template id="report_packinglist_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="row">
                        <div class="col-xs-6 text-center">
                            <h3>Packing List</h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    <table class="table table-condensed table-bordered">
                        <tr>
                            <td>
                                <strong>Customer</strong>
                            </td>
                            <td colspan="3">
                                <span t-field="o.partner_id"/>
                            </td>
                        </tr>

                        <tr >
                            <td>
                                <strong>Packing List</strong>
                            </td>
                            <td>
                                <span t-field="o.name"/>
                            </td>
                            <td>
                                <strong>Job No</strong>
                            </td>
                            <td>
                                <span t-field="o.origin"/>
                            </td>
                        </tr>

                        <tr >
                            <td>
                                <strong>Date</strong>
                            </td>
                            <td>
                                <span t-field="o.date"/>
                            </td>
                            <td>
                                <strong>Sales Order</strong>
                            </td>
                            <td>
                                <span t-field="o.origin"/>
                            </td>
                        </tr>
                    </table>

                    <br/>
                    <br/>
                    <t t-set="grouped" t-value="o.od_get_grouped_packing_lines()"/>
                    <table class="table table-sm table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th style="width:20%"><strong>Product</strong></th>
                                <th style="width:10%"><strong>Pallet No</strong></th>
                                <th style="width:10%"><strong>Carton No</strong></th>
                                <th style="width:10%"><strong>No. of CRTN</strong></th>
                                <th style="width:10%"><strong>Label/Roll</strong></th>
                                <th style="width:10%"><strong>Roll/Carton</strong></th>
                                <th style="width:10%"><strong>Labels/Carton</strong></th>
                                <th style="width:10%"><strong>Gross Weight</strong></th>
                                <th style="width:10%"><strong>Total</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grouped" t-as="group">
                                <t t-set="product" t-value="group['product']"/>
                                <t t-set="lines" t-value="group['lines']"/>
                                <t t-set="total" t-value="group['total']"/>

                                <t t-foreach="lines" t-as="l">
                                    <tr>
                                        <td style="width:20%">
                                            <t t-if="l_index == 0">
                                                <span t-field="product.display_name"/>
                                            </t>
                                        </td>
                                        <td style="width:10%;text-align:center;"><span t-field="l.pallet_no"/></td>
                                        <td style="width:10%;text-align:center;"><span t-field="l.carton_number"/></td>
                                        <td style="width:10%;text-align:center;"><t t-esc="'%.2f'%l.no_of_cartons"/></td>
                                        <td style="width:10%;text-align:center;"><t t-esc="'%.2f'%l.labels_per_reel"/></td>
                                        <td style="width:10%;text-align:center;"><t t-esc="'%.2f'%l.reels_per_carton"/></td>
                                        <td style="width:10%;text-align:center;"><t t-esc="'%.2f'%l.labels_per_carton"/></td>
                                        <td style="width:10%;text-align:center;"><t t-esc="'%.2f'%l.gross_weight"/></td>
                                        <td style="width:10%;text-align:center;"><t t-esc="'%.2f'%l.total"/></td>
                                    </tr>
                                </t>

                                <tr>
                                    <td class="text-right" colspan="8">
                                        <strong>Total</strong>
                                    </td>
                                    <td><strong><span t-esc="total"/></strong></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
    <template id="report_packinglist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="orchid_radiant_house_v18.report_packinglist_document"/>
            </t>
        </t>
    </template>
</odoo>