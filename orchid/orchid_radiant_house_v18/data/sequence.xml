<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
       <record id="seqeuence_od_product_sequence_finished_product" model="ir.sequence">
            <field name="name">Od Finished Product Sequence</field>
            <field name="code">od.product.template</field>
            <field name="prefix">FP- %(month)s/%(day)s/</field>
            <field name="padding">3</field>
        </record>

       <record id="sequence_die_cut_produc" model="ir.sequence">
            <field name="name">Die Cut Sequence</field>
            <field name="code">od.die.cut</field>
            <field name="prefix">DC/</field>
            <field name="padding">5</field>
        </record>

       <record id="sequence_plate_product" model="ir.sequence">
            <field name="name">Plate Sequence</field>
            <field name="code">od.plate</field>
            <field name="prefix">PP/</field>
            <field name="padding">5</field>
        </record>

        <record id="od_seq_sale_quotation" model="ir.sequence">
            <field name="name">Orchid Sales Quotation</field>
            <field name="code">od.sale.quotation</field>
            <field name="prefix">SQ</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seqeunce_od_customer" model="ir.sequence">
            <field name="name">Customer Sequence</field>
            <field name="code">res.partner.customer</field>
            <field name="prefix">CUST/</field>
            <field name="padding">5</field>
        </record>

        <record id="seqeunce_od_supplier" model="ir.sequence">
            <field name="name">Supplier Sequence</field>
            <field name="code">res.partner.supplier</field>
            <field name="prefix">SUPP/</field>
            <field name="padding">5</field>
        </record>

        <record id="seqeunce_od_proof_request" model="ir.sequence">
            <field name="name">Proof Request</field>
            <field name="code">od.proof.request</field>
            <field name="prefix">PF- %(month)s/%(day)s</field>
            <field name="padding">3</field>
        </record>

        <record id="seqeunce_od_plate_production" model="ir.sequence">
            <field name="name">Plate Manufacturing</field>
            <field name="code">od.plate.production</field>
            <field name="prefix">MO/Plate/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_orchid_jumboroll_slitting" model="ir.sequence">
            <field name="name">Jumbo Roll Slitting</field>
            <field name="code">orchid.jumboroll.slitting</field>
            <field name="prefix">JRS/MP/</field>
            <field name="padding">3</field>
        </record>
        
        <record id="seq_orchid_issue_raw_materials" model="ir.sequence">
            <field name="name">Issue Raw Materials</field>
            <field name="code">orchid.issue.raw.materials</field>
            <field name="prefix">IRM/MP/%(year)s/</field>
            <field eval="False" name="company_id"/>
        </record>

        <record id="seq_od_intercompany_transfer" model="ir.sequence">
            <field name="name">Inter Company Transfer</field>
            <field name="code">od.intercompany.transfer</field>
            <field name="prefix">INTC/</field>
            <field name="padding">3</field>
        </record>

        <record id="seq_nn_bundle" model="ir.sequence">
            <field name="name">Bundle</field>
            <field name="code">n2n.bundle</field>
            <field name="prefix">Bundle- %(month)s/%(day)s/</field>
            <field name="padding">3</field>
        </record>

        <record id="sequence_od_inventory_adjustment" model="ir.sequence">
            <field name="name">Inventory Adjustment</field>
            <field name="code">od.inventory.adjustment</field>
            <field name="prefix">Inventory Adjustment/</field>
            <field name="padding">3</field>
        </record>

        <record id="sequence_od_estimation" model="ir.sequence">
            <field name="name">Radiant House Estimation</field>
            <field name="code">od.estimation</field>
            <field name="prefix">EST/%(year)s/</field>
            <field name="padding">5</field>
            <field eval="False" name="company_id"/>
        </record>

    </data>
</odoo>
