<?xml version="1.0" encoding="utf-8"?>
<odoo>
   

	<record model="ir.ui.view" id="action_orchid_prepaid_report_pivot">
		<field name="name">orchid_prepaid_report_pivot</field>
		<field name="model">orchid.prepaid.report</field>
		<field name="arch" type="xml">
			<pivot string="Prepaid Analysis" disable_linking="True">
				
				<field name="account_id" type="row"/>
				<field name="debit" type="measure"/>
				
			</pivot>
		</field>
	</record>

	<record id="view_orchid_prepaid_report_search" model="ir.ui.view">
		<field name="name">orchid.prepaid.report.search</field>
		<field name="model">orchid.prepaid.report</field>
		<field name="arch" type="xml">
			<search string="Prepaid Analysis">
				   <field name="account_id"/>
				   <field name="analytic_account_id"/>
				   <field name="partner_id"/>
				   <field name="cost_center"/>
				   <field name="move_id"/>
				   <field name="journal_id"/>
				   <field name="date_start"/>
				   <field name="date_end"/>
				   <group expand="1" string="Group By">
						<filter string="Account" name="account_id" context="{'group_by':'account_id'}"/>
						<filter string="Analytic Account" name="analytic_account_id" context="{'group_by':'analytic_account_id'}"/>
						<filter string="Journal" name='journal_id' context="{'group_by':'journal_id'}"/>
						<filter string="Journal Entry" name='move_id' context="{'group_by':'move_id'}"/>
						<filter string="Partner" name='partner_id' context="{'group_by':'partner_id'}"/>
						<filter string="State" name='state' context="{'group_by':'state'}"/>
					</group>
			</search>
		</field>
	</record>

	<record model="ir.actions.act_window" id="action_orchid_prepaid_report">
		<field name="name"> Prepaid Analysis</field>
		<field name="res_model">orchid.prepaid.report</field>
		
		<field name="view_mode">pivot</field>
		<!-- <field name="search_view_id" ref="view_asset_asset_report_search"/> -->
		<!-- <field name="domain">[('asset_category_id.type', '=', 'purchase')]</field> -->
		<!-- <field name="context">{}</field> 
		<field name="help" type="html">
		</field> -->
	</record>
	
	<menuitem name="Prepaid Analysis" action="action_orchid_prepaid_report"
			  id="action_orchid_prepaid_report_menu"
			  parent="account.account_reports_management_menu" sequence="3"/>
   
</odoo>

