<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="orchid_accont_cost_center_tree_view">
            <field name="name">orchid.account.cost.center.tree</field>
            <field name="model">orchid.account.cost.center</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="tree_string">
                    <field name="name" />
                    <field name="code" />
                    <field name="seq" />
                    <field name="branch_id" />
                    <field name="div_id" />
                    <field name="div_mgr_id" />
                    <!-- <field name="target" /> -->
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="orchid_accont_cost_center_form_view">
            <field name="name">orchid.account.cost.center.form</field>
            <field name="model">orchid.account.cost.center</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <sheet>
                        <group>
                            <group>
                                <field name="code" placeholder="Code" />
                                <field name="name" placeholder="Name" />
                                <field name="seq" />
                            </group> 
                            <group> 
                            <field name="branch_id" />
                            <field name="div_id" />
                            <field name="div_mgr_id" />
                            <field name="target" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_orchid_accont_cost_center_tree_view">
            <field name="name">Account Cost Center</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orchid.account.cost.center</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="orchid_accont_cost_center_tree_view"/>
        </record>

        <menuitem id="orchid_accont_cost_center_menu" name="Cost Center" parent="account.account_account_menu" action="action_orchid_accont_cost_center_tree_view" sequence="12"/>

        <record id="view_account_journal_inherit_orchid" model="ir.ui.view">
            <field name="name">account.journla.inherit.orchid</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='account_control_ids']" position="after">
                    <field name="orchid_div_id" />
                    <field name="orchid_br_id"  />
                    <field name="orchid_cc_id"  />
                </xpath>
            </field>
        </record>

        
        <record id="view_move_form_inherited_acc_enhnacement" model="ir.ui.view">
            <field name="name">account.move.orchid</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="after">
                        <field name="orchid_cc_id" />
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>

