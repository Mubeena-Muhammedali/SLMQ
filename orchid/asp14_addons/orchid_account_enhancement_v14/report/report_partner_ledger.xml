<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_partnerledger">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="12"/>
            <t t-set="data_report_header_spacing" t-value="9"/>
            <t t-set="data_report_dpi" t-value="110"/>
            <t t-call="web.internal_layout">
                <div class="page">
                    <center><h2>Partner Ledger</h2></center><br/>
                    <div class="row">
                        <div t-if="data['form']['date_from']" class="col-3">
                            <!-- <strong>Company:</strong>
                            <p t-esc="env.company.name"/> -->
                            <!-- <t t-if="data['form']['date_from']"> -->
                                <strong>Date from :</strong>
                                <span t-esc="data['form']['date_from']"/>
                            <!-- </t> -->
                        </div>
                        <div class="col-3">
                           <!--  <t t-if="data['form']['date_from']">
                                <strong>Date from :</strong>
                                <span t-esc="data['form']['date_from']"/>
                                <br/>
                            </t> -->
                            <t t-if="data['form']['date_to']">
                                <strong>Date to :</strong>
                                <span t-esc="data['form']['date_to']"/>
                            </t>
                        </div>
                        <!-- <div class="col-3">
                            <strong>Target Moves:</strong>
                            <p t-if="data['form']['target_move'] == 'all'">All Entries</p>
                            <p t-if="data['form']['target_move'] == 'posted'">All Posted Entries</p>
                        </div> -->
                    </div>
                    <div class="row mt32">
                        <div class="col-3">
                            <strong>Currency:</strong>
                            <p t-esc="env.company.currency_id.name"/>
                        </div>
                        <div class="col-3">
                        </div>
                    </div>
                    <br/><br/>

                    <table class="table table-sm table-reports">
                        <thead>
                            <tr style="background-color:#E3E4FA">
                                <th style="width:12%;"> 
                                    <t t-if="not data['form']['summary']">Date</t>
                                    <t t-else="">Partner</t>
                                </th>
                                <!-- <th>JRNL</th> -->
                                <!-- <th>Account</th> -->
                                <!-- <th>Inv No.</th> -->
                                <th><t t-if="not data['form']['summary']">Ref</t></th>
                                <th class="text-right">Debit</th>
                                <th class="text-right">Credit</th>
                                <th class="text-right">Balance</th>
                                <!-- <th >
                                    <t t-if="not data['form']['summary']">Cumm. Bal</t>
                                    <t t-else="">Balance</t>
                                </th> -->
                                <th t-if="data['form']['amount_currency']">Currency</th>
                            </tr>
                        </thead>
                        <t t-foreach="docs" t-as="o">
                            <tbody>
                                <tr style="background-color:#F5F5DC">
                                    <td colspan="2">
                                        <strong t-esc="o.ref"/>
                                        -
                                        <strong t-esc="o.name"/>
                                    </td>
                                    <td class="text-right">
                                        <strong t-esc="'{0:,.2f}'.format(float(sum_partner(data, o, 'debit')))"/>
                                    </td>
                                    <td class="text-right">
                                        <strong t-esc="'{0:,.2f}'.format(float(sum_partner(data, o, 'credit')))"/>
                                    </td>
                                    <!-- <td class="text-right">
                                         <strong t-esc="sum_partner(data, o, 'debit - credit')"
                                                t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                    </td> -->
                                    <td class="text-right">
                                        <strong t-esc="'{0:,.2f}'.format(float(sum_partner(data, o, 'debit - credit')))"/>
                                    </td>
                                </tr>
                                <tr t-foreach="lines(data, o)" t-as="line">
                                    <td style="width:9%;">
                                        <span t-esc="line['date']"/>
                                    </td>
                                    <!-- <td>
                                        <span t-esc="line['code']"/>
                                    </td> -->
                                    <!-- <td>
                                        <span t-esc="line['a_code']"/>
                                    </td> -->
                                    <!-- <td>
                                        <span t-esc="line['inv_no']"/>
                                    </td> -->
                                    <td style="width:70%;">
                                        <span t-esc="line['displayed_name']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:,.2f}'.format(float(line['debit']))"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:,.2f}'.format(float(line['credit']))"/>
                                    </td>
                                    <!-- <td class="text-right">
                                        <span t-esc="line['balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                    </td> -->
                                    <td class="text-right">
                                        <span t-esc="'{0:,.2f}'.format(float(line['progress']))"/>
                                    </td>
                                    <td class="text-right" t-if="data['form']['amount_currency']">
                                        <t t-if="line['currency_id']">
                                            <span t-esc="line['amount_currency']"
                                                  t-options="{'widget': 'monetary', 'display_currency': line['currency_id']}"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
