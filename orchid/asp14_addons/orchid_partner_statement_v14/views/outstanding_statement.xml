<odoo>
    <template id="orchid_partner_statement_v14.outstanding_statement_document">
            <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context({'lang': lang})"/>
            <div class="page">
                <div class="oe_structure"/>
                <t t-if="d['currencies']">
                    <t t-foreach="d['currencies'].items()" t-as="currency">
                        <t t-set="display_currency" t-value="Currencies[currency[0]]"/>
                        <t t-set="currency" t-value="currency[1]"/>
                        <t t-set="partner_id" t-value="get_inv_addr(o)"/>
                        <t t-if="currency['lines']">
                            <p>
                                 <center><h5><b>STATEMENT OF ACCOUNTS</b></h5><b>As on <span t-esc="d['end']"/></b></center><br/>
                                <!-- <div id="informations" class="row mt32 mb32">
                                    <div class="col-5 bm-2">
                                        <strong>Name:</strong>
                                        <p t-esc="partner_id.name" class="m-0"/>
                                    </div>
                                    <div t-if="partner_id.vat" class="col-3 bm-2">
                                        <strong>TRN:</strong>
                                        <p t-esc="partner_id.vat" class="m-0"/>
                                    </div>
                                    <div t-if="partner_id.user_id" class="col-3 bm-2">
                                        <strong>Sales Person:</strong>
                                        <p t-esc="partner_id.user_id.name" class="m-0"/>
                                    </div>
                                    <div t-if="display_currency" class="col-2 bm-2">
                                        <strong>Currency:</strong>
                                        <p t-esc="display_currency.name" class="m-0"/>
                                    </div>
                                </div> -->
                                <table class="table table-sm" width="100%">
                                    <tbody>
                                        <tr>
                                            <td style="border-right:1px solid white;width:10%;"><b>Customer</b></td>
                                            <td style="border-right:1px solid white;width:60%;">:&#160;<b><span t-esc="partner_id.name"/></b></td>
                                            <!-- <td style="border-right:1px solid white;width:10%;"/> -->
                                            <td style="border-right:1px solid white;width:10%;"><b>TRN</b></td>
                                            <td style="width:20%;">:&#160;<b><span t-esc="partner_id.vat"/></b></td>
                                        </tr>
                                        <tr>
                                            <td style="border-right:1px solid white;width:10%;"><b>Salesperson</b></td>
                                            <td style="border-right:1px solid white;width:60%;">:&#160;<b><span t-esc="partner_id.user_id.name"/></b></td>
                                            <!-- <td style="border-right:1px solid white;width:10%;"/> -->
                                            <td style="border-right:1px solid white;width:10%;"><b>Currency</b></td>
                                            <td style="width:20%;" t-if="display_currency">:&#160;<b><span t-esc="display_currency.name"/></b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </p><br/>

                            <!-- <p>
                                    <span t-esc="'' if  account_type == 'receivable' else 'Supplier '"/>Statement up to <span t-esc="d['end']"/> in <span t-esc="display_currency.name"/>
                                </p> -->
                            <table class="table table-sm table-statement" width="100%">
                                <!-- <colgroup>
                                   <col width="7.6%"/>
                                   <col width="7.6%"/>
                                   <col width="12%"/>
                                   <col width="12%"/>
                                   <col width="12%"/>
