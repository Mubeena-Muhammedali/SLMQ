                                   <col width="25%"/>
                                   <col width="12%"/>
                                   <col width="12%"/>
                                   <col width="7.6%"/>
                                </colgroup> -->
                                <thead style="border-bottom:1px solid white;">
                                    <tr style="border-bottom:1px solid black;">
                                        <th style="font-size:13px;border-right:1px solid white;">Date</th>
                                        <th style="font-size:13px;border-right:1px solid white;">Due Date</th>
                                        <th style="font-size:13px;border-right:1px solid white;">LPO/Doc Ref.</th>
                                        <th style="font-size:13px;border-right:1px solid white;">Inv. No</th>
                                        <th style="font-size:13px;border-right:1px solid white;">Terms</th>
                                        <th style="font-size:13px;border-right:1px solid white;">Days</th>
                                        <th style="font-size:13px;border-right:1px solid white;" class="amount">Debit</th>
                                        <th style="font-size:13px;border-right:1px solid white;" class="amount">Credit</th>
                                        <th style="font-size:13px;border-right:1px solid white;" class="amount">Bal</th>
                                        <th style="font-size:13px;border-right:1px solid white;" class="amount">Cum.Bal</th>
                                        <!-- <th style="font-size:13px;border-right:1px solid white;">Chq</th>
                                        <th style="border-right:1px solid white;font-size:13px;"> </th>
                                        <th style="font-size:13px;"> </th> -->
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="font-size:13px;" t-foreach="currency['lines']" t-as="line" t-att-class="'statement-blocked' if line['blocked'] else ''">
                                        
                                        <td style="border-right:1px solid white;" width="7.6%">
                                            <span t-esc="line['date']"/>
                                        </td>
                                        <td style="border-right:1px solid white;" width="7.6%">
                                            <span t-esc="line['date_maturity']"/>
                                        </td>
                                        <td style="border-right:1px solid white;" width="7.6%">
                                            <span t-esc="line['lpo']"/>
                                        </td>
                                        <td style="border-right:1px solid white;" width="7.6%">
                                            <span t-esc="line['move_id']"/>
                                        </td>
                                        <td style="border-right:1px solid white;" width="7.6%">
                                            <span t-esc="line['payment_terms']"/>
                                        </td>
                                        <td style="border-right:1px solid white;" width="7.6%">
                                            <span t-esc="line['days']"/>
                                        </td>
                                        <td style="border-right:1px solid white;" class="amount" width="7.6%">
                                           <span t-esc="'{0:,.2f}'.format(float((line['debit'])))"/>
                                        </td>
                                        <td style="border-right:1px solid white;" class="amount" width="7.6%">
                                            <!-- take a note for payable -->
                                           <span t-esc="'{0:,.2f}'.format(float((line['credit'])))"/>
                                        </td>
                                         <td style="border-right:1px solid white;" class="amount" width="7.6%">
                                            <span t-esc="'{0:,.2f}'.format(float((line['open_amount'])))"/>
                                        </td>
                                        <td style="border-right:1px solid white;" class="amount" width="7.6%">
                                            <span t-esc="'{0:,.2f}'.format(float((line['balance'])))"/>
                                        </td>
                                        <!-- <td style="border-right:1px solid white;" width="7.6%">
                                            <t t-if="not (len(line['chq'])==0)">
                                                <t t-set="chq_no" t-value="line['chq'][0]['chq_no']"></t>
                                                <span t-esc="line['chq'][0]['chq_no']"/>
                                            </t>
                                        </td> -->
                                        <!-- <td style="border-right:1px solid white;" width="7.6%">
                                            <t t-if="not (len(line['chq'])==0)">
                                                <span t-esc="line['chq'][0]['date']"/>
                                            </t>
                                        </td> -->
                                        <!-- <td width="7.6%" class="amount">
                                            <span t-esc="'{0:,.2f}'.format(float((line['chq'][0]['amount'])))"/>
                                        </td>
                                        <t t-if="len(line['chq']) &gt; 1">
                                            <tr style="font-size:13px;" t-foreach="range(1,len(line['chq']))" t-as="cheque">
                                                
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%"/>
                                                <td style="border-right:1px solid white;" width="7.6%">
                                                    <span t-esc="line['chq'][cheque]['chq_no']"/>
                                                </td>
                                                <td style="border-right:1px solid white;" width="7.6%">
                                                    <span t-esc="line['chq'][cheque]['date']"/>
                                                </td>
                                                <td width="7.6%" class="amount">
                                                    <span t-esc="'{0:,.2f}'.format(float((line['chq'][cheque]['amount'])))"/>
                                                </td>
                                            </tr>
                                        </t>     -->
                                         
                                    </tr>
                                    <tr>
                                       <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <!-- <td style="border-right:1px solid white;border-top:1px solid black;"/> -->
                                        <td style="border-right:1px solid white;border-top:1px solid black;" colspan="3"><b>Total Outstanding</b></td>
                                        <td style="border-right:1px solid white;border-top:1px solid black;" class="amount">
                                            <b><span t-esc="'{0:,.2f}'.format(float((currency['amount_due'])))"/></b>
                                        </td>
                                        <td style="border-right:1px solid white;border-top:1px solid black;">
                                        </td>
                                        <!-- <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <td style="border-right:1px solid white;border-top:1px solid black;"/>
                                        <td style="border-top:1px solid black;"/> -->
                                    </tr>
                                </tbody>
                            </table>
                            <br/><br/>
                        </t>
                        <t t-call="orchid_partner_statement_v14.aging_buckets" t-if="currency['buckets'] and currency['lines']"/>
                    </t>
                </t>
                <p t-if="d.get('no_entries')">
                    <strong>The partner doesn't have due entries.</strong>
                </p>
            </div>
        </t>

    </template>
    <template id="outstanding_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="d" t-value="data.get(o.id)" />
                <t
                    t-call="orchid_partner_statement_v14.outstanding_statement_document"
                    t-lang="o.lang"
                />
            </t>
        </t>
    </template>
    <report
        id="action_print_outstanding_statement"
        model="res.partner"
        report_type="qweb-pdf"
        menu="False"
        string="Outstanding Statement"
        name="orchid_partner_statement_v14.outstanding_statement"
        file="orchid_partner_statement_v14.outstanding_statement"
    />
</odoo>
