<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partial_move_wizard_form" model="ir.ui.view">
        <field name="name">partial.move.wizard.form</field>
        <field name="model">partial.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Move to Account">
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="total_residual" readonly="1"/>
                    </group>
                    <group>
                        <field name="account_id"/>
                        <field name="journal_id"/>
                        <field name="amount"/>
                        <field name="label"/>
                        <field name="date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partial_move_wizard" model="ir.actions.act_window">
        <field name="name">Partial Move to Account</field>
        <field name="res_model">partial.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
