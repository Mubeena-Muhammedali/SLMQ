<odoo>
    <record id="ir_cron_daily_attendance_report" model="ir.cron">
        <field name="name"> Daily Attendance Report</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code"> model.cron_send_daily_attendance_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <!-- 11 PM -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>