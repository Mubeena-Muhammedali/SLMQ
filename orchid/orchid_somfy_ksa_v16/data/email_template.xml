<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data noupdate="0">
		<record id="purchase_notification_template" model="mail.template">
			<field name="name">Purchase Notification</field>
			<field name="subject">{{ctx['subject']}}</field>
			<field name="email_from">{{('somfy.service@somfy.com')}}</field>
			<field name="email_to">{{ctx['email_to']}}</field>
			<field name="email_cc">{{ctx['email_cc']}}</field>
			<field name="lang">{{object.partner_id.lang}}</field>
			 <field name="model_id" ref="purchase.model_purchase_order"/>
			<field name="auto_delete" eval="False"/>
			<field name="body_html" type="html">
				<div style="margin: 0px; padding: 0px;">
				    <p style="margin: 0px; padding: 0px; font-size: 13px;">
				        Dear <t t-out="ctx.get('recipient_name')"/>,
				        <p><t t-out="ctx.get('content')"/></p>
				    </p>
				    <br/><br/>
				    <a t-att-href="object.get_purchase_url()"
				        style="background-color: #875A7B; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
				        View Purchase Order
				    </a>
				 	<br/><br/><br/>
					<pre>
						Auto Generated Email
					</pre>
				</div>
				 <!-- <![CDATA[
				 	<p>
				 		Dear {{ctx['recipient_name']}} ,
				 		<p>
				 			{{ctx['content']}}
					 	</p>
				 	</p>
				 	<br/><br/>
				 		<a href="{{object.get_purchase_url()}}" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">View Purchase Order</a>
				 	<br/><br/><br/>
					<pre>
						Auto Generated Email
					</pre>
				 ]]> -->
			</field>
		</record>

