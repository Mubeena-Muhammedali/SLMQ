<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="od_external_layout_striped_inherit" inherit_id="web.external_layout_striped">
		<xpath expr="//div[@t-attf-class='o_company_#{company.id}_layout footer o_background_footer']" position="replace">
			<div t-attf-class="o_company_#{company.id}_layout footer o_background_footer">
	            <div class="text-center" style="border-top:1px solid black;">
	                <!-- <ul class="list-inline">
	                    <div t-field="company.report_footer"/>
	                </ul> -->
	                <div t-if="report_type == 'pdf'" class="text-muted" style="padding-top:0.5cm;">
	                    Page:
	                    <span class="page"/>
	                    of
	                    <span class="topage"/>
	                </div>
	            </div>
	        </div>
		</xpath>
	</template>
</odoo>