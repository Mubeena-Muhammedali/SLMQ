<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ksa_sale_order_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=lang)" />
            <div class="page" style="color:#000000;">
                <div class="oe_structure"/>
                <t t-if="doc.od_adjustment_qty_status=='need_approval'">
                    <span>Adjustment QTY not approved</span>
                </t>
                <t t-else="">
                    <div class="row">
                        <div class="col-6">
                            <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                              and doc.partner_invoice_id != doc.partner_id                              or doc.partner_shipping_id != doc.partner_invoice_id">
                                <strong t-if="doc.partner_shipping_id == doc.partner_invoice_id">Invoicing and shipping address:</strong>
                                <strong t-if="doc.partner_shipping_id != doc.partner_invoice_id">Invoicing address:</strong>
                                <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                <div t-if="doc.partner_shipping_id != doc.partner_invoice_id" class="mt8">
                                    <strong>Shipping address:</strong>
                                    <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                </div>
                            </t>
                        </div>
                        <div class="col-5 col-offset-1" style="padding-left:3cm;">
                           
                            <!-- <span>BP Code&#160;:&#160;</span><span t-field="doc.partner_id.od_ban_bp"/> -->
                            <div> 
                                <span t-field="doc.partner_id.name"/> 
                                <t t-if="doc.partner_id.street">
                                    <br/><span t-field="doc.partner_id.street"/>
                                </t>
                                <t t-if="doc.partner_id.street2">
                                    <br/><span t-field="doc.partner_id.street2"/>
                                </t>
                                <t t-if="doc.partner_id.city">
                                    <br/><span t-field="doc.partner_id.city"/>
                                </t>
                                <t t-if="doc.partner_id.state_id">
                                    <br/><span t-field="doc.partner_id.state_id"/> &#160;&#160;
                                </t>
                                <t t-if="doc.partner_id.zip">
                                   <span t-field="doc.partner_id.zip"/>
                                </t>
                                <t t-if="doc.partner_id.country_id">
                                    <br/><span t-field="doc.partner_id.country_id"/>
                                </t>
                                <t t-if="doc.partner_id.phone">
                                    <br/><span t-field="doc.partner_id.phone"/>
                                </t>
                            </div>
                            <!-- <br/> -->
                            <p t-if="doc.partner_id.vat"><t t-esc="doc.company_id.country_id.vat_label or 'TIN'"/>: <span t-field="doc.partner_id.vat"/></p>
                        </div>
                    </div>

                    <!-- <h2>
                        <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                            <span t-if="doc.state not in ['draft','sent']">Order # </span>
                            <span t-if="doc.state in ['draft','sent']">Quotation # </span>
                        </t>
                        <t t-if="env.context.get('proforma', False) or is_pro_forma">
                            <span>Pro-Forma Invoice # </span>
                        </t>
                        <span t-field="doc.name"/>
                    </h2> -->
                    <br/>
                    <span class="mt16" style="font-size:25px;">
                        <b><t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                            <span t-if="doc.state not in ['draft','sent']">Sales Order # </span>
                            <span t-if="doc.state in ['draft','sent']">Quotation # </span>
                        </t>
                        <t t-if="env.context.get('proforma', False) or is_pro_forma">
                            <span>Pro-Forma Invoice # </span>
                        </t>
                        <span t-field="doc.name"/></b>
                    </span>
                    <br/><br/>

                    <div class="row mt32 mb32" id="informations" style="border-top: 1px solid black;border-left: 1px solid black;border-right: 1px solid black;border-bottom: 1px solid black;padding-top:0.2cm;">
                        <div t-if="doc.client_order_ref" class="col-3">
                            <strong>Your Reference:</strong>
                            <p t-field="doc.client_order_ref"/>
                        </div>
                        <div t-if="doc.date_order and doc.state not in ['draft','sent']" class="col-3">
                            <strong>Date Ordered:</strong>
                            <p t-field="doc.date_order"/>
                        </div>
                        <div t-if="doc.date_order and doc.state in ['draft','sent']" class="col-3">
                            <strong>Quotation Date:</strong>
                            <p t-field="doc.date_order"/>
                        </div>
                        <div t-if="doc.user_id.name" class="col-3">
                            <strong>Salesperson:</strong>
                            <p t-field="doc.user_id"/>
                        </div>
                        <div name="payment_term" t-if="doc.payment_term_id" class="col-3">
                            <strong>Payment Terms:</strong>
                            <t t-if="doc.payment_term_id.note">
                                <br/><span t-field="doc.payment_term_id.note"/>
                            </t>
                            <t t-else="">
                                <br/><span t-field="doc.payment_term_id"/>
                            </t>

                        </div>
                        <div name="payment_term" t-if="doc.incoterm" class="col-3">
                            <strong>Delivery Terms:</strong>
                            <p t-field="doc.incoterm"/>
                        </div>
                       <!--  <div name="payment_term" t-if="doc.warehouse_id" class="col-3">
                            <strong>Delivery From:</strong>
                            <p t-field="doc.warehouse_id.name"/>
                        </div>
                        <div name="payment_term" t-if="doc.od_transportation" class="col-3">
                            <strong>Transport Mode:</strong>
                            <p t-field="doc.od_transportation"/>
                        </div> -->

                    <!-- </div> -->
                    <!-- <div class="row mt32 mb32" id="informations" style="border-bottom: 1px solid black;border-left: 1px solid black;border-right: 1px solid black;padding-top:0.2cm;"> -->
                        <div name="payment_term" t-if="doc.warehouse_id" class="col-3">
                            <strong>Delivery From:</strong>
                            <p t-field="doc.warehouse_id.name"/>
                        </div>
                        <div name="payment_term" t-if="doc.od_transportation" class="col-3">
                            <strong>Transport Mode:</strong>
                            <p t-field="doc.od_transportation"/>
                        </div>
                    </div>
                    <br/>

                    <!-- Is there a discount on at least one line? -->
                    <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>
                    <t t-set="separate_qty" t-value="False"/>
                    <t t-set="adjustment_qty" t-value="False"/>
                    <t t-set="total_incl_foc" t-value="0"/>
                    <t t-set="total_separate_only" t-value="0"/>
                    <t t-set="total_adjustment_only" t-value="0"/>
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-if="(line.product_uom_qty==0) and (not line.od_free_qty==0)">
                            <t t-set="separate_qty" t-value="True"/>
                        </t>
                    </t>
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-if="(line.product_uom_qty==0)  and (not line.od_adjustment_qty==0)">
                            <t t-set="adjustment_qty" t-value="True"/>
                        </t>
                    </t>

                    <!-- <t t-foreach="doc.order_line" t-as="page"> -->
                        <table class="table table-sm o_main_table" style="border-bottom: 1px solid black;border-top: 1px solid black;border-left: 1px solid black;border-right: 1px solid black;">
                            <thead  style="color:#000000;">
                                <tr>
                                    <!-- <th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">H.S Code</th> -->
                                    <th t-if="not doc.od_service" style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">Product Code</th>
                                    <th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">Product Description</th>
                                    <th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">Quantity</th>
                                    <t t-if="separate_qty"><th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">Free Qty</th></t>
                                    <t t-if="adjustment_qty"><th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">Adjust Qty</th></t>
                                    <th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center">Unit Price</th>
                                    <th t-if="display_discount" class="text-center" groups="product.group_discount_per_so_line" style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;">Disc.(%)</th>
                                    <!-- <th class="text-end">Taxes</th> -->
                                    <th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center" groups="account.group_show_line_subtotals_tax_excluded">Amount</th>
                                    <th style="border-right: 1px solid black;border-top: 1px solid black;border-bottom: 1px solid black;" class="text-center price_tax_included" groups="account.group_show_line_subtotals_tax_included">Total Price</th>
                                </tr>
                           </thead>
                           <tbody class="sale_tbody" style="color:#000000;">
                                <!-- <t t-foreach="page" t-as="layout_category"> -->

                                    <!-- <t t-if="layout_category_size &gt; 1 or page_size &gt; 1" groups="sale.group_sale_layout">
                                        <tr class="active">
                                            <td colspan="7" style="font-weight: bold; border-bottom: 1px solid black;">&amp;bull;
                                                <t t-esc="layout_category['name']"/>
                                            </td>
                                        </tr>
                                    </t> -->

                                    <!-- Lines associated -->
                                    <t t-foreach="doc.order_line" t-as="l">
                                        <t t-set="free_count" t-value="0"/>
                                        <t t-set="adj_count" t-value="0"/>
                                        <!-- <t t-if="not l.product_uom_qty==0"> -->

                                        <tr >
                                            <t t-set="total_incl_foc" t-value="total_incl_foc+(l.price_unit*(l.product_uom_qty+l.od_free_qty+l.od_adjustment_qty))"/>
                                            <t t-if="l.product_uom_qty==0 and (l.od_free_qty!=0 or  l.od_adjustment_qty!=0)" t-set="total_separate_only" t-value="total_separate_only+((l.price_unit)*(l.product_uom_qty+l.od_free_qty+l.od_adjustment_qty))"/>
                                            <!-- <td style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span t-field="l.product_id.orchid_hscode_id.name"/>
                                            </td> -->
                                            <td t-if="not doc.od_service" style="border-top: 1px solid black;border-right: 1px solid black;"><span t-field="l.product_id.default_code"/></td>
                                            <td style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <t t-if="not doc.od_service"><span t-field="l.product_id.name"/></t>
                                                <t t-if="doc.od_service"><span t-field="l.name"/></t>
                                            </td>
                                            <td class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span t-esc="int(l.product_uom_qty)"/>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>
                                            <td t-if="l.product_uom_qty==0 and (not l.od_free_qty==0)" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span t-esc="int(l.od_free_qty)"/>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>
                                            <td t-if="separate_qty and (not l.product_uom_qty==0)" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span>0</span>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>
                                            <td t-if="separate_qty and (l.product_uom_qty==0 and (not l.od_adjustment_qty==0) and l.od_free_qty==0)" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span>0</span>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>
                                            <td t-if="l.product_uom_qty==0 and (not l.od_adjustment_qty==0)" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span t-esc="int(l.od_adjustment_qty)"/>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>
                                            <td t-if="adjustment_qty and (not l.product_uom_qty==0)" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span>0</span>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>

                                            <td t-if="adjustment_qty and (l.product_uom_qty==0 and (not l.od_free_qty==0) and l.od_adjustment_qty==0)" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span>0</span>
                                                <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                            </td>




                                            <td class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span t-field="l.price_unit"/>
                                            </td>
                                            <td t-if="display_discount" class="text-end" groups="product.group_discount_per_so_line" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <span t-field="l.discount"/>
                                            </td>
                                           <!--  <td class="text-end">
                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                                            </td> -->
                                            <td class="text-end" groups="account.group_show_line_subtotals_tax_excluded" style="border-top: 1px solid black;border-right: 1px solid black;">
                                               <!--  <span t-field="l.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/> -->

                                                <t t-if="not l.product_uom_qty==0"><span t-field="doc.currency_id.symbol"/>&#160;<span t-esc="'{0:,.2f}'.format(float(l.price_subtotal))"/></t>
                                                <t t-if="l.product_uom_qty==0"><span>
                                                    <!-- <span t-esc="'{0:,.2f}'.format(float((line.od_free_qty+line.od_adjustment_qty)*(line.product_id.standard_price*1.1)))"/></span> commented on 6may2021-->
                                                    <span t-field="doc.currency_id.symbol"/>&#160;<span t-esc="'{0:,.2f}'.format(float((l.od_free_qty+l.od_adjustment_qty)*(l.price_unit)))"/></span>
                                                </t>
                                               
                                            </td>
                                            <td class="text-end" groups="account.group_show_line_subtotals_tax_included" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                <!-- <span t-field="l.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/> -->

                                                <t t-if="not l.product_uom_qty==0"><span t-field="doc.currency_id.symbol"/>&#160;<span t-esc="'{0:,.2f}'.format(float(l.price_total))"/></t>
                                               
                                                <t t-if="l.product_uom_qty==0"><span>
                                                    <!-- <span t-esc="'{0:,.2f}'.format(float((line.od_free_qty+line.od_adjustment_qty)*(line.product_id.standard_price*1.1)))"/></span> commented on 6may2021-->
                                                    <span t-field="doc.currency_id.symbol"/>&#160;<span t-esc="'{0:,.2f}'.format(float((l.od_free_qty+l.od_adjustment_qty)*(l.price_unit)))"/></span>
                                                </t>
                                            </td>
                                            <!-- </td> -->
                                        </tr>
                                        <!-- </t> -->
                                        <t t-set="free_count" t-value="free_count+1"/>
                                        <t t-if="free_count==1">
                                        <t t-if="(not l.od_free_qty==0 )and (not l.product_uom_qty==0)">
                                            <tr>
                                                <!-- <td style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span t-field="l.product_id.orchid_hscode_id.name"/>
                                                </td> -->
                                                <td style="border-top: 1px solid black;border-right: 1px solid black;"><span t-field="l.product_id.default_code"/></td>
                                                <td style="border-top: 1px solid black;border-right: 1px solid black;"><span t-field="l.product_id.name"/></td>
                                                <td class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span t-esc="int(l.od_free_qty)"/>
                                                    <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                                </td>
                                                <td  t-if="separate_qty" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span>0</span>
                                                    <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                                </td>
                                                <td  t-if="adjustment_qty" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span>0</span>
                                                    <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                                </td>
                                                <td   class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span>0.00</span>
                                                </td>
                                                <td t-if="display_discount" class="text-end" groups="product.group_discount_per_so_line" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span t-field="l.discount"/>
                                                </td>
                                               <!--  <td class="text-end">
                                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                                                </td> -->
                                                <td class="text-end" groups="account.group_show_line_subtotals_tax_excluded" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span>0.00</span>
                                                    <!-- <span t-field="l.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/> -->
                                                </td>
                                                <td class="text-end" groups="account.group_show_line_subtotals_tax_included" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span>0.00</span>
                                                    <!-- <span t-field="l.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/> -->
                                                </td>
                                                <t t-set="free_count" t-value="0"/>
                                            </tr>
                                        </t>
                                        </t>
                                        <t t-set="adj_count" t-value="adj_count+1"/>
                                        <t t-if="adj_count==1">
                                        <t t-if="(not l.od_adjustment_qty==0) and (not l.product_uom_qty==0)">
                                            <tr>
                                                <!-- <td style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span t-field="l.product_id.orchid_hscode_id.name"/>
                                                </td> -->
                                                <td style="border-top: 1px solid black;border-right: 1px solid black;"><span t-field="l.product_id.default_code"/></td>
                                                <td style="border-top: 1px solid black;border-right: 1px solid black;"><span t-field="l.product_id.name"/></td>
                                                <td class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span t-esc="int(l.od_adjustment_qty)"/>
                                                    <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                                </td>
                                                <td t-if="separate_qty" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                   <span>0</span>
                                                    <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                                </td>
                                                <td t-if="adjustment_qty" class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                   <span>0</span>
                                                    <!-- <span t-field="l.product_uom" groups="product.group_uom"/> -->
                                                </td>




                                                <td class="text-end" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                   <span>0.00</span>
                                                </td>
                                                <td t-if="display_discount" class="text-end" groups="product.group_discount_per_so_line" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span t-field="l.discount"/>
                                                </td>
                                               <!--  <td class="text-end">
                                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                                                </td> -->
                                                <td class="text-end" groups="account.group_show_line_subtotals_tax_excluded" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                   <span>0.00</span>
                                                    <!-- <span t-field="l.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/> -->
                                                </td>
                                                <td class="text-end" groups="account.group_show_line_subtotals_tax_included" style="border-top: 1px solid black;border-right: 1px solid black;">
                                                    <span>0.00</span>
                                                    <!-- <span t-field="l.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/> -->
                                                </td>
                                                <t t-set="adj_count" t-value="0"/>
                                            </tr>
                                        </t>
                                        </t>

                                    </t>
                            </tbody>
                        </table>

                    <div class="clearfix" name="so_total_summary">
                        <div id="total" class="row" name="total">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm">
                                    <!-- Tax totals -->
                                    <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                    <tr class="border-black o_subtotal">
                                        <td><strong>Subtotal</strong></td>
                                        <td class="text-end">
                                            <t t-if="not separate_qty and not adjustment_qty"><span t-field="doc.currency_id.symbol"/>&#160;<span t-esc="'{0:,.2f}'.format(float(doc.amount_untaxed))"/></t>

                                            <t t-if="separate_qty or adjustment_qty"><span t-field="doc.currency_id.symbol"/>&#160;<span t-esc="'{0:,.2f}'.format(float((doc.amount_untaxed+total_separate_only)))"/></t>
                                        </td>
                                    </tr>
                                    <tr style="border-bottom:1px solid #dddddd;">
                                        <td><strong>Less Discount</strong></td>
                                        <td class="text-end">
