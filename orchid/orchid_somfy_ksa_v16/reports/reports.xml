<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_commercial_invoice" model="ir.actions.report">
            <field name="name">Commercial Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">orchid_somfy_ksa_v16.report_commercial_invoice</field>
            <field name="report_file">orchid_somfy_ksa_v16.report_commercial_invoice</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Commercial Invoice - %s - %s' % (object.partner_id.name or '', object.name)</field>
        </record>
        <record id="action_report_ksa_sale_order" model="ir.actions.report">
            <field name="name">Quotation Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">orchid_somfy_ksa_v16.report_ksa_sale_order</field>
            <field name="report_file">orchid_somfy_ksa_v16.report_ksa_sale_order</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        </record>
        <record id="action_report_grn" model="ir.actions.report">
            <field name="name">Goods Receipt Note</field>
            <field name="model">orchid.grn.no</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">orchid_somfy_ksa_v16.report_grn</field>
            <field name="report_file">orchid_somfy_ksa_v16.report_grn</field>
            <field name="binding_model_id" ref="orchid_somfy_ksa_v16.model_orchid_grn_no"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Goods Receipt Note'</field>
        </record>
