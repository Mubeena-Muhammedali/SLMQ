<?xml version="1.0"?>
<odoo>
    <record id="view_od_landed_cost_analysis_pivot" model="ir.ui.view">
        <field name="name">od.landed.cost.analysis.pivot</field>
        <field name="model">od.landed.cost.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Landed Cost Analysis">
                <field name="product_id" type="row"/>
                <field name="product_cost" type="measure"/>
                <field name="landed_cost" type="measure"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_od_landed_cost_analysis" model="ir.actions.act_window">
        <field name="name">Landed Cost Analysis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">od.landed.cost.analysis</field>
        <field name="view_mode">pivot</field>
    </record>
    <menuitem action="action_od_landed_cost_analysis" id="menu_od_landed_cost_analysis" parent="stock.menu_warehouse_report" name="Landed Cost Analysis" sequence="2" />
</odoo>
