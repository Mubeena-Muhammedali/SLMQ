									<left><span t-field="l.product_id"/><br/>
								    <!-- <span t-field="l.product_id.orchid_arabic"/> -->
								    </left>
								</td>
								<td style="border-right:1px solid black;border-top:1px solid black;background-color:#FFFFFF;">
									<center><span t-field="l.orchid_country_id"/><br/>
									<!-- <span t-field="l.orchid_country_id.od_arabic_name"/> -->
								</center>
								</td>
								<td style="border-right:1px solid black;text-align:center;border-top:1px solid black;background-color:#FFFFFF;">
									<span t-esc="int(qty)"/>
								</td>
								<!-- <t t-if="((o.od_warehouse_id.id == 1) or (o.od_warranty_marketing_id))"> -->
								<td style="border-right:1px solid black;text-align:center;border-top:1px solid black;background-color:#FFFFFF;">
									<span t-esc="'{0:,.2f}'.format(float(l.od_gross_weight))"/>
								</td>
								<!-- </t> -->
								<td style="border-right:1px solid black;text-align:right;border-top:1px solid black;background-color:#FFFFFF;">
									<span t-esc="'{0:,.2f}'.format(float(unit_price))"/>
									<!-- Note:the unit price reset as per previous calculations as shaffaf suggested. becoz the new calculation was set for a special case(not known) dated 20may2020 -->
									<!-- as per zia's request unit price is taken from line directly as the previous calculation does not give the correct unit price as per the line -->
									<!-- <span t-field="l.price_unit"/> -->
								</td>
								<td style="border-right:1px solid black;text-align:right;border-top:1px solid black;background-color:#FFFFFF;">
									<!-- <span t-esc="'{0:,.2f}'.format(float(l.price_subtotal))"/> -->
									<span t-esc="'{0:,.2f}'.format(float(new_total))"/>
								</td>
							</tr>
						</t>
						<t t-if="separate_qty or adjustment_qty">
							<tr  t-foreach="o.invoice_line_ids" t-as="l">
								<t t-set="qty" t-value="0"/>
								<!-- <t t-set="unit_price" t-value="0"/> -->
								<!-- <t t-set="punit" t-esc="punit.update({l.product_id.default_code: new_total})"/> -->
								<t t-if="l.quantity!=0" t-set="qty" t-value="qty+l.quantity+l.od_free_qty+l.od_adjustment_qty"/>
								<t t-set="price_tax" t-value="(l.price_total-l.price_subtotal)"/>
								<!-- changed as the client need same unit price for the same products with foc  -->
								<!-- <t t-set="unit_price" t-value="unit_price+(l.price_subtotal/qty)"/> -->
								<t t-if="l.quantity!=0" t-set="unit_price" t-value="ptotal[l.product_id.default_code]/pqty[l.product_id.default_code]"/>
								<t t-if="l.quantity!=0" t-set="new_total" t-value="unit_price*qty"/>
								<t t-if="l.quantity!=0" t-set="grand_total" t-value="grand_total+new_total"/>
