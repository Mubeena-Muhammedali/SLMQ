							<th style="width:11%;border-right:1px solid black;color:#666666;"><center><b>Gross Weight</b></center></th>
							<!-- </t> -->
							<th style="width:12%;border-right:1px solid black;color:#666666;"><center><b>Unit Price <br/>EUR</b></center></th>
							<th style="width:12.5%;color:#666666;"><center><b>Amount <br/>EUR</b></center></th>
