					<tbody style="border-top: 1px solid white;">
						<t t-set="ptotal" t-value="{}"/>
						<t t-set="pqty" t-value="{}"/>
						<!-- <t t-set="punit" t-value="dict()"/> -->
						<!-- <t t-foreach="o.invoice_line_ids" t-as="l">
							<t t-if="l.quantity!=0" t-set="pqty" t-esc="pqty.update({l.product_id.default_code: 0})"/>
							<t t-if="l.quantity!=0" t-set="ptotal" t-esc="ptotal.update({l.product_id.default_code: 0})"/>
						</t> -->
						<t t-foreach="o.invoice_line_ids" t-as="l">
							<t t-if="l.quantity!=0"><t t-foreach="[l.product_id.default_code]" t-as="key">
								<t t-esc="pqty.update({key:0})"/>
								<t t-esc="ptotal.update({key:0})"/>
							</t></t>
						</t>

						<t t-foreach="o.invoice_line_ids" t-as="l">
								<t t-if="l.quantity!=0" t-set="new_qty" t-value="pqty[l.product_id.default_code]+(l.quantity+l.od_free_qty+l.od_adjustment_qty)"/>

							<!-- <t t-if="l.quantity!=0" t-set="pqty" t-esc="pqty.update({l.product_id.default_code: new_qty})"/>
								<t t-if="l.quantity!=0" t-set="new_total" t-value="ptotal[l.product_id.default_code]+(l.price_total)"/>

							<t t-if="l.quantity!=0" t-set="ptotal" t-esc="ptotal.update({l.product_id.default_code: new_total})"/> -->
							<t t-if="l.quantity!=0"><t t-foreach="[l.product_id.default_code]" t-as="key">
								<t t-esc="pqty.update({key:new_qty})"/>
								<t t-set="new_total" t-value="ptotal[l.product_id.default_code]+(l.price_total)"/>
								<t t-esc="ptotal.update({key:new_total})"/>
							</t></t>

						</t>

						<t t-set="grand_total" t-value="0"/>
						<t t-set="tax_total" t-value="0"/>
						<t t-set="untaxed_total" t-value="0"/>
						<t t-if="not separate_qty and not adjustment_qty">
							<tr  t-foreach="o.invoice_line_ids" t-as="l">
								<t t-set="qty" t-value="0"/>
								<t t-set="qty" t-value="qty+l.quantity+l.od_free_qty+l.od_adjustment_qty"/>
								<!-- changed as the client need same unit price for the same products with foc  -->
								<!-- <t t-set="unit_price" t-value="unit_price+(l.price_subtotal/qty)"/> -->
								<t t-set="unit_price" t-value="ptotal[l.product_id.default_code]/pqty[l.product_id.default_code]"/>
								<t t-set="price_tax" t-value="(l.price_total-l.price_subtotal)"/>
								<t t-set="new_total" t-value="unit_price*qty"/>
								<t t-set="grand_total" t-value="grand_total+new_total"/>
								<t t-set="tax_total" t-value="tax_total+price_tax"/>
								<t t-set="untaxed_total" t-value="(grand_total-tax_total)"/>

								<td style="border-right:1px solid black;border-top:1px solid black;background-color:#FFFFFF;">
									<center><span t-field="l.product_id.orchid_hscode_id"/></center>
								</td>
								<td style="border-right:1px solid black;border-top:1px solid black;background-color:#FFFFFF;">
									<center><span t-field="l.product_id.default_code"/></center>
								</td>
