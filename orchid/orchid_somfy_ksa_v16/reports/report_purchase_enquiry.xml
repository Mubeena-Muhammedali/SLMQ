<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="od_report_purchaseenquiry_document">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <t t-set="address">
            <strong>Supplier:</strong>
            <div t-field="o.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
        </t>
        <div class="page">
            <div class="oe_structure"/>

            <div class="mt-4">
                <h2>Purchase Enquiry #<span t-field="o.name"/></h2>
            </div>

            <div id="informations" class="row mt-4 mb32">
                <div t-if="o.user_id" class="col-3 bm-2">
                    <strong>Purchase Representative:</strong>
                    <p t-field="o.user_id" class="m-0"/>
                </div>
                <div t-if="o.purchase_reference" class="col-3 bm-2">
                    <strong>Purchase Reference:</strong>
                    <p t-field="o.purchase_reference" class="m-0"/>
                </div>
                <div t-elif="o.date" class="col-3 bm-2">
                    <strong >Order Date:</strong>
                    <p t-field="o.date" class="m-0"/>
                </div>
            </div>

            <table class="table table-sm o_main_table mt-4">
                <thead>
                    <tr>
                        <th name="th_od_code" style="text-align:left;width:15%;"><strong>Product Code</strong></th>
                        <th name="th_description" style="text-align:left;width:33%;"><strong>Description</strong></th>
                        <th name="th_quantity" style="text-align:right;width:10%;" class="text-end"><strong>Qty</strong></th>
                        <th name="th_price_unit" style="text-align:right;width:10%;" class="text-end"><strong>Unit Price</strong></th>
                        <th name="th_amount" style="text-align:right;width:10%;" class="text-end"><strong>Amount</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="total_qty" t-value="0"/>
                    <t t-set="amt" t-value="0"/>
                    <t t-foreach="o.line_ids" t-as="line">
                        <tr>
                            <t t-set="amt" t-value="amt+float(line.quantity*line.price_unit)"/>
                            <td id="od_product_code">
                                <span t-field="line.product_id.default_code"/>
                            </td>
                            <td id="product">
                                <span t-field="line.product_id.name"/>
                            </td>
                            <td class="text-end">
                                <t t-esc="'{0:,.2f}'.format(float(line.quantity))"/>
                                <t t-set="total_qty" t-value="float(total_qty)+float(line.quantity)"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-end">
                                <t t-esc="'{0:,.2f}'.format(float(line.quantity*line.price_unit))"/>
                            </td>
                        </tr>
                    </t>
                    <tr>
                        <td colspan="3" class="is-subtotal text-end">
                            <b><t t-esc="'{0:,.2f}'.format(float(total_qty))"/></b>
                        </td>
                        <td/>
                        <td class="is-subtotal text-end">
                            <b><t t-esc="'{0:,.2f}'.format(float(amt))"/></b>
                        </td>
                    </tr>
                </tbody>
            </table>
            <br/><br/><br/><br/>
            <center><b>“This is a system generated confirmed P.O. does not require signature”</b></center>
            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="od_report_purchaseenquiry">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="orchid_somfy_ksa_v16.od_report_purchaseenquiry_document"/>
        </t>
    </t>
</template>
</odoo>
