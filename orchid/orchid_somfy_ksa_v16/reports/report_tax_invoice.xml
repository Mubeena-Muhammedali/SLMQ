<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_tax_invoice_document">
	<t t-call="web.external_layout">
    	<t t-set="o" t-value="o.with_context(lang=lang)" />
    	<div class="page">
    		<center><b style="font-size:25px;">TAX INVOICE</b></center><br/>
    		<center><b style="font-size:22px;"><span t-field="o.name"/></b></center><br/>
    		<t t-set="exchange_rate" t-value="o.od_get_exchange_rate()"/>
    		<!-- <t t-if="o.amount_tax"><t t-set="exchange_rate" t-value="(o.amount_tax_signed/o.amount_tax)"/></t> -->
    		<table class="table table-condensed" style="width:100%;border: 1px solid black;">
				<thead style="border-bottom: 1px solid white;">
					<!-- <tr> -->
						<th style="width:45%;border-right: 1px solid white;"></th>
						<th style="width:20%;border-right: 1px solid white;"></th>
						<th style="width:35%;"></th>
					<!-- </tr> -->
				</thead>
				<tbody style="border-top: 1px solid white;background-color:#FFFFFF;">
					<tr>
						<td style="text-align:left;border-top: 1px solid white;border-right: 1px solid white;background-color:#FFFFFF;">
							<b>Seller</b><br/>
                            <div>
                            	SOMFY SAUDI ARABIA Co. L.L.C<br/>
                            	444 Building, 2nd floor, Office 12<br/>
                            	KING ABDUL AZIZ RD, 21312<br/>
                            	JEDDAH<br/>
                            	SAUDI ARABIA<br/>
                            	TEL:(966)126077265<br/>
                            	<b>VAT REG No. 310353868200003</b><br/>
                            	<b>CR No. 4030313521</b>
                            </div>

                            <div>
                            	ﺳﻮﻣﻔﻲ اﻟﻤﻤﻠﻜﺔ اﻟﻌﺮﺑﻴﺔ اﻟﺴﻌﻮدﻳﺔ<br/>

								ﻣﺮﻛﺰ املكيس<br/>

								اﻟﻄﺎﺑﻖ اﻟﺜﺎﻧﻲ ﻣﻜﺘﺐ رقم 12<br/>

								طريق اﻟﻤﻠﻚ ﻋﺒﺪ اﻟﻌﺰﻳﺰ<br/>

								حي الشاطىئ 3<br/>

								ﺟﺪة - اﻟﻤﻤﻠﻜﺔ اﻟﻌﺮﺑﻴﺔ اﻟﺴﻌﻮدﻳﺔ<br/>

                            </div>
                        </td>
                        <td style="border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"></td>
                        <td style="text-align:left;border-top: 1px solid white;background-color:#FFFFFF;">
                        	<b>Buyer</b><br/>
                            <div style="text-transform:uppercase;">
                            	<span t-field="o.partner_shipping_id"/>
                            	<t t-if="o.partner_shipping_id.street">
                            		<br/><span t-field="o.partner_shipping_id.street"/>
                            	</t>
                            	<t t-if="o.partner_shipping_id.street2">
                            		<br/><span t-field="o.partner_shipping_id.street2"/>
                            	</t>
                            	<t t-if="o.partner_shipping_id.city">
									<br/><span t-field="o.partner_shipping_id.city"/>
								</t>
								<t t-if="o.partner_shipping_id.state_id">
									<br/><span t-field="o.partner_shipping_id.state_id"/>&#160;&#160;
								</t>
								<t t-if="o.partner_shipping_id.zip">
									<span t-field="o.partner_shipping_id.zip"/>
								</t>
								<t t-if="o.partner_shipping_id.country_id">
									<br/><span t-field="o.partner_shipping_id.country_id"/>
								</t>
							</div>
                        </td>
					</tr>
					<tr>
						<td style="border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">
							<table>
								<tbody>
									<tr>
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"><b>Incoterm ICC 2022</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">: <span t-field="o.invoice_incoterm_id"/></td>
									</tr>
									<tr>
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"><b>Transportation</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">: <span t-field="o.od_transportation"/></td>
									</tr>
									<tr>
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"><b>Forwarder</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">: <span t-field="o.od_forwarder"/></td>
									</tr>
									<tr>
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"><b>Quotaion No.</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">: <span t-field="o.invoice_origin"/></td>
									</tr>
									<!-- <t t-if="not o.od_warehouse_id.id == 2"> -->
									<tr>
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"><b>Exchange Rates</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">: 
											<span>EUR 1 =&#160;<t t-out="'{0:,.4f}'.format(float(exchange_rate))"/>&#160;(As declared by Central Bank of Saudi Arabia as on &#160;<span t-field="o.invoice_date"/>&#160;)</span>
										</td>
									</tr>
									<!-- </t> -->
									<tr>
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"><b>Packing List No.</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;">: 
									<t t-if="o.od_packing_list_no"><span t-field="o.od_packing_list_no"/></t><t t-if="not o.od_packing_list_no"> A-<span t-field="o.name"/></t></td>
									</tr>
									<tr>
										<!-- <td><b>شروط الدفع<br/>Terms of Payment</b></td> -->
										<td style="width:40%;border-left: 1px solid white;border-right: 1px solid white;border-top: 1px solid white;border-bottom: 1px solid white;background-color:#FFFFFF;"><b>Terms of Payment</b></td>
										<td style="width:60%;border-right: 1px solid white;border-top: 1px solid white;border-bottom: 1px solid white;background-color:#FFFFFF;">: <span t-field="o.invoice_payment_term_id.note"/></td>
									</tr>
								</tbody>
							</table>

						</td>
						<td style="border-right: 1px solid white;border-top: 1px solid white;background-color:#FFFFFF;"></td>
						<td style="border-top: 1px solid white;background-color:#FFFFFF;">
							<b>Date</b> :&#160;<span t-field="o.invoice_date"/><br/>
							<b>Salesperson</b> :&#160;<span t-field="o.user_id"/>
						</td>
					</tr>
				</tbody>
			</table>
			<t t-set="non_service_amt" t-value="0"/>
			<t t-set="non_service_tax_amt" t-value="0"/>
			<t t-set="non_service_net_amt" t-value="0"/>
			<table class="table table-condensed" style="border:1px solid black;">
				<thead>
					<th>H.S Code</th>
					<th>Product Code</th>
					<th>Description</th>
					<th>Qty</th>
					<th>Unit Price</th>
					<th>Amount</th>
					<th>VAT Rate %</th>
					<th>VAT Amount</th>
					<th>Total Amount</th>
				</thead>
				<tbody>
					<t t-foreach="o.invoice_line_ids.filtered(lambda x:x.product_id.type!='service')" t-as="l">
						<t t-set="tax_rate" t-value="0"/>
						<t t-foreach="l.tax_ids"  t-as="tax">
							<t t-set="tax_rate" t-value="tax_rate+tax.amount"/>
						</t>
						<tr>
							<td style="background-color:#FFFFFF;"><span t-field="l.product_id.orchid_hscode_id"/></td>
							<td style="background-color:#FFFFFF;"><span t-field="l.product_id.default_code"/></td>
							<td style="background-color:#FFFFFF;"><span t-field="l.name"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><span t-out="int(l.quantity)"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><span t-field="l.price_unit"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><span t-field="l.price_subtotal"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><span t-out="int(tax_rate)"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><span t-out="'{0:,.2f}'.format(float((l.price_total-l.price_subtotal)))"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><span t-field="l.price_total"/></td>
							<t t-set="non_service_amt" t-value="non_service_amt+l.price_subtotal"/>
							<t t-set="non_service_tax_amt" t-value="non_service_tax_amt+(l.price_total-l.price_subtotal)"/>
							<t t-set="non_service_net_amt" t-value="non_service_net_amt+l.price_total"/>
						</tr>
					</t>
					<tr>
						<td style="background-color:#FFFFFF;"></td>
						<td style="background-color:#FFFFFF;"></td>
						<!-- <td style="background-color:#FFFFFF;"></td> -->
						<td style="background-color:#FFFFFF;text-align:right;" colspan="3"><span>Subtotal</span></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float(non_service_amt))"/></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float(non_service_tax_amt))"/></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float(non_service_net_amt))"/></b></td>
					</tr>
					<t t-foreach="o.invoice_line_ids.filtered(lambda x:x.product_id.type=='service')" t-as="l">
						<t t-set="tax_rate" t-value="0"/>
						<t t-foreach="l.tax_ids"  t-as="tax">
							<t t-set="tax_rate" t-value="tax_rate+tax.amount"/>
						</t>
						<tr>
							<td style="background-color:#FFFFFF;"></td>
							<td style="background-color:#FFFFFF;"></td>
							<!-- <td style="background-color:#FFFFFF;"></td> -->
							<td style="background-color:#FFFFFF;text-align:right;" colspan="3"><span t-field="l.name"/></td>
							<td style="background-color:#FFFFFF;text-align:right;"><b><span t-field="l.price_subtotal"/></b></td>
							<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="int(tax_rate)"/></b></td>
							<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float((l.price_total-l.price_subtotal)))"/></b></td>
							<td style="background-color:#FFFFFF;text-align:right;"><b><span t-field="l.price_total"/></b></td>
							<t t-set="non_service_amt" t-value="non_service_amt+l.price_subtotal"/>
							<t t-set="non_service_tax_amt" t-value="non_service_tax_amt+(l.price_total-l.price_subtotal)"/>
							<t t-set="non_service_net_amt" t-value="non_service_net_amt+l.price_total"/>
						</tr>
					</t>
					<tr>
						<td style="background-color:#FFFFFF;"></td>
						<td style="background-color:#FFFFFF;"></td>
						<!-- <td style="background-color:#FFFFFF;"></td> -->
						<td style="background-color:#FFFFFF;text-align:right;" colspan="3"><b><span>Total</span></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float(non_service_amt))"/></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float(non_service_tax_amt))"/></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-out="'{0:,.2f}'.format(float(non_service_net_amt))"/></b></td>
					</tr>
					<tr>
						<td style="background-color:#FFFFFF;"></td>
						<td style="background-color:#FFFFFF;"></td>
						<td style="background-color:#FFFFFF;text-align:right;" colspan="5"><b><span>VAT AMOUNT IN SAUDI RIYAL</span></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"><b><span t-field="o.amount_tax_signed"/></b></td>
						<td style="background-color:#FFFFFF;text-align:right;"></td>
					</tr>
				</tbody>
			</table>
			<div class="row">
				<span>Total Payable Amount in Words :&#160;<span t-out="o.currency_id.amount_to_text(o.amount_total)"/></span>
			</div>
			<div class="row">
				<span>Total Payable Amount in Words :&#160;<span t-out="o.company_id.currency_id.amount_to_text(o.amount_total_signed)"/></span>
			</div>
    	</div>
    </t>
</template>

<template id="report_tax_invoice">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="lang" t-value="o.partner_id.lang"/>
            <t t-call="orchid_somfy_ksa_v16.report_tax_invoice_document" t-lang="lang"/>
        </t>
    </t>
</template>
</odoo>