<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<template id="report_asset_statement">
	        <t t-call="web.html_container">
            	<t t-foreach="docs" t-as="o">
                	<t t-call="web.external_layout">
                    	<div class="page">
	            			<div class="oe_structure"/>
							<div class="row"> 
								<div class="row;text-center" style="background-color:#1E90FF">
									<t t-if="not filters.get('od_cost_center')">
										<b><center><h3 style="font-color:white;"> CATEGORY ASSET REPORT <span t-esc="filters.get('date_from').strftime('%d/%m/%Y')"/> To <span t-esc="filters.get('date_to').strftime('%d/%m/%Y')"/></h3></center></b>
									</t>
								</div>
							</div>

							<div class="row"> 
			                  	<div class="col-6"> </div>            
			                  	<div class="col-6" style="text-align:left;padding-left:10cm;">
			                    	<div>
				                        <t t-if="filters.get('od_report_level') == 'running'">
				                           <b>STATUS : RUNNING</b>
				                        </t>

				                        <t t-if="filters.get('od_report_level') == 'dispose'">
				                           <b>STATUS : DISPOSED</b>
				                        </t>

				                        <t t-if="filters.get('od_report_level') == 'depreciation'">
				                           <b>STATUS : DISPOSED WITH DEPRECIATION</b>
				                        </t>
				                        <t t-if="filters.get('od_report_level') == 'running_dispose'">
				                           <b>STATUS : RUNNING &amp; DISPOSED</b>
				                        </t>
				                        <br/>
				                        <t t-if="not filters.get('od_cost_center') and not filters.get('od_check_cost_center') ">
				                           <b>COST CENTER : All</b>
				                        </t>
				                        <!-- <t t-if="filters.get('od_cost_center') and not filters.get('od_check_cost_center')">
				                           <b>COST CENTER :<span t-esc="get_cost_center_by_id(filters.get('od_cost_center'])"/></b>
				                        </t> -->
				                        <br/>
				                        <t t-if="not filters.get('category_ids')">
				                           <b>CATEGORY : All</b><br/>
				                        </t>
				                        <t t-if="filters.get('category_ids')">
				                           <b>CATEGORY :<span t-esc="get_category_ids(filters.get('category_ids'))"/></b><br/>
				                        </t>
				                    </div>
				                </div>
				            </div>

				            <div>
								<t t-set="net_open_bal_cost" t-value="0"/>
								<t t-set="net_addition_cost" t-value="0"/>
								<t t-set="net_deletion_cost" t-value="0"/>
								<t t-set="net_balance_cost" t-value="0"/>

								<t t-set="net_open_bal_depr" t-value="0"/>
								<t t-set="net_addition_depr" t-value="0"/>
								<t t-set="net_deletion_depr" t-value="0"/>
								<t t-set="net_balance_depr" t-value="0"/>

								<t t-set="net_nbv" t-value="0"/>

				               	<t t-if="not filters.get('od_check_cost_center')">
				                  	<t t-foreach="filters.get('category_ids')" t-as="category_id">
				                        <h3>
				                           <t style="font-color:#1E90FF" t-esc="get_category_by_id(category_id)"/>
				                        </h3>
										<t t-set="tot_open_bal_cost" t-value="0"/>
										<t t-set="tot_addition_cost" t-value="0"/>
										<t t-set="tot_deletion_cost" t-value="0"/>
										<t t-set="tot_balance_cost" t-value="0"/>

										<t t-set="tot_open_bal_depr" t-value="0"/>
										<t t-set="tot_addition_depr" t-value="0"/>
										<t t-set="tot_deletion_depr" t-value="0"/>
										<t t-set="tot_balance_depr" t-value="0"/>

										<t t-set="tot_nbv" t-value="0"/>

				                    	<table class="table table-condensed">
				                        	<thead style="background-color:#ECF2E9">
					                           	<tr>
													<th/>
													<th/>
													<th/>
													<th colspan="4" class="text-center" style="color:black;text-align:center;border-bottom:1px solid black;border-top:1px solid black"><b>ASSET</b></th>
													<th colspan="4" class="text-center" style="color:black;text-align:center;border-bottom:1px solid black;border-top:1px solid black;"><b>DEPRECIATION</b></th>
													<th class="text-center" style="color:black;text-align:center;border-top:1px solid black;"><b>NBV</b></th>
					                           	</tr>
					                           	<tr>
					                              	<th colspan="2" style="color:black;text-align:center;border-bottom:1px;solid black;width:25%"><b>ASSET DESCRIPTION</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:10%"><b>PURCHASE DATE</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>OPENING BAL</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>ADDITION</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>DELETION</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>BALANCE</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>OPENING BAL</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>ADDITION</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>DELETION</b>
													</th>
													<th style="color:black;text-align:center;border-bottom:1px;solid black;width:8.3%"><b>BALANCE</b>
													</th>
													<th>
													</th>
					                           </tr>
					                        </thead>

				                        	<tbody>
				                           		<t t-foreach="get_asset_by_category(category_id, filters)" t-as="asset">
					                              	<t t-if="not (asset.x_studio_purchase_date &gt;= filters.get('date_from') and asset.x_studio_purchase_date &lt;= filters.get('date_to'))">
														<t t-set="open_bal_cost" t-value="asset.x_studio_purchase_value"/>
														<t t-set="addition_cost" t-value="0.00"/>
														<t t-set="tot_open_bal_cost" t-value="tot_open_bal_cost+open_bal_cost"/>
					                              	</t>
					                              	<t t-if="(asset.x_studio_purchase_date &gt;= filters.get('date_from') and asset.x_studio_purchase_date &lt;= filters.get('date_to'))">
														<t t-set="open_bal_cost" t-value="0.00"/>
														<t t-set="addition_cost" t-value="asset.x_studio_purchase_value"/>
														<t t-set="tot_addition_cost" t-value="tot_addition_cost+addition_cost"/>
					                              	</t>
					                              
													<t t-set="deletion_cost" t-value="0.00"/>
													<t t-set="tot_deletion_cost" t-value="tot_deletion_cost+deletion_cost"/>
													<t t-set="balance_cost" t-value="open_bal_cost+addition_cost"/>
													<t t-set="tot_balance_cost" t-value="tot_balance_cost+balance_cost"/>

													<t t-set="open_bal_depr" t-value="get_open_bal_depr(asset,filters)"/>

													<t t-set="tot_open_bal_depr" t-value="tot_open_bal_depr+open_bal_depr"/>

													<t t-set="addition_depr" t-value="get_depreciation_values(asset,filters,open_bal_depr)"/>
													<t t-set="tot_addition_depr" t-value="tot_addition_depr+addition_depr"/>
													<t t-set="deletion_depr" t-value="0"/>
													<t t-set="tot_deletion_depr" t-value="tot_deletion_depr+deletion_depr"/>
					                              
													<t t-set="balance_depr" t-value="open_bal_depr+addition_depr"/>
													<t t-set="tot_balance_depr" t-value="tot_balance_depr+balance_depr"/>

													<t t-set="nbv" t-value="balance_cost-balance_depr"/>
													<t t-set="tot_nbv" t-value="tot_nbv+nbv"/>

					                              	<tr style="padding-top:1cm">
														<td style="text-align:left;">
															<t t-if="asset.x_studio_code"><span t-esc="asset.x_studio_code"/></t>
														</td>
														<td style="text-align:left;"><span t-field="asset.name"/></td>
														<td style="text-align:left;"><span t-field="asset.x_studio_purchase_date"/></td>
														<td style="text-align:right;"><span t-esc="open_bal_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="addition_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="deletion_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="balance_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td> 
														<td style="text-align:right;"><span t-esc="open_bal_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="addition_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="deletion_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="balance_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
														<td style="text-align:right;"><span t-esc="nbv" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></td>
													</tr>
												</t>
												<t t-set="net_open_bal_cost" t-value="net_open_bal_cost+tot_open_bal_cost"/>
												<t t-set="net_addition_cost" t-value="net_addition_cost+tot_addition_cost"/>
												<t t-set="net_deletion_cost" t-value="net_deletion_cost+tot_deletion_cost"/>
												<t t-set="net_balance_cost" t-value="net_balance_cost+tot_balance_cost"/>

												<t t-set="net_open_bal_depr" t-value="net_balance_depr+tot_open_bal_depr"/>
												<t t-set="net_addition_depr" t-value="net_addition_depr+tot_addition_depr"/>
												<t t-set="net_deletion_depr" t-value="net_deletion_depr+tot_deletion_depr"/>
												<t t-set="net_balance_depr" t-value="net_balance_depr+tot_balance_depr"/>

												<t t-set="net_nbv" t-value="net_nbv+tot_nbv"/>

												<tr style="page-break-after:avoid;">
													<td colspan="3" style="color:black;text-align:left;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="get_category_by_id(category_id)"/><br/>TOTAL</strong></td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_open_bal_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_addition_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_deletion_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_balance_cost" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_open_bal_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_addition_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_deletion_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_balance_depr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
													<td class="text-right" style="text-align:right;color:black;border-bottom:1px solid black;border-top:1px solid black"><strong><span t-esc="tot_nbv" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency_id}"/></strong>
													</td>
				                           		</tr>
				                        	</tbody>
				                     	</table>
				                     	<br/>
				                  	</t>
				               	</t>

				               	<table class="table table-condensed" style="page-break-before:avoid; page-break-after:avoid;">
			                    	<tbody>
				                        <tr style="page-break-inside:avoid; page-break-before:avoid; page-break-after:avoid;">
				                           <!-- <td style="text-align:left;color:black;border-bottom:1px solid black;width:25%;"> -->
				                           	<td style="text-align:left;color:black;border-bottom:1px solid black;width:35%;">
				                            	<strong>Grand Total</strong>
				                           	</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%;">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_open_bal_cost))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_addition_cost))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_deletion_cost))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_balance_cost))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_open_bal_depr))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_addition_depr))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_deletion_depr))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_balance_depr))"/></strong>
											</td>
											<td style="text-align:right;color:black;border-bottom:1px solid black;width:8.3%">
												<strong><span t-esc="'{0:,.2f}'.format(float(net_nbv))"/></strong>
											</td>
				                        </tr>
			                     	</tbody>
			                  	</table>


				            </div>


















						</div>
					</t>
				</t>
			</t>
		</template>
	</data>
</odoo>
						
						