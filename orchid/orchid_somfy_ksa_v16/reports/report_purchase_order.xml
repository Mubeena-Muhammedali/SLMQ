<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="od_report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
	<xpath expr="//t[@t-set='address']/div" position="before">
		<strong>Supplier:</strong>
	</xpath>
	<xpath expr="//div[@id='informations']" position="inside">
		<div t-if="o.origin" class="col-3 bm-2">
            <strong>Sale Order Ref:</strong>
            <p t-field="o.origin" class="m-0"/>
        </div>
        <div t-if="o.payment_term_id" class="col-3 bm-2">
            <strong>Payment Terms:</strong>
            <p t-field="o.payment_term_id.note" class="m-0"/>
        </div>
        <!-- <div t-if="o.od_transportation" class="col-3 bm-2">
            <strong>Mode of Transport:</strong>
            <p t-field="o.od_transportation" class="m-0"/>
        </div> -->
	</xpath>
	<xpath expr="//th[@name='th_description']" position="attributes">
		<attribute name="style">text-align:left;width:33%;</attribute>
	</xpath>
	<xpath expr="//th[@name='th_taxes']" position="attributes">
		<attribute name="style">text-align:left;width:10%;</attribute>
	</xpath>
	<xpath expr="//th[@name='th_date_req']" position="attributes">
		<attribute name="style">text-align:center;width:12%;</attribute>
	</xpath>
	<xpath expr="//th[@name='th_quantity']" position="attributes">
		<attribute name="style">text-align:right;width:10%;</attribute>
	</xpath>
	<xpath expr="//th[@name='th_price_unit']" position="attributes">
		<attribute name="style">text-align:right;width:10%;</attribute>
	</xpath>
	<xpath expr="//th[@name='th_amount']" position="attributes">
		<attribute name="style">text-align:right;width:10%;</attribute>
	</xpath>
	

	<xpath expr="//th[@name='th_description']" position="before">
		<th name="th_od_code" style="text-align:left;width:15%;"><strong>Product Code</strong></th>
	</xpath>
	<xpath expr="//td[@id='product']" position="before">
		<td id="od_product_code">
            <span t-field="line.product_id.default_code"/>
        </td>
	</xpath>
	<xpath expr="//td[@id='product']/span" position="replace">
        <span t-field="line.product_id.name"/>
	</xpath>
	<xpath expr="//span[@t-field='line.product_uom.name']" position="replace"/>
	<xpath expr="//span[@t-field='line.date_planned']" position="attributes">
		<attribute name="t-options">{&quot;widget&quot;: &quot;date&quot;}</attribute>
	</xpath>
	<!-- <xpath expr="//div[hasclass('page')]" position="inside">
		<br/><br/>
	    <div class="row">
	        <div class="col-9"/>
	        <div class="col-3">
	            <t t-if="o.print_stamp">
	                <t t-foreach="o.company_id.header_image" t-as="images">
	                    <t t-if="images.name == 'stamp'">
	                        <img t-if="images.img" t-att-src="'data:image/png;base64,%s' % to_text(images.img)" style="height: 50px;width: 70%;"/>
	                    </t>
	                    <t t-if="images.name == 'sign'">
	                        <img t-if="images.img" t-att-src="'data:image/png;base64,%s' % to_text(images.img)" style="height: 30px;width: 50%;"/>
	                    </t>
	                </t><br/>
	                <b style="text-align:right;background-color:#FFFFFF;color:#000000;">Signature &amp; Stamp</b>
	            </t>
	        </div>
	    </div>
	</xpath> -->
	<xpath expr="//p[@t-field='o.notes']" position="after">
	    <br/><br/><br/><br/>
	    <center><b>“This is a system generated confirmed P.O. does not require signature”</b></center>
	</xpath>

</template>

