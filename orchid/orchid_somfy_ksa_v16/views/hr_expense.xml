        <record id="view_hr_expense_sheet_form" model="ir.ui.view">
            <field name="name">hr.expense.sheet.form.inherit</field>
            <field name="model">hr.expense.sheet</field>
            <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='expenses']/field[@name='expense_line_ids']/tree/field[@name='tax_ids']" position="before">
                    <field name="attachment_ids" widget="many2many_binary"/> 
                    <field name="od_tax_apply"/>
                </xpath>
                    <field name="attachment_ids" widget="many2many_binary"/> 
                <xpath expr="//page[@name='expenses']/field[@name='expense_line_ids']/tree/field[@name='total_amount_company']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//page[@name='expenses']/field[@name='expense_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <field name="accounting_date" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', 'in', ['post', 'done'])]}</attribute>
                </field>
                <button name="action_sheet_move_create" position="attributes">
                    <attribute name="invisible">1</attribute>
                </button>
                <button name="action_register_payment" position="attributes">
                    <attribute name="invisible">1</attribute>
                </button>
                <button name="action_unpost" position="attributes">
                    <attribute name="invisible">1</attribute>
                </button>
            </field>
        </record>
