<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="od_seq_hr_expense" model="ir.sequence">
            <field name="name">Expense</field>
            <field name="code">od.hr.expense</field>
            <field name="prefix">EXP/</field>
            <field name="padding">3</field>
        </record>
    </data>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.expense</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="85"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='hr_expense']/div[hasclass('o_settings_container')][2]" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"></div>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Income Account</span>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div class="text-muted">
                                Default income account for expenses paid by employees.
                            </div>
                            <div class="row mt8">
                                <field name="od_expense_account_id"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"></div>
                        <div class="o_setting_right_pane">
                            
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
