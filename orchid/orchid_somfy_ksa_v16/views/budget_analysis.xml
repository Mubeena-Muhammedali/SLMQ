                </xpath>
                <xpath expr="//form/sheet/notebook/page[1]/field[@name='od_budget_line']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>