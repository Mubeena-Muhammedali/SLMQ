<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_user_form_inher_gulf" model="ir.ui.view">
      <field name="name">res.users.form.inher</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form"/>
      <field name="arch" type="xml">
        <data>
          <xpath expr="//div[@class='oe_title']/group[1]" position="inside">
            <field name="od_reporting_manger_id" options="{'no_create': True, 'no_create_edit':True}" domain="['|',('active','=',False),('active','=',True)]"/>
            <field name="od_final_code"/>
          </xpath>
        </data>
      </field>
    </record>
  </data>
</odoo>