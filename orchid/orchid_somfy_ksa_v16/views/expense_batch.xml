<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_od_expense_batch" model="ir.sequence">
            <field name="name">OD Expense Batch</field>
            <field name="code">od.expense.batch</field>
            <field name="prefix">EB/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- ===================================================== -->
    <!-- TREE VIEW -->
    <!-- ===================================================== -->

    <record id="view_od_expense_batch_tree" model="ir.ui.view">
        <field name="name">od.expense.batch.tree</field>
        <field name="model">od.expense.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" invisible="1"/>
                <field name="state"/>
                <field name="provision_move_id" invisible="1"/>
                <field name="payment_move_id" invisible="1"/>
            </tree>
        </field>
    </record>


