<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="od_inventory_adjustment_view_form" model="ir.ui.view">
            <field name="name">od.inventory.adjustment.form</field>
            <field name="model">od.inventory.adjustment</field>
            <field name="arch" type="xml">    
                <form string="Inventory Adjustment">
                    <header>
                        <button name="button_done" string="Create Adjustment" states="submit" type="object" class="oe_highlight" />
                        <button name="button_submit" string="Submit" states="draft" type="object" class="oe_highlight" />
                        <button name="button_reset_to_draft" string="Reset to draft" states="submit" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <h1 class="oe_title">
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="date" required="1" attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="location_id" required="1" attrs="{'readonly': [('state', '!=','draft')]}" domain="[('usage','=','internal')]"/>
                                <field name="account_id" required="0" attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="remarks"/>
                                <field name="user_id" attrs="{'readonly': [('state', '!=','draft')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="product_page" string="Products">
                                <field name="line_ids" attrs="{'readonly': [('state', '!=','draft')]}">
                                    <tree editable="bottom">
                                        <field name="tracking" readonly="1" force_save="1" invisible="1"/>
                                        <field name="product_id" required="1"/>
                                        <field name="lot_id" attrs="{'readonly': [('tracking', 'not in',('serial', 'lot'))]}" context="{'default_product_id': product_id}" force_save="1"/>
                                         <field name="on_hand_qty" readonly="1" force_save="1"/>
                                        <field name="counted_qty"/>
                                        <field name="differnce_qty" force_save="1" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="od_inventory_adjustment_view_list" model="ir.ui.view">
            <field name="name">od.inventory.adjustment.list</field>
            <field name="model">od.inventory.adjustment</field>
            <field name="arch" type="xml">    
                <tree string="Inventory Adjustment" default_order="id desc">
                    <field name="date"/> 
                    <field name="name"/> 
                    <field name="user_id"/> 
                    <field name="state"/>
                </tree>
            </field>
        </record>
        
        <record id="action_od_inventory_adjustment" model="ir.actions.act_window">
            <field name="name">Inventory Adjustment</field>
            <field name="res_model">od.inventory.adjustment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_inventory_adjustment_view_list"/>
        </record>
    </data>
</odoo>

