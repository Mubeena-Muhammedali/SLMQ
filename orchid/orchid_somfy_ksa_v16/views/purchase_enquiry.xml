<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="purchase_order_tree_inher" model="ir.ui.view">
            <field name="name">purchase.order.inher</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <field name="invoice_status" position="after">
                    <field name="enquiry_ids" force_save="1" widget="many2many_tags"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="od_purchase_enquiry_tree_view">
            <field name="name">od.purchase.enquiry.tree</field>
            <field name="model">od.purchase.enquiry</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="tree_string">
                    <header>
                        <button name="action_create_po" type="object" string="Create PO"/>
                    </header>
                    <field name="date" />
                    <field name="name" />
                    <field name="user_id" />
                    <field name="state"/>
                    <field name="order_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

       

        <record model="ir.ui.view" id="od_purchase_enquiry_form_view">
            <field name="name">od.purchase.enquiry.form</field>
            <field name="model">od.purchase.enquiry</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <header>
                        <button name="button_confirm" string="Confirm" type="object" class="oe_highlight" states="draft"/>
                        <button name="button_reset" string="Reset to draft" type="object" attrs="{'invisible':['|',('state','!=','order'),('order_ids','!=',[])]}"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                          <h1>
                            <field name="name" readonly="1"/>
                          </h1>
                        </div>
                        <group>
                            <group name="group1">
                                <field name="partner_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="date" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="user_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="purchase_reference" attrs="{'readonly':[('state','!=','draft')]}"/>
                            </group>
                            <group name="group2">
                                <field name="company_id" invisible="1"/>
                                <field name="order_ids" force_save="1" widget="many2many_tags" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="lines" string="Lines">
                                <field name="line_ids" attrs="{'readonly':[('state','!=','draft')]}">
                                    <tree editable="bottom">
                                        <field name="enquiry_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="hs_code_id" force_save="1"/>
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="quantity" sum="Quantity"/>
                                        <field name="price_unit"/>
                                        <field name="ordered_qty" sum="Ordered Qty"/>
                                        <field name="remaining_qty" sum="Remaining Qty"/>
                                        <field name="order_line_ids" force_save="1" widget="many2many_tags" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="od_purchase_enquiry_action">
            <field name="name">Purchase Enquiry</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.purchase.enquiry</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_purchase_enquiry_tree_view"/>
        </record>
    </data>
</odoo>
