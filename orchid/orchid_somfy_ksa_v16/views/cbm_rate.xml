<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="orchid_cbm_rate_tree_view">
            <field name="name">orchid.cbm.rate.tree</field>
            <field name="model">orchid.cbm.rate</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
			    <tree string="CBM RATE MASTER">
                    <field name="name" />
					<field name="rate" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="orchid_cbm_rate_form_view">
            <field name="name">orchid.cbm.rate.form</field>
            <field name="model">orchid.cbm.rate</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="CBM RATE MASTER">
					<sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="rate" />
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_orchid_cbm_rate">
            <field name="name">CBM RATE MASTER</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orchid.cbm.rate</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="orchid_cbm_rate_menu"  name="CBM RATE MASTER" parent="sale.product_menu_catalog" 
            action="action_orchid_cbm_rate" sequence="10"/>
    </data>
</odoo>
