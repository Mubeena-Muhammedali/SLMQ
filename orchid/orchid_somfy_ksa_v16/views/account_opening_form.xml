<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_account_opening_form_tree_view">
            <field name="name">od.account.opening.form.tree</field>
            <field name="model">od.account.opening.form</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
			    <tree string="tree_string">
                    <field name="date" />
					<field name="name" />
                    <field name="partner"/>
					<field name="state"/>
                </tree>
            </field>
        </record>

       

        <record model="ir.ui.view" id="od_account_opening_form_form_view">
            <field name="name">od.account.opening.form.form</field>
            <field name="model">od.account.opening.form</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <header>
                        <button name="button_submit" string="Submit" type="object" class="oe_highlight" states="draft"/>
                        <!-- <button name="button_pre_approve" string="Pre-Approve" type="object" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_line_manager_approve_user"/>
                        <button name="%(orchid_somfy_ksa_v16.action_od_pricelist_price_change_refuse)d" string="Refuse" type="action" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_line_manager_approve_user" context="{'account_opening_form_id':active_ids}"/>  -->

                        <!-- <button name="button_approve" string="Approve" type="object" class="oe_highlight" states="pre_approve" groups="orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user"/>
                        <button name="%(orchid_somfy_ksa_v16.action_od_pricelist_price_change_refuse)d" string="Refuse" type="action" class="oe_highlight" states="pre_approve" groups="orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user" context="{'account_opening_form_id':active_ids}"/>  -->
                        
                        
                        <button name="button_gm_approve" string="Approve" type="object" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_bu_manager_approve_user,orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user"/>
                        <button name="%(orchid_somfy_ksa_v16.action_od_pricelist_price_change_refuse)d" string="Refuse" type="action" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_bu_manager_approve_user,orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user" context="{'account_opening_form_id':active_ids}"/> 
                        
                        <button name="button_reset_to_draft" string="Reset to draft" type="object" class="oe_highlight" states="refuse"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submit,gm_approve,refuse"/>
                      </header>
					<sheet>
                        <div class="oe_button_box" name="button_box">
                            <button string="Pricelist" type="object" name="create_pricelist" class="oe_stat_button" icon="fa-exchange"  states="draft,submit,pre_approve,approve,gm_approve"/>
                            <button string="Volume Rebate" type="object" name="create_volume_rebate" class="oe_stat_button" icon="fa-pencil-square-o" states="draft,submit,pre_approve,approve,gm_approve"/>
                        </div>

                       
                        <div class="oe_title">
                          <h1>
                            <field name="name" readonly="1" required="0" placeholder="Form No"/>
                          </h1>
                        </div>
                        <group>
                            <group name="customer_info" string="Customer Info">
                                <!-- <field name="initiated_user_id"   attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}" domain="['|',('active','=',False),('active','=',True)]"/> -->
                                <!-- Editable: Only All Leads -->
                                <field name="initiated_user_id"
                                       groups="sales_team.group_sale_salesman_all_leads"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"
                                       options="{'no_create': True, 'no_create_edit': True}"/>

                                <!-- Readonly: Salesman but NOT All Leads -->
                                <field name="initiated_user_id"
                                       groups="sales_team.group_sale_salesman,!sales_team.group_sale_salesman_all_leads"
                                       readonly="1"
                                       options="{'no_create': True, 'no_create_edit': True}"/>

                                <field name="refuse_reason" invisible="1"/>
                                <field name="date"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="business_unit"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="partner_id"  attrs="{'invisible': [('partner_id', '=',False)]}" readonly="1" force_save="1"/>
                                <field name="partner"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <!-- <field name="building"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="street"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="zip"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="district"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="state_id"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="country_id"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="land_mark"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="phone"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="fax"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="email"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="website"  attrs="{'readonly': [('state', '!=','draft')]}"/> -->
                                <label for="building" string="Address"/>
                                <div class="o_address_format">
                                    <field name="building" placeholder="Building..." class="o_address_street"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                    <field name="street" placeholder="Street..." class="o_address_street"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="district" placeholder="District" class="o_address_city"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                    <field name="state_id" class="o_address_state" placeholder="State"  attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}" domain="[('country_id','=',country_id)]"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country"  attrs="{'readonly': [('state', '!=','draft')]}"  options="{'no_create': True, 'no_create_edit':True}"  domain="[('od_business_unit', '=',business_unit)]"/>
                                    <field name="land_mark" placeholder="Nearest LandMark" class="o_address_city"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                </div>
                                <field name="phone"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="fax"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="email"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="website"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                            </group>
                            <group name="legal_status" string="Legal Status">
                                <field name="business_entity_type"   attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <label for="ct_license_no"/>
                                <div name="journal_div" class="d-flex">
                                    <field name="ct_license_no" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <span class="oe_inline o_form_label mx-3 oe_read_only">&#160;</span>
                                    <!-- Bigger margin on the left because in edit mode the external link button covers the text -->
                                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">&#160;</span>
                                    <field name="ct_license_date" string="Licendsce Date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                </div>
                                <label for="commerce_reg_no"/>
                                <div name="journal_div" class="d-flex">
                                    <field name="commerce_reg_no" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <span class="oe_inline o_form_label mx-3 oe_read_only">&#160;</span>
                                    <!-- Bigger margin on the left because in edit mode the external link button covers the text -->
                                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">&#160;</span>
                                    <field name="commerce_date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                </div>
                                <field name="expiry_date" attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="license_issuing_authority"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <label for="owner"/>
                                <div name="journal_div" class="d-flex">
                                    <field name="owner" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <span class="oe_inline o_form_label mx-3 oe_read_only">&#160;</span>
                                    <!-- Bigger margin on the left because in edit mode the external link button covers the text -->
                                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">&#160;</span>
                                    <field name="owner_country_id" attrs="{'readonly': [('state', '!=', 'draft')]}"  options="{'no_create': True, 'no_create_edit':True}"/>
                                </div>
                                <label for="sponsor"/>
                                <div name="journal_div" class="d-flex">
                                    <field name="sponsor" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <span class="oe_inline o_form_label mx-3 oe_read_only">&#160;</span>
                                    <!-- Bigger margin on the left because in edit mode the external link button covers the text -->
                                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">&#160;</span>
                                    <field name="sponsor_country_id" attrs="{'readonly': [('state', '!=', 'draft')]}"  options="{'no_create': True, 'no_create_edit':True}"/>
                                </div>
                                <field name="trn"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <field name="commercial_reg"/>
                                <field name="vat_reg"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Procurement &amp; Shipping Process" name="shipping">
                                <group>
                                    <group>
                                        <field name="ordering_type"/>
                                        <field name="inco_terms"/>
                                        <field name="order_confirm_partner_id"/>
                                        <field name="order_receive_partner_id"/>
                                    </group>
                                    <group>
                                        <label for="shipping_building" string="Shipping Address"/>
                                        <div class="o_address_format">
                                            <field name="shipping_building" placeholder="Building..." class="o_address_street"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                            <field name="shipping_street" placeholder="Street..." class="o_address_street"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                            <field name="shipping_zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="shipping_district" placeholder="District" class="o_address_city"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                            <field name="shipping_state_id" class="o_address_state" placeholder="State"  attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                                            <field name="shipping_country_id" placeholder="Country" class="o_address_country"  attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                                            <field name="shipping_land_mark" placeholder="Nearest LandMark" class="o_address_city"  attrs="{'readonly': [('state', '!=','draft')]}"/>
                                        </div>
                                        <field name="shipping_phone"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Bus Model &amp; Financial Data" name="finance">
                                <group>
                                    <group>
                                        <field name="line_of_business_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="distribution_channel_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="manufacturing_assembly"/>
                                        <field name="branches"/>
                                    </group>
                                    <group>
                                        <field name="m_segment"/>
                                        <field name="no_emp"/>
                                        <field name="no_management_staff"/>
                                        <field name="projects"/>
                                    </group>
                                    <group>
                                        <!-- <field name="cash"/> -->
                                        <!-- <field name="cheque"/> -->
                                        <field name="payment_term_id" required="1" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="turnover"/>
                                        <field name="expected_turnover"/>
                                    </group>
                                    <group>
                                        <field name="document_trade"/>
                                        <field name="open_credit"/>
                                        <field name="remittance_details" placeholder="If remitter is other than the owner..."/>
                                    </group>
                                </group>
                                <group>
                                    <field name="bank_ids" mode="tree,kanban" attrs="{'readonly': [('state', '!=','draft')]}">
                                        <tree editable="top">
                                            <field name="name"/>
                                            <field name="acc_no"/>
                                            <field name="branch"/>
                                            <field name="country_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                            <field name="address"/>
                                            <field name="form_id" invisible="1"/>
                                        </tree>
                                    </field>
                                </group>
                                <group>
                                    <field name="vendor_ids" mode="tree,kanban" attrs="{'readonly': [('state', '!=','draft')]}">
                                        <tree editable="top">
                                            <field name="name"/>
                                            <field name="phone"/>
                                            <field name="form_id" invisible="1"/>
                                        </tree>
                                    </field>
                                </group>
                                <group>
                                    <field name="customer_ids" mode="tree,kanban" attrs="{'readonly': [('state', '!=','draft')]}">
                                        <tree editable="top">
                                            <field name="name"/>
                                            <field name="phone"/>
                                            <field name="form_id" invisible="1"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                        <!-- <field name="remarks"  placeholder="Remarks" nolabel="1" attrs="{'readonly': [('state', '!=','draft')]}"/> -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_od_account_opening_form">
            <field name="name">Account Opening Form</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.account.opening.form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_account_opening_form_tree_view"/>
        </record>


		<menuitem id="od_account_opening_form_menu"  name="Account Opening Form" parent="sale.sale_menu_root" sequence="11"/>
            <menuitem id="od_account_opening_form_menu1"  name="Account Opening Form" parent="od_account_opening_form_menu" action="action_od_account_opening_form" sequence="1"/>
    
    </data>
</odoo>