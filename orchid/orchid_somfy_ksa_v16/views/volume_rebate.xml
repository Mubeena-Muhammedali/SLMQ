<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="orchid_volume_rebate_tree_view">
            <field name="name">orchid.volume.rebate.tree</field>
            <field name="model">orchid.volume.rebate</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
			    <tree string="Volume Rebate">
                    <field name="name" />
					<field name="partner_id" />
                    <field name="od_bp_code"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="orchid_volume_rebate_form_view">
            <field name="name">orchid.volume.rebate.form</field>
            <field name="model">orchid.volume.rebate</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Volume Rebate">
					<sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. USD Retailers"/></h1>
                        </div>
                        <group>
                          <group name="rebate_settings">
                                <field name="active" invisible="1"/>
                                <field name="partner_id" domain="[('parent_id','=',False)]" options="{'no_create':True}"/>
                                <field name="od_bp_code" readonly="1" force_save="1"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                          </group>
                        </group>
                        <notebook>
                            <page name="prebate_rules" string="Rebate Rules">
                                <field name="rebate_line_ids" nolabel="1">
                                    <tree string="Rebate Lines" editable="bottom" default_order="applied_on">
                                        <field name="applied_on"/>
                                        <field name="product_id" options="{'no_create':True}"/>
                                        <field name="categ_id" options="{'no_create':True}"/>
                                        <field name="rebate_volume_per"/>
                                        <field name="rebate_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_orchid_volume_rebate">
            <field name="name">Volume Rebate</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orchid.volume.rebate</field>
            <field name="view_mode">tree,form</field>
        </record>

		<menuitem id="orchid_volume_rebate_menu"  name="Volume Rebate" parent="sale.product_menu_catalog" 
            action="action_orchid_volume_rebate" sequence="10"/>


        <!-- inherited views -->
        <record id="view_partner_property_form_inherit_rebate" model="ir.ui.view">
            <field name="name">res.partner.product.property.form.inherit.rebate</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="product.view_partner_property_form"/>
            <field name="arch" type="xml">
                <field name="property_product_pricelist" position="after">
                    <field name="od_rebate_id" attrs="{'invisible': [('is_company','=',False),('parent_id','!=',False)]}" options="{'no_create':True}"/>
                </field>
            </field>
        </record>

        <record id="view_order_form_inher_rebate" model="ir.ui.view">
            <field name="name">sale.order.inher.rebate</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="od_show_update_rebate" invisible="1"/>
                    <label for="od_rebate_id"/>
                    <div  class="o_row">
                        <field name="od_rebate_id" force_save="1" options="{'no_open':True,'no_create': True}" readonly="1"/>
                        <button name="update_free_qtys" type="object"
                            string=" Update Free Qty"
                            help="Recompute all free qty based on this rebate"
                            class="btn-link mb-1 px-0" icon="fa-refresh"
                            confirm="This will update all free qty based on the currently set rebate."
                            attrs="{'invisible': ['|', ('od_show_update_rebate', '=', False), ('state', 'in', ['sale', 'done','cancel'])]}"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>