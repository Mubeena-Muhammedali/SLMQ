<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- for gulf sale upload -->
		<record id="view_payment_term_form_inher" model="ir.ui.view">
			<field name="name">account.payment.term.inher</field>
			<field name="model">account.payment.term</field>
			<field name="inherit_id" ref="account.view_payment_term_form"/>
			<field name="arch" type="xml">
				<field name="name" position="after">
					<field name="od_code"/>
				</field>
			</field>
		</record>
		<record id="orchid_accont_cost_center_form_view_ksa" model="ir.ui.view">
            <field name="name">orchid.account.cost.center.inher</field>
            <field name="model">orchid.account.cost.center</field>
            <field name="inherit_id" ref="orchid_account_enhancement_v16.orchid_accont_cost_center_form_view"/>
            <field name="arch" type="xml">
                <field name="seq" position="after">
                    <field name="include_pl"/>
                </field>
            </field>
        </record>

        <record id="view_account_payment_form_inher" model="ir.ui.view">
			<field name="name">account.payment.inher</field>
			<field name="model">account.payment</field>
			<field name="inherit_id" ref="account.view_account_payment_form"/>
			<field name="arch" type="xml">
				<div name="amount_div" position="after">
					<!-- <field name="od_bank_charges" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible':[('payment_type','!=','inbound')]}"/> -->
					<field name="od_bank_charges" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
				</div>
				<field name="partner_bank_id" position="after">
					<!-- <field name="od_bank_charges_account_id" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible':['|',('payment_type','!=','inbound'),('od_bank_charges','=',0)]}"/> -->
					<field name="od_bank_charges_account_id" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible':[('od_bank_charges','=',0)]}"/>
					<field name="od_exchange_rate" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
				</field>
			</field>
		</record>
	</data>
</odoo>