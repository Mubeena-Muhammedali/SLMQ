<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <record model="ir.ui.view" id="view_account_move_line_filter_inherit">
            <field name="name">Account Move line filter</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="od_parent_move_id"/>
                </field>
                <filter name="group_by_move">
                    <filter string="Parent Move" name="group_by_od_parent_move_id" domain="[]" context="{'group_by': 'od_parent_move_id'}"/>
                </filter>
            </field>
        </record>


		<record model="ir.ui.view" id="account_invoice_form_inher">
            <field name="name">Account Invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <button name="action_post" position="before">
                        <button name="button_update_custom_duty_line" type="object" string="Update Delivery Fee"/>
                    </button>
                    <field name="partner_id" position="after">
                        <field name="od_contact_person_id" domain="[('id','child_of',[partner_id]),('id','!=',partner_id)]" attrs="{'invisible': [('move_type', '=','entry')]}"/>
                    </field>
                	<field name="team_id" position="after">
	                    <field name="od_stamp" attrs="{'invisible': [('move_type', '=','entry')]}"/>
                        <field name="od_cos_entry_id" attrs="{'invisible': ['|',('state', '=','draft'),('move_type', 'not in',('out_invoice','in_invoice'))]}" options="{'no_create':True}" readonly="1" force_save="1"/>
                        <field name="od_cost_journal_id" readonly="1" force_save="1"/>

	                </field>
	                <group id="header_right_group" position="inside">
                        <field name="od_expert_prgm_inv" attrs="{'readonly': [('state', '!=','draft')],'invisible': [('move_type', '=','entry')]}"/>
                        <field name="od_revenue_type" readonly="0" force_save="1"/>
                    </group>
                    <!-- <field name="user_id" position="after">
                        <field name="od_exchange_rate" invisible="0" attrs="{'readonly': [('state', '!=','draft')],'invisible': [('move_type', '=','entry')]}" force_save="1"/>
                    </field> -->
                    <field name="invoice_user_id" position="attributes">
                        <attribute name="domain">['|',('active','=',False),('active','=',True)]</attribute>
                    </field>
                    <!-- <field name="amount_total" position="after" >
                        <field name="od_amount_untaxed" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                        <field name="od_amount_tax" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                        <field name="od_amount_total" widget="monetary" options="{'currency_field': 'company_currency_id'}" class="oe_subtotal_footer_separator"/>
                    </field> -->
	                <xpath expr="/form/sheet/notebook/page[@name='other_info']" position="before">
                        <page name="delivery_info" string="Delivery" attrs="{'invisible': [('move_type', '=','entry')]}">
                            <group>
                                <group>
                                    
                                    <!-- <field name="od_warehouse_id" readonly="1"/> -->
                                    <field name="od_gross_weight" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_no_of_packages" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_be_ref_no" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_customs_bill" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_cbm_vol" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_transaction_type" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                </group>
                                <group>
                                    <field name="od_local_transportation_id" attrs="{'invisible': [('od_local_transportation_id', '=', False)]}" readonly="1" force_save="1"/>
                                    <field name="od_transportation" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_destination" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_packing_list_no" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_packing_type" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_packing_qty" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_forwarder" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                    <field name="od_gbw_ref_no" attrs="{'readonly': [('state', 'in', ['open', 'paid'])]}"/>
                                </group>
                            </group>
                        </page>
                    </xpath>
                    <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="after">
	                    <field name="od_gross_weight" invisible="1"/>
	                </xpath>
	                <!-- <xpath expr="//field[@name='line_ids']/tree/field[@name='price_subtotal']" position="after">
	                    <field name="od_gross_weight" invisible="1"/>
	                </xpath> -->
	                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
	                    <field name="orchid_country_id"  options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
	                </xpath>
	                <!-- <xpath expr="//field[@name='line_ids']/tree/field[@name='product_id']" position="after">
	                    <field name="orchid_country_id" invisible="1"  options="{'no_create': True, 'no_create_edit':True}"/>
	                </xpath> -->
                    <xpath expr="//field[@name='line_ids']/tree/field[@name='credit']" position="after">
                        <field name="od_cost" optional="hide"/>
                        <field name="od_per_cost" optional="hide"/>
                        <field name="od_free_qty" invisible="1"/>
                        <field name="od_adjustment_qty" invisible="1"/>
                        <field name="od_parent_move_id" invisible="1" force_save="1"/>
                    </xpath>
					<xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
	                    <field name="od_free_qty" sum="total" optional="hide"/>
	                    <field name="od_adjustment_qty" sum="total" optional="hide"/>
	                    <field name="od_transaction_type"  options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                        <field name="od_parent_move_id" invisible="1" force_save="1"/>
	                </xpath>
	                <!-- <xpath expr="//field[@name='line_ids']/tree/field[@name='quantity']" position="after">
	                    <field name="od_free_qty"  sum="total" invisible="1"/>
	                    <field name="od_adjustment_qty"  sum="total" invisible="1"/>
	                    <field name="od_transaction_type" invisible="1"  options="{'no_create': True, 'no_create_edit':True}"/>
	                </xpath> -->
                    <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                        <field name="od_margin_reason" readonly="1" force_save="1" optional="hide"/>
                    </xpath>
	            </data>
	        </field>
	    </record>
        <record model="ir.ui.view" id="view_move_form_inher">
            <field name="name">Account Invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="l10n_sa.view_move_form"/>
            <field name="arch" type="xml">
                <field name="l10n_sa_delivery_date" position="attributes">
                    <attribute name="string">Date of Supply</attribute>
                </field>
            </field>
        </record>
	</data>
</odoo>



