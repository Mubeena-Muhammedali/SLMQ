<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="od_purchase_return_tree_view">
            <field name="name">od.purchase.return.tree</field>
            <field name="model">od.purchase.return</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="tree_string">
                    <field name="date" />
                    <field name="name" />
                    <field name="user_id" />
                    <field name="state"/>
                </tree>
            </field>
        </record>

       

        <record model="ir.ui.view" id="od_purchase_return_form_view">
            <field name="name">od.purchase.return.form</field>
            <field name="model">od.purchase.return</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <header>
                        <button name="button_transfer" string="Return" type="object" class="oe_highlight" states="draft"/>
                        <button name="button_debit_note" string="Create Debit Note" type="object" attrs="{'invisible':[('state','!=','return')]}"/>
                        <button name="button_complete" string="Complete" type="object" attrs="{'invisible':[('state','!=','debit_note')]}"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                          <h1>
                            <field name="name" readonly="1"/>
                          </h1>
                        </div>
                        <group>
                            <group name="group1">
                                <field name="date" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="user_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="partner_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
                            </group>
                            <group>
                                <field name="picking_id" readonly="1"/>
                                <field name="invoice_id" readonly="1"/>
                            </group>
                            <group name="group2">
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="lines" string="Lines">
                                <field name="line_ids" attrs="{'readonly':[('state','!=','draft')]}">
                                    <tree editable="bottom">
                                        <field name="return_id" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="stock_move_id" force_save="1" invisible="1"/>
                                        <field name="invoice_line_id" force_save="1" invisible="1"/>
                                        <field name="product_id"/>
                                        <field name="quantity" sum="Quantity"/>
                                        <field name="price_unit"/>
                                        <field name="stock_move_price_unit" force_save="1" readonly="1" optional="hide"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="od_purchase_return_search_view">
            <field name="name">od.purchase.return.search</field>
            <field name="model">od.purchase.return</field>
            <field name="arch" type="xml">
               <search string="Search">
                    <field name="name"/>
                    <field name="picking_id" />
                    <field name="user_id" />
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Transfer" name="picking" domain="[]" context="{'group_by': 'picking_id'}"/>
                        <filter string="Salesperson" name="user" domain="[]" context="{'group_by': 'user_id'}"/>
                        <filter string="Date" name="by_date" domain="[]" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="od_purchase_return_action">
            <field name="name">Purchase return</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.purchase.return</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_purchase_return_tree_view"/>
            <field name="search_view_id" ref="od_purchase_return_search_view"/>
        </record>
    </data>
</odoo>
