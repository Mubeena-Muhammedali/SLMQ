<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	
	<data noupdate="0">
		<record id="account_opening_form_notification_template" model="mail.template">
			<field name="name">{{ctx['name']}}</field>
			<field name="subject">{{ctx['subject']}}</field>
			<field name="email_from">{{(user.email_formatted or user.login) |safe}</field>
			<field name="email_to">{{ctx['email_to']}}</field>
			<field name="email_cc">{{ctx['email_cc']}}</field>
			<field name="lang">{{object.lang}</field>
			 <field name="model_id" ref="orchid_somfy_ksa_v16.model_od_account_opening_form"/>
			<field name="auto_delete" eval="False"/>
			<field name="body_html">
				 <![CDATA[
				 	<p>
				 		Dear {{ctx['recipient_name']}} ,
				 		<p>
				 			{{ctx['content']}}
					 	</p>
				 	</p>
				 	<br/><br/>
				 		<a href="{{object.get_form_url()}}" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">View Account Opening Form</a>
				 	<br/><br/><br/>
					<pre>
						Auto Generated Email
					</pre>
				 ]]>
			</field>
		</record>
		<record id="pricelist_price_change_notification_template" model="mail.template">
			<field name="name">Pricelist Price Change Notification</field>
			<field name="subject">{{ctx['subject']}}</field>
			<field name="email_from">{{(user.email_formatted or user.login) |safe}</field>
			<field name="email_to">{{ctx['email_to']}}</field>
			<field name="email_cc">{{ctx['email_cc']}}</field>
			<field name="lang">{{object.lang}</field>
			 <field name="model_id" ref="orchid_somfy_ksa_v16.model_od_pricelist_price_change"/>
			<field name="auto_delete" eval="False"/>
			<field name="body_html">
				 <![CDATA[
				 	<p>
				 		Dear {{ctx['recipient_name']}} ,
				 		<p>
				 			{{ctx['content']}}
					 	</p>
				 	</p>
				 	<br/><br/>
				 		<a href="{{object.get_form_url()}}" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">View Price Change</a>
				 	<br/><br/><br/>
					<pre>
						Auto Generated Email
					</pre>
				 ]]>
			</field>
		</record>
	</data>
</odoo>