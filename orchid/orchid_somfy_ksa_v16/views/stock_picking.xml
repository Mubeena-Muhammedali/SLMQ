<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="orchid_grn_no_tree_view">
            <field name="name">orchid.grn.no.tree</field>
            <field name="model">orchid.grn.no</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
			    <tree string="tree_string">
					<field name="name" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="orchid_grn_no_form_view">
            <field name="name">orchid.grn.no.form</field>
            <field name="model">orchid.grn.no</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <header>
                        <button name="button_search" string="Search" type="object" class="oe_highlight" states="draft"/>
                        <button name="button_lock" string="Lock" type="object" class="oe_highlight" states="draft"/>
                        <button name="button_unlock" string="Unlock" type="object" class="oe_highlight" states="lock"/>
                        <field name="state" widget="statusbar"/>
                    </header>
					<sheet>
						<group>
                            <group>
                                <field name="name" placeholder="GRN No." attrs="{'readonly': [('state', '=','lock')]}"/>
                                <field name="grn_date" attrs="{'readonly': [('state', '=','lock')]}"/>
                                <field name="shipment_size" attrs="{'readonly': [('state', '=','lock')]}"/>
                            </group>
                            <group>
                                <field name="import_invoice_no" attrs="{'readonly': [('state', '=','lock')]}"/>
                                <field name="warehouse_recipt_no" attrs="{'readonly': [('state', '=','lock')]}"/>
                            </group>
						</group>
                        <!-- <separator colspan="4"/> -->
                        <field name="grn_lines"  mode="tree" attrs="{'readonly': [('state', '=','lock')]}" >
                            <tree editable="bottom">
                                
                                <field name="origin"/>
                                
                                <field name="product_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="quantity" sum="Quantity"/>
                                <field name="price_unit"/>
                                <field name="total" sum="Total"/>
                                <field name="grn_id" invisible="1"/>
                            </tree>
                        </field>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_orchid_grn_no_tree_view">
            <field name="name">GRN No.</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">orchid.grn.no</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="orchid_grn_no_tree_view"/>
        </record>

		<menuitem id="orchid_grn_no_menu"  name="GRN No." parent="stock.menu_stock_warehouse_mgmt" 
            action="action_orchid_grn_no_tree_view" sequence="13"/>

        <record id="view_picking_form_inher" model="ir.ui.view">
            <field name="name">stock.picking.inher</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="od_grn_no" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                    <field name="shipment_size"/>
                    <field name="od_package_type"/>
                    <field name="od_dimensions"/>
                    <field name="od_import_invoice_no" invisible="1"/>
                    <field name="od_gbw_ref_no"  attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <field name="od_local_transportation_id" force_save="1" options="{'no_open':True,'no_create':True}"/>
                </field>
                <div name="button_box" position="inside">
                    <button  class="oe_inline oe_stat_button" type="object" name="od_action_open_landed_cost" icon="fa-list"  string="Landed Cost" widget="statinfo" attrs="{'readonly': [('state', '!=', 'done')]}"/>
                </div>
                <xpath expr="//notebook" position="inside">
                    <page name="od_landed_cost" string="Landed Cost Lines" attrs="{'invisible': [('od_grn_no', '=', False)]}">
                        <field name="od_landed_cost_line_ids" attrs="{'readonly': [('state', '=', 'done')]}">
                            <tree editable="bottom">
                                <field name="product_id" required="1"/>
                                <field name="name" required="1"/>
                                <field name="account_id" required="1"/>
                                <field name="split_method"/>
                                <field name="price_unit" required="1"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    
    </data>
</odoo>