<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_product_opening_form_batch_tree_view">
            <field name="name">od.product.opening.form.batch.tree</field>
            <field name="model">od.product.opening.form.batch</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
			    <tree string="tree_string">
                    <field name="date" />
					<field name="name" />
					<field name="state"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="od_product_opening_form_batch_form_view">
            <field name="name">od.product.opening.form.batch.form</field>
            <field name="model">od.product.opening.form.batch</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <header>
                        <button name="button_submit" string="Submit" type="object" class="oe_highlight" states="draft"/>
                        <button name="button_reset_to_draft" string="Reset to draft" type="object" class="oe_highlight" states="submit" groups="purchase.group_purchase_manager"/>
                        <button name="button_approve" string="Approve" type="object" class="oe_highlight" groups="purchase.group_purchase_manager" states="draft,submit"/>
                        <field name="state" widget="statusbar"/>
                    </header>
					<sheet>
                        <div class="oe_button_box" name="button_box" states="approve">
                            <button class="oe_stat_button" name="view_product_templates" icon="fa-th-list" type="object" string="Products"/>
                        </div>
                        <div class="oe_title">
                          <h1>
                            <field name="name" readonly="1" required="0" placeholder="Batch No"/>
                          </h1>
                        </div>
                        <group>
                            <group>
                                <!-- <field name="user_id" attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}" domain="['|',('active','=',False),('active','=',True)]"/> -->
                                <field name="user_id" attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="date"  attrs="{'readonly': [('state', '!=','draft')]}" required="1"/>
                            </group>
                            <group/>
                        </group>
                        <notebook>
                            <page string="Product Info" name="lines">
                                <field name="line_ids" attrs="{'readonly': [('state', '!=','draft')]}">
                                    <tree>
                                        <field name="product_name"  required="1"/>
                                        <field name="detailed_type"/>
                                        <field name="categ_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="default_code" required="1"/>
                                        <field name="orchid_arabic" optional="hide"/>
                                        <field name="od_factory_cost" optional="hide"/>
                                        <field name="od_sale_price" optional="hide"/>
                                        <field name="od_cost_price" optional="hide"/>
                                        <field name="orchid_group_id" options="{'no_create': True, 'no_create_edit':True}" required="1"/>
                                        <field name="orchid_type_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="orchid_class_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="orchid_country_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="orchid_hscode_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="od_com_code" optional="hide"/>
                                        <field name="od_depth" optional="hide"/>
                                        <field name="od_width" optional="hide"/>
                                        <field name="od_height" optional="hide"/>
                                        <field name="od_weight" optional="hide"/>
                                        <field name="od_pkg_weight" optional="hide"/>
                                        <field name="od_ttl_weight" optional="hide"/>
                                        <field name="od_cbm_vol" optional="hide"/>
                                        <field name="property_account_income_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="property_account_expense_id" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                                        <field name="opening_form_id" force_save="1" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                     <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="od_product_opening_form_batch_line_form_view">
            <field name="name">od.product.opening.form.batch.line</field>
            <field name="model">od.product.opening.form.batch.line</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <sheet>
                        <group>
                            <group>
                                <field name="product_name"  required="1"/>
                            </group>
                            <group/>
                        </group>
                        <notebook>
                            <page string="General Info" name="general">
                                <group>
                                    <group>
                                        <field name="detailed_type"/>
                                        <field name="categ_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="default_code" required="1"/>
                                        <field name="orchid_arabic"/>
                                    </group>
                                    <group>
                                        <field name="od_factory_cost"/>
                                        <field name="od_sale_price"/>
                                        <field name="od_cost_price"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Product Details" name="product_details">
                                <group>
                                    <group>
                                        <field name="orchid_group_id" options="{'no_create': True, 'no_create_edit':True}" required="1"/>
                                        <field name="orchid_type_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="orchid_class_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                    </group>
                                    <group>
                                        <field name="orchid_country_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="orchid_hscode_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Specification" name="specification">
                                <group>
                                    <group>
                                        <field name="od_com_code"/>
                                        <field name="od_depth"/>
                                        <field name="od_width"/>
                                        <field name="od_height"/>
                                    </group>
                                    <group>
                                        <field name="od_weight"/>
                                        <field name="od_pkg_weight"/>
                                        <field name="od_ttl_weight"/>
                                        <field name="od_cbm_vol"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Accounting" name="accounting">
                                <group>
                                    <group>
                                        <field name="property_account_income_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                    </group>
                                    <group>
                                        <field name="property_account_expense_id" options="{'no_create': True, 'no_create_edit':True}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_od_product_opening_form_batch">
            <field name="name">Product Opening Form Batch</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.product.opening.form.batch</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_product_opening_form_batch_tree_view"/>
        </record>
        <menuitem id="od_product_opening_form_batch_menu1"  name="Product Opening Form Batch" parent="od_product_opening_form_menu" action="action_od_product_opening_form_batch" sequence="1"/>
    </data>
</odoo>