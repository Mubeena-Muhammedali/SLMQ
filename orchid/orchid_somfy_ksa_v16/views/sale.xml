<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		
		<record id="view_order_form_inher" model="ir.ui.view">
			<field name="name">sale.order.inher</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form"/>
			<field name="arch" type="xml">
				<xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                	<attribute name="force_save">1</attribute>
                    <!-- <attribute name="attrs">{'readonly':[('od_readonly_group', '=', True)]}</attribute>              -->
                    <attribute name="attrs">{'readonly':[('od_readonly_product', '=', True)]}</attribute>             

                </xpath>
				<button name="action_cancel" position="attributes">
					<!-- <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['draft', 'sent']), ('id', '=', False)]}</attribute> -->
					<attribute name="groups">stock.group_stock_manager</attribute>
				</button>
                <field name="user_id" position="attributes">
                	<!-- <attribute name="domain">['|',('active','=',False),('active','=',True)]</attribute> -->
                	<attribute name="options">{'no_create':True}</attribute>
                </field>
                <field name="partner_id" position="attributes">
                	<attribute name="domain">[('parent_id','=',False)]</attribute>
                	<attribute name="options">{'no_create':True}</attribute>
                </field>
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                	<attribute name="options">{'no_create':True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                	<attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='product_template_id']" position="attributes">
                	<attribute name="options">{'no_create':True}</attribute>
                </xpath>
				<xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='qty_delivered']" position="after">
					<field name="od_readonly_group" force_save="1" invisible="1"/>
					<field name="od_readonly_product" force_save="1" invisible="1"/>
		        	<field name="od_free_qty" sum="total" readonly="1" force_save="1" optional="hide"/>
		        	<field name="od_adjustment_qty" sum="total" optional="hide"/>
		        	<field name="od_product_stock_qty"  force_save="1"/>
		        	<field name="od_reserved_qty"  force_save="1"/>
		        	<field name="od_transaction_type" options="{'no_create':True}"/>
		        	<field name="od_gross_weight" invisible="1"/>
		        </xpath>
		        <xpath expr="//field[@name='date_order']" position="after">
		        	<field name="od_adjustment_qty_status" decoration-danger="od_adjustment_qty_status !='approved'" decoration-success="od_adjustment_qty_status =='approved'" readonly="1" force_save="1" invisible="1"/>
		        	<field name="od_submission_mail_sent" force_save="1" invisible="1"/>
                    <field name="od_gross_weight" groups="stock.group_stock_manager"/>
                    <field name="od_cbm" groups="stock.group_stock_manager"/>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="od_service"/>
                    <field name="od_route_id" required="1" groups="stock.group_stock_manager" options="{'no_create':True}"/>
                    <field name="od_delivery_charge"/>
                    <field name="od_local_transportation_id" attrs="{'readonly': [('state', '!=','draft')],'required': [('od_delivery_charge', '=',True)],'invisible': [('od_delivery_charge', '!=',True)]}"  options="{'no_create': True, 'no_create_edit':True,'no_open':True}"/>
                </xpath>
                
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="od_purchase_id" groups="stock.group_stock_manager" options="{'no_create':True}"/>
                </xpath>
                <field name="client_order_ref" position="after">
                	<field name="od_transaction_type" attrs="{'readonly': [('state', '!=','draft')]}"/>
                	<field name="od_margin_visibile" invisible="1" force_save="1"/>
                </field>
                <button name="action_confirm" position="before">
                	<button name="button_update_custom_duty_line" type="object" string="Update Delivery Charges"/>
                	<button name="od_button_adj_qty_submission" type="object" string="Submit for approval" attrs="{'invisible':['|',('od_adjustment_qty_status','!=','need_approval'),'|',('state','!=','draft'),('od_submission_mail_sent','=',True)]}"/>
                	<button name="od_approve_adjustment_qty" groups="stock.group_stock_manager" type="object" string="Approve Adjustment Qty" attrs="{'invisible':['|',('od_adjustment_qty_status','!=','need_approval'),('state','!=','draft')]}"/>
                	<button name="%(orchid_somfy_ksa_v16.action_od_margin_sale_reason)d" string="Confirm" type="action" class="oe_highlight"  attrs="{'invisible':['|',('od_margin_visibile','=',False),('state','not in',('draft','sent'))]}" context="{'sale_id':active_ids}"/>
                </button>
                <xpath expr="//form/header/button[@name='action_confirm'][2]" position="attributes">
                	<attribute name="attrs">{'invisible': ['|',('od_margin_visibile','=',True),('state', 'not in', ['draft'])]}</attribute>
                </xpath>
                <xpath expr="//form/header/button[@id='action_confirm']" position="attributes">
                	<attribute name="attrs">{'invisible': ['|',('od_margin_visibile','=',True),('state', 'not in', ['sent'])]}</attribute>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree" position="inside">
                	<field name="od_margin_reason" readonly="1" force_save="1" optional="hide"/>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree" position="inside">
                    <field name="od_pricelist_percent" optional="hide" readonly="1" force_save="1"/>
                </xpath>
                <xpath expr="/form/sheet/notebook" position="inside">
                    <page name="od_terms" string="Terms &amp; Conitions" invisible="1">
                        <field name="od_terms_conditions" options="{'resizable': false,'codeview':true}" placeholder="Terms and conditions..." widget="html"/>
                    </page>
                </xpath>
			</field>
		</record>

		<record id="view_order_form_inherit_sale_stock_orchid" model="ir.ui.view">
			<field name="name">sale.order.form.sale.stock</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='picking_policy']" position="after">
                    <field name="od_transportation"/>
                </xpath>
            </field>
        </record>

        <record id="view_order_form_inher_reservation_inherit" model="ir.ui.view">
            <field name="name">sale.reservation.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="orchid_stock_reservation_v16.view_order_form_inher_reservation" />
            <field name="arch" type="xml">  
                <button name="od_action_reserve" position="attributes">
                    <attribute name="attrs">{'invisible':['|',('state','!=','draft'),('od_adjustment_qty_status','=','need_approval')]}</attribute>                  
                </button>
            </field>
        </record>

	</data>
</odoo>
	