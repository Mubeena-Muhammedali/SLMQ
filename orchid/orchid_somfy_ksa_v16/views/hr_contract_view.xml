<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od_hr_contract_form_inherit" model="ir.ui.view">
        <field name="name">od.hr.contract.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='information']" position="after">
                <page string="Salary Provision" name="salary_provision">
                    <group>
                        <group>
                            <field name="od_bonus_percentage"/>
                            <field name="od_annual_bonus"/>
                            <field name="od_contract_year"/>
                            <field name="od_years_of_service"/>
                        </group>
                        <group>
                            <field name="od_gross_annual_salary"/>
                            <field name="od_current_year_eosb"/>
                            <field name="od_previous_year_eosb"/>
                            <field name="od_opening_balance"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>