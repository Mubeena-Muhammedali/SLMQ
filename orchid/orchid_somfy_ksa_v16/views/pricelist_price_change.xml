<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_pricelist_price_change_tree_view">
            <field name="name">od.pricelist.price.change.tree</field>
            <field name="model">od.pricelist.price.change</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="tree_string">
                    <field name="date" />
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="od_pricelist_price_change_line_form_view">
            <field name="name">od.pricelist.price.change.line</field>
            <field name="model">od.pricelist.price.change.line</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <sheet>
                        <h1><field name="name"/></h1>
                        <group>
                            <group name="pricelist_rule_target">
                                <field name="price_type" invisible="1" force_save="1"/>
                                <field name="price_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="pricelist_applied_on" widget="radio" attrs="{'invisible':[('price_type','not in',('pricelist','create_pricelist'))]}"/>
                                <field name="vbr_applied_on" widget="radio" attrs="{'invisible':[('price_type','not in',('vbr','create_vbr'))]}"/>
                                <field name="categ_id" attrs="{'invisible':[('pricelist_applied_on','!=','2_product_category')],'required':[('pricelist_applied_on', '=', '2_product_category')]}" options="{'no_create':1}"/>
                                <field name="product_tmpl_id" attrs="{'invisible':[('pricelist_applied_on', '!=', '1_product')],'required':[('pricelist_applied_on', '=', '1_product')]}" options="{'no_create':1}"/>
                                <field name="od_product_segment_id" options="{'no_create':1}" attrs="{'invisible':[('pricelist_applied_on', '!=', '1_product_segment')],'required':[('pricelist_applied_on', '=', '1_product_segment')]}" string="Product Segment"/>
                                <field name="product_id" attrs="{ 'invisible':[('pricelist_applied_on', '!=','0_product_variant')],'required':[('pricelist_applied_on', '=', '0_product_variant')]}" options="{'no_create':1}"/>
                                <field name="orchid_brand_id" attrs="{'invisible':[('pricelist_applied_on','!=','2_rproduct_brand')],'required':[('pricelist_applied_on','=', '2_rproduct_brand')]}" string="Product Brand" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="orchid_type_id" attrs="{'invisible':[('pricelist_applied_on','!=','2_qproduct_ftype')],'required':[('pricelist_applied_on','=', '2_qproduct_ftype')]}" string="Product Type" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="orchid_group_id" attrs="{'invisible':[('pricelist_applied_on','!=','2_qproduct_group')],'required':[('pricelist_applied_on','=', '2_qproduct_group')]}" string="Product Group" options="{'no_create': True, 'no_create_edit':True}"/>
                            </group>
                            <group name="pricelist_rule_method">
                                <field name="compute_price" string="Compute Price" widget="radio" attrs="{'invisible':[('price_type','not in',('pricelist','create_pricelist'))],'required':[('price_type','in',('pricelist','create_pricelist'))]}"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="categ_id" attrs="{'invisible':[('vbr_applied_on','!=','2_product_category')],'required':[('vbr_applied_on', '=', '2_product_category')]}" options="{'no_create':1}"/>
                                <field name="product_tmpl_id" attrs="{'invisible':[('vbr_applied_on', '!=', '1_product')],'required':[('vbr_applied_on', '=', '1_product')]}" options="{'no_create':1}"/>
                                <field name="product_id" attrs="{ 'invisible':[('vbr_applied_on', '!=','0_product_variant')],'required':[('vbr_applied_on', '=', '0_product_variant')]}" options="{'no_create':1}"/>
                                <field name="orchid_brand_id" attrs="{'invisible':[('vbr_applied_on','!=','2_rproduct_brand')],'required':[('vbr_applied_on','=', '2_rproduct_brand')]}" string="Product Brand" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="orchid_type_id" attrs="{'invisible':[('vbr_applied_on','!=','2_qproduct_ftype')],'required':[('vbr_applied_on','=', '2_qproduct_ftype')]}" string="Product Type" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="orchid_group_id" attrs="{'invisible':[('vbr_applied_on','!=','2_qproduct_group')],'required':[('vbr_applied_on','=', '2_qproduct_group')]}" string="Product Group" options="{'no_create': True, 'no_create_edit':True}"/>
                            </group>
                            <group name="pricelist_rule_base">
                                <field name="fixed_price" attrs="{'invisible':['|',('compute_price', '!=', 'fixed'),('price_type','not in',('pricelist','create_pricelist'))]}"/>
                                <label for="percent_price" attrs="{'invisible':['|',('compute_price', '!=', 'percentage'),('price_type','not in',('pricelist','create_pricelist'))]}"/>
                                <div attrs="{'invisible':['|',('compute_price', '!=', 'percentage'),('price_type','not in',('pricelist','create_pricelist'))]}">
                                  <field name="percent_price" class="oe_inline" attrs="{'invisible':['|',('compute_price', '!=', 'percentage'),('price_type','not in',('pricelist','create_pricelist'))]}"/>
                                  %
                                </div>
                                <field name="rebate_percent" attrs="{'invisible':[('price_type','not in',('vbr','create_vbr'))]}"/>
                                <field name="price" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
         <record model="ir.ui.view" id="od_pricelist_price_change_form_view">
            <field name="name">od.pricelist.price.change</field>
            <field name="model">od.pricelist.price.change</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="form_string">
                    <header>
                        <button name="button_get_lines" string="Get current data" type="object" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','draft'),('price_type','not in',('vbr','pricelist'))]}" />
                        <button name="button_submit" string="Submit" type="object" class="oe_highlight" states="draft"/>
                        
                        <!-- <button name="%(orchid_somfy_ksa_v16.action_orchid_approval_wiz)d" string="Approve" type="action" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user" context="{'pricelist_price_change_id':active_ids}"/>
                        <button name="%(orchid_somfy_ksa_v16.action_od_pricelist_price_change_refuse)d" string="Refuse" type="action" class="oe_highlight" states="submit,approve" groups="orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user,sales_team.group_sale_manager" context="{'pricelist_price_change_id':active_ids}"/> -->


                        <button name="button_gm_approve" string="Approve" type="object" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_bu_manager_approve_user,orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user"/>
                        <button name="%(orchid_somfy_ksa_v16.action_od_pricelist_price_change_refuse)d" string="Refuse" type="action" class="oe_highlight" states="submit" groups="orchid_somfy_ksa_v16.od_group_bu_manager_approve_user,orchid_somfy_ksa_v16.od_group_account_opening_form_approve_user" context="{'pricelist_price_change_id':active_ids}"/> 
                        
                        <button name="button_reset_to_draft" string="Reset to draft" type="object" class="oe_highlight" states="refuse"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submit,gm_approve,refuse"/>
                      </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" invisible="1"/>
                                <field name="partner_id" required="1" attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}" domain="[('parent_id','=',False)]"/>
                                <field name="price_type" required="0" attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <!-- <label for="date_from" string="Date From"/>
                                <div name="date_div" class="d-flex">
                                    <field name="date_from" required="1" attrs="{'readonly': [('state', '!=','draft')]}" />
                                    <span class="oe_inline o_form_label mx-3 oe_read_only">to</span>
                                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only">to</span>
                                    <field name="date_to" required="1" attrs="{'readonly': [('state', '!=','draft')]}" />
                                </div> -->
                                <field name="date" required="1" attrs="{'readonly': [('state', '!=','draft')]}"/>
                                <!-- <field name="user_id" required="1" attrs="{'readonly': [('state', '!=','draft')]}" domain="['|',('active','=',False),('active','=',True)]" options="{'no_create': True, 'no_create_edit':True}"/> -->
                                <field name="user_id" required="1" attrs="{'readonly': [('state', '!=','draft')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="manger_id" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="pricelist_id" readonly="1" force_save="1" options="{'no_open':True}"/>
                                <field name="vbr_id" readonly="1" force_save="1" options="{'no_open':True}"/>
                                <field name="company_id" invisible="1"/>
                                <field name="refuse_reason" invisible="1"/>
                                <!-- <label for="data_file" string="Data File"/>
                                <div class="o_row">
                                    <field name="data_file" attrs="{'readonly': ['|','|',('state', '!=','draft'),('pricelist_id', '=',False),('price_type', '!=','pricelist')]}"/>
                                    <button name="button_upload" string="Import Data" type="object" icon="fa-refresh" attrs="{'invisible':['|','|',('pricelist_id','=',False),('price_type', '!=','pricelist'),('state','!=','draft')]}"/>
                                </div> -->
                            </group>
                        </group>
                        <notebook>
                            <page name="line_ids" string="Lines" attrs="{'invisible': [('price_type','=',False)]}">
                                <field name="line_ids" nolabel="1" force_save="1" default_order="name asc"  attrs="{'readonly':[('state','!=','draft')]}">
                                    <tree string="Lines">
                                        <field name="name"/>
                                        <field name="old_price"/>
                                        <field name="price"/>
                                        <field name="price_id" invisible="1"/>
                                        <field name="pricelist_line_id" invisible="1"/>
                                        <field name="vbr_line_id" invisible="1"/>
                                        <field name="price_type" invisible="1" force_save="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_od_pricelist_price_change">
            <field name="name">Price Change</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.pricelist.price.change</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_pricelist_price_change_tree_view"/>
        </record>

        <menuitem id="od_pricelist_price_change_menu"  name="Price Change" parent="od_account_opening_form_menu" 
            action="action_od_pricelist_price_change" sequence="2"/>
    </data>
</odoo>


                                
                                