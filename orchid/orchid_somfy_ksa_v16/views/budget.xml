<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <record model="ir.ui.view" id="view_orchid_budget_form_inherit">
            <field name="name">orchid.budget</field>
            <field name="model">orchid.budget</field>
            <field name="inherit_id" ref="orchid_budget_v16.view_orchid_budget_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[1]/field[@name='od_budget_line_mnth']/tree/field[@name='account_id']" position="after">
                    <field name="report_template_id" optional="hide"/>
                    <field name="name" readonly="1" required="1" force_save="1"/>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[1]/field[@name='od_budget_line_mnth']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[1]/field[@name='od_budget_line_mnth']/form/group[1]/group[1]/field[@name='account_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    <attribute name="required">0</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[1]/field[@name='od_budget_line_mnth']/form/group[1]/group[1]/field[@name='account_id']" position="after">
                    <field name="report_template_id" invisible="1"/>
                    <field name="name" readonly="1" required="1" force_save="1"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="view_orchid_budget_line_tree_inherit">
            <field name="name">orchid.budget.line.tree</field>
            <field name="model">orchid.budget.line</field>
            <field name="inherit_id" ref="orchid_budget_v16.view_orchid_budget_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='account_id']" position="after">
                    <field name="report_template_id" optional="hide"/>
                    <field name="name" readonly="1" required="1" force_save="1"/>
                </xpath>
                <xpath expr="//tree/field[@name='account_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>