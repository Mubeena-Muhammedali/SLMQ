<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="od_local_transport_charge_master_view_form" model="ir.ui.view">
            <field name="name">Local Transportation Charge</field>
            <field name="model">od.local.transport.charge.master</field>
            <field name="arch" type="xml">
                <form string="Local Transportation Charge">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="cost"/>
                            </group>
                            <group/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="od_local_transport_charge_master_view_tree" model="ir.ui.view">
            <field name="name">Local Transportation Charge</field>
            <field name="model">od.local.transport.charge.master</field>
            <field name="arch" type="xml">
                <tree string="Local Transportation Charge">
                    <field name="name"/>
                    <field name="cost"/>
                </tree>
            </field>
        </record>

        <record id="action_od_local_transport_charge_master" model="ir.actions.act_window">
            <field name="name">Local Transportation Charge</field>
            <field name="res_model">od.local.transport.charge.master</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="od_local_transport_charge_master_view_tree"/>
        </record>
    </data>
</odoo>