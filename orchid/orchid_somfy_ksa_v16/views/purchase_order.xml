<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="purchase_order_form_inher" model="ir.ui.view">
			<field name="name">purchase.order.inher</field>
			<field name="model">purchase.order</field>
			<field name="inherit_id" ref="purchase.purchase_order_form"/>
			<field name="arch" type="xml">
				<field name="currency_id" position="after">
					<field name="od_non_inventroy" attrs="{'readonly':[('state','!=','draft')]}"/>
					<field name="od_non_trade_inventory" attrs="{'readonly':[('state','!=','draft')]}"/>
					<field name="od_currency_rate" attrs="{'readonly':[('state','!=','draft')]}"/>
				</field>
				<button name="button_approve" position="attributes">
					<attribute name="groups">base.group_erp_manager</attribute>
				</button>
			</field>
		</record>
	</data>
</odoo>