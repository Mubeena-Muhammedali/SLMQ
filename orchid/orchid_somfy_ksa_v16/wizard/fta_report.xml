<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="fta_report_wizard" model="ir.ui.view">
            <field name="name">FTA Declaration Report</field>
            <field name="model">orchid.fta.report.wiz</field>
            <field name="arch" type="xml">
                <form string="FTA Declaration Report">
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="exchange_rate_id" readonly="1"/>
                            <field name="reverse_rate_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_fta_report_wizard" model="ir.actions.act_window">
            <field name="name">FTA Declaration Report</field>
            <field name="res_model">orchid.fta.report.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_fta_report_wizard" id="menu_fta_report"
            name="FTA Declaration Report" parent="sale.menu_sale_report" sequence="2" />

    </data>
</odoo>