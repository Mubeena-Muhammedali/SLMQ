<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="od_stock_report_wiz" model="ir.ui.view">
            <field name="name">Location Stock Report</field>
            <field name="model">od.stock.report.wiz</field>
            <field name="arch" type="xml">
                <form string="Location Stock Report">
                    <group>
                        <group>
                            <field name="date_to" required="1"/>
                            <field name="location_id" required="1" domain="[('usage','=','internal')]"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_od_stock_report_wiz" model="ir.actions.act_window">
            <field name="name">Location Stock Report</field>
            <field name="res_model">od.stock.report.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem action="action_od_stock_report_wiz" id="menu_od_stock_report_wiz"
            name="Location Stock Report" parent="stock.menu_warehouse_report" sequence="3" />
    </data>
</odoo>