<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="od_pricelist_price_change_refuse" model="ir.ui.view">
            <field name="name">Refuse</field>
            <field name="model">od.pricelist.price.change.refuse</field>
            <field name="arch" type="xml">
                <form string="Refuse">
                    <group>
                        <field name="pricelist_price_change_id" invisible="1" force_save="1"/>
                        <field name="account_opening_form_id" invisible="1" force_save="1"/>
                        <field name="reason" required="1"/>
                        <field name="is_manager" invisible="1"/>
                        <!-- <field name="password" attrs="{'required':[('is_manager','=',False)],'invisible':[('is_manager','!=',False)]}"/> -->
                    </group>
                        
                    <footer>
                        <button string="Confirm" name="action_refuse" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_od_pricelist_price_change_refuse" model="ir.actions.act_window">
            <field name="name">Refuse</field>
            <field name="res_model">od.pricelist.price.change.refuse</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
    </data>
</odoo>
