<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="sale_register_wizard" model="ir.ui.view">
            <field name="name">Sales Register</field>
            <field name="model">orchid.sale.register.wiz</field>
            <field name="arch" type="xml">
                <form string="Sales Register">
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="motor_product" invisible="1"/>
                            <field name="service_product"/>
                            <field name="separate_qty"/>
                            <field name="transaction_type"/>
                            <field name="company_id" invisible="1"/>
                            <field name="factory_price" groups="orchid_somfy_ksa_v16.group_factory_users"/>
                           
                        </group>
                        <group>
                            <field name="credit_note"/>
                            <field name="with_service"/>
                            <field name="warehouse_id" invisible="1"/>
                            <!-- <field name="user_id" options="{'no_create': True}" domain="['|',('active','=',False),('active','=',True)]"/> -->
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="partner_id" domain="[('parent_id','=',False)]" context="{'res_partner_search_mode': 'customer'}" options="{'no_create': True}"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <!-- <field name="show_in_euro"/> -->
                            <!-- <field name="exchange_rate_id" attrs="{'invisible':[('show_in_euro','=',False)]}" readonly="1"/> -->
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary" attrs="{'invisible':[('motor_product', '=', True)]}"/>
                        <!-- <button string="View Report" name="generate_view" type="object" class="btn-primary" attrs="{'invisible':[('motor_product', '=', True)]}"/> -->
                        <button string="Generate Excel" name="generate_motor" type="object" class="btn-primary" attrs="{'invisible':[('motor_product', '=', False)]}"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_register_wizard" model="ir.actions.act_window">
            <field name="name">Sales Register</field>
            <field name="res_model">orchid.sale.register.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_sale_register_wizard" id="menu_sale_register"
            name="Sales Register" parent="sale.menu_sale_report" sequence="3" />

    </data>
</odoo>