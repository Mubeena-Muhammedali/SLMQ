<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        
        <record id="action_vat_declaration_report_wizard" model="ir.actions.act_window">
            <field name="name">VAT Declaration Report</field>
            <field name="res_model">orchid.vat.declaration.report.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        
        <record id="view_vat_declaration_wizard_form" model="ir.ui.view">
            <field name="name">VAT Declaration Report Wizard</field>
            <field name="model">orchid.vat.declaration.report.wiz</field>
            <field name="arch" type="xml">
                <form string="VAT Declaration Report">
                   <group>
                        <group col="4"> 
                            <field name="from_date" widget="date"/>
                            <field name="to_date" widget="date"/>
                        </group>
                         <group col="4"> 
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                        
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

       
        <menuitem 
            id="menu_vat_declaration_report"
            name="VAT Declaration Report"
            action="action_vat_declaration_report_wizard"
            parent="account.account_reports_management_menu"
            sequence="4"/>

    </data>
</odoo>
