<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="od_margin_sale_reason" model="ir.ui.view">
            <field name="name">Reason for Margin</field>
            <field name="model">od.margin.sale.reason</field>
            <field name="arch" type="xml">
                <form string="Reason for Margin">
                    <group>
                        <field name="sale_id" invisible="1" force_save="1"/>
                        <field name="reason" required="1"/>
                    </group>
                    <footer>
                        <button string="Confirm" name="action_update_reason" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_od_margin_sale_reason" model="ir.actions.act_window">
            <field name="name">Reason for Margin</field>
            <field name="res_model">od.margin.sale.reason</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        

    </data>
</odoo>