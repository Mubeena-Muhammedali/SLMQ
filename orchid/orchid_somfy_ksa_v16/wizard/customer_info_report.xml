<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="orchid_customer_info_report_wiz_form" model="ir.ui.view">
            <field name="name">Customer Info Report</field>
            <field name="model">orchid.customer.info.report.wiz</field>
            <field name="arch" type="xml">
                <form string="Customer Info Report">
                    <group>
                        <group>
                            <field name="report_type" required="1"/>
                            <field name="date_from"  attrs="{'invisible':[('report_type','=','customer_info')],'required':[('report_type','=','turn_over')]}"/>
                            <field name="date_to"  attrs="{'invisible':[('report_type','=','customer_info')],'required':[('report_type','=','turn_over')]}"/>
                            <field name="partner_id" domain="[('parent_id','=',False),('customer_rank','>=',1)]" options="{'no_create_edit':True,'no_open':True}"/>
                            <field name="od_name_unamed" attrs="{'invisible':[('report_type','=','turn_over')]}"/>
                            <field name="od_lne_buss_id" options="{'no_create_edit':True,'no_open':True}" attrs="{'invisible':[('report_type','=','turn_over')]}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_orchid_customer_info_report_wiz" model="ir.actions.act_window">
            <field name="name">Customer Info Report</field>
            <field name="res_model">orchid.customer.info.report.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_orchid_customer_info_report_wiz" id="menu_orchid_customer_info_report_wiz"
            name="Customer Info Report" parent="sale.menu_sale_report" sequence="9" />

    </data>
</odoo>