<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="threes_report_wizard" model="ir.ui.view">
            <field name="name">3S Report</field>
            <field name="model">orchid.threes.report.wiz</field>
            <field name="arch" type="xml">
                <form string="3S Report">
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="factory_price" attrs="{'invisible':[('report_xl','in',('product','customer'))]}" groups="orchid_somfy_ksa_v16.group_factory_users"/>
                            <field name="report_xl"/>
                            <field name="od_csv" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="service_product"/>
                            <!-- <field name="show_in_euro"/> -->
                            <!-- <field name="exchange_rate_id" attrs="{'invisible':[('show_in_euro','=',False)]}" readonly="1"/> -->
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                        <!-- <button string="View Report" name="generate_view" type="object" class="btn-primary"/> -->
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_threes_report_wizard" model="ir.actions.act_window">
            <field name="name">3S Report</field>
            <field name="res_model">orchid.threes.report.wiz</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_threes_report_wizard" id="menu_threes_report"
            name="3S Report" parent="sale.menu_sale_report" sequence="9" />

    </data>
</odoo>