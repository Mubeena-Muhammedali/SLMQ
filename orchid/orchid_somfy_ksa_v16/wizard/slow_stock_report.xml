<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="od_slow_stock_report_wiz" model="ir.ui.view">
            <field name="name">Slow Moving Stock</field>
            <field name="model">od.slow.stock.report.wiz</field>
            <field name="arch" type="xml">
                <form string="Slow Moving Stock">
                    <group>
                        <group>
                            <!-- <field name="date_from" required="1"/> -->
                            <field name="date_to" required="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_od_slow_stock_report_wiz" model="ir.actions.act_window">
            <field name="name">Slow Moving Stock</field>
            <field name="res_model">od.slow.stock.report.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem action="action_od_slow_stock_report_wiz" id="menu_od_slow_stock_report_wiz"
            name="Slow Moving Stock" parent="account.account_reports_management_menu" sequence="3" />
        <menuitem action="action_od_slow_stock_report_wiz" id="menu_od_slow_stock_report_wiz_inv"
            name="Slow Moving Stock" parent="stock.menu_warehouse_report" sequence="3" />
    </data>
</odoo>