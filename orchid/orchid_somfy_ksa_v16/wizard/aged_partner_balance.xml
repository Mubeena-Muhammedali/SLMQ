<?xml version="1.0" encoding="utf-8"?>
	<odoo>

		<record id="account_aged_balance_view_inher_ksa" model="ir.ui.view">
			<field name="name">Aged Partner Balance</field>
			<field name="model">account.aged.trial.balance</field>
			<field name="inherit_id" ref="orchid_account_reports_v11.account_aged_balance_view_inher"/>
			<field name="arch" type="xml">
			
				<field name="od_include_reconciled" position="after">
					<field name="od_with_currency" groups="account.group_account_invoice"/>
				</field>
				<field name="partner_ids" position="replace">
					<field name="partner_ids" options="{'no_open': True, 'no_create': True}" domain="['|', ('customer','=',True),('supplier','=',True)]"/>
				</field>
				<xpath expr="//button[@name='print_excel']" position="attributes">
                    <attribute name="groups">account.group_account_invoice,orchid_somfy_ksa_v16.group_branch_users</attribute>
                </xpath>
                 
			</field>
		</record>
	</odoo>
