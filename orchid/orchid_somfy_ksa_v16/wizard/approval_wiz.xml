<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="orchid_approval_wiz" model="ir.ui.view">
            <field name="name">Approve</field>
            <field name="model">orchid.approval.wiz</field>
            <field name="arch" type="xml">
                <form string="Approve">
                    <group>
                        <field name="account_opening_form_id" invisible="1" force_save="1"/>
                        <field name="pricelist_price_change_id" invisible="1" force_save="1"/>
                        <field name="password" required="1"/>
                    </group>
                    <footer>
                        <button string="Approve" name="button_approve" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_orchid_approval_wiz" model="ir.actions.act_window">
            <field name="name">Approve</field>
            <field name="res_model">orchid.approval.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <!-- <menuitem action="action_orchid_approval_wiz" id="menu_sale_register"
            name="Approve" parent="sale.menu_sale_report" sequence="3" /> -->

    </data>
</odoo>