<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="od_dso_wiz" model="ir.ui.view">
            <field name="name">DSO/DIO Report</field>
            <field name="model">od.dso.wiz</field>
            <field name="arch" type="xml">
                <form string="DSO/DIO Report">
                    <group>
                        <group>
                            <field name="date_from" invisible="1" force_save="1"/>
                            <field name="date_to" invisible="1" force_save="1"/>
                            <field name="month" required="1"/>
                            <field name="year" required="1"/>
                            <field name="report_type" required="1"/>
                            <field name="company_id" invisible="1"/>
                           
                        </group>
                        <group>
                            <!-- <field name="user_id" options="{'no_create': True}" domain="['|',('active','=',False),('active','=',True)]" attrs="{'invisible':[('report_type', '=', 'DIO')]}"/> -->
                            <field name="user_id" options="{'no_create': True}" attrs="{'invisible':[('report_type', '=', 'DIO')]}"/>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel_dso" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_od_dso_wiz" model="ir.actions.act_window">
            <field name="name">DSO/DIO Report</field>
            <field name="res_model">od.dso.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_od_dso_wiz" id="menu_od_dso_dio"
            name="DSO/DIO Report" parent="account.account_reports_management_menu" sequence="3" />

    </data>
</odoo>