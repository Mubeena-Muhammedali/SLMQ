<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="recurring_wizard" model="ir.ui.view">
            <field name="name">orchid.recurring.wiz.form</field>
            <field name="model">orchid.recurring.wiz</field>
            <field name="arch" type="xml">
                <form string="Recurring Entry">
                    <group>
                        
                        <field name="recurring_entry" domain="[('recurring_state', '=','running')]" required="1"/>
                        <field name="company_id" invisible="1"/>
                           
                    </group>
                    <footer>
                        <button string="Generate" name="generate" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_recurring_wizard" model="ir.actions.act_window">
            <field name="name">Recurring Entry</field>
            <field name="res_model">orchid.recurring.wiz</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        

    </data>
</odoo>