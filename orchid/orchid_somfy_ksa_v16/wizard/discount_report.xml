<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="orchid_discount_report_wiz" model="ir.ui.view">
            <field name="name">Discount Report</field>
            <field name="model">orchid.discount.report.wiz</field>
            <field name="arch" type="xml">
                <form string="Discount Report">
                    <group>
                        <group>
                            <field name="report_type" required="1"/>
                            <field name="partner_id" domain="[('parent_id','=',False)]" options="{'no_create':True}"/>
                            <field name="categ_id" attrs="{'invisible':[('report_type','=','net')]}" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Excel" name="print_excel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_orchid_discount_report_wiz" model="ir.actions.act_window">
            <field name="name">Discount Report</field>
            <field name="res_model">orchid.discount.report.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_orchid_discount_report_wiz" id="menu_orchid_discount_report_wiz"
            name="Discount Report" parent="sale.menu_sale_report" sequence="3" />
    </data>
</odoo>
