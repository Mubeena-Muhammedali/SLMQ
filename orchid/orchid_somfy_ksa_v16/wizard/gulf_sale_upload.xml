<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="gulf_sale_wiz" model="ir.ui.view">
            <field name="name">Gulf Sale Order Upload</field>
            <field name="model">od.gulf.sale.upload.wiz</field>
            <field name="arch" type="xml">
                <form string="Gulf Sale Order Upload">
                    <group>
                        <group>
                            <field name="data_file"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <footer>
                        <button string="Import Sale" name="upload_data" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_gulf_sale_wiz" model="ir.actions.act_window">
            <field name="name">Gulf Sale Order Upload</field>
            <field name="res_model">od.gulf.sale.upload.wiz</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_gulf_sale_wiz" id="menu_gulf_sale_wiz"
            name="Gulf Sale Order Upload" parent="sale.sale_order_menu" sequence="4" 
            groups="account.group_account_invoice"/>

    </data>
</odoo>