<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="customer_insurance_wizard" model="ir.ui.view">
            <field name="name">Customer Insurance Details</field>
            <field name="model">orchid.customer.insurance.wiz</field>
            <field name="arch" type="xml">
                <form string="Sales Register">
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_customer_insurance_wizard" model="ir.actions.act_window">
            <field name="name">Customer Insurance Details</field>
            <field name="res_model">orchid.customer.insurance.wiz</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem action="action_customer_insurance_wizard" id="menu_customer_insurance"
            name="Customer Insurance Details" parent="sale.menu_sale_report" sequence="4" groups="account.group_account_invoice" />

    </data>
</odoo>