<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="purchase_register_wizard" model="ir.ui.view">
            <field name="name">Purchase Register</field>
            <field name="model">orchid.purchase.register.wiz</field>
            <field name="arch" type="xml">
                <form string="Sales Register">
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="include_pjr"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name ="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Generate Excel" name="generate_excel" type="object" class="btn-primary"/>
                        <button string="View Report" name="generate_view" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_purchase_register_wizard" model="ir.actions.act_window">
            <field name="name">Purchase Register</field>
            <field name="res_model">orchid.purchase.register.wiz</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem id="purchase_reporting_menu" name="Reporting" parent="purchase.menu_purchase_root" sequence="99"/>

        <menuitem id="purchase.purchase_report" name="Purchase Analysis" parent="purchase_reporting_menu" sequence="1"
        groups="purchase.group_purchase_manager" action="purchase.action_purchase_order_report_all"/>

        <menuitem action="action_purchase_register_wizard" id="menu_purchase_register"
            name="Purchase Register" parent="purchase_reporting_menu" sequence="2" />

    </data>
</odoo>