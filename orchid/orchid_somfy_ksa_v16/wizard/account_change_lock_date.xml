<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="od_view_account_change_lock_date" model="ir.ui.view">
            <field name="name">account.change.lock.date.form</field>
            <field name="model">account.change.lock.date</field>
            <field name="inherit_id" ref="account_accountant.view_account_change_lock_date"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group[1]" position="inside">
                    <group string="Accounts" invisible="1">
                        <field name="od_account_ids" required="1" widget="many2many_tags" force_save="1"/>
                    </group>
                </xpath>
                <xpath expr="//form/sheet/group[1]/group[1]/div[hasclass('text-muted')]" position="before">
                    <label for="od_sale_lock_date"/>
                    <div class="d-flex">
                        <field name="od_sale_lock_date" placeholder="Not locked" class="oe_inline" options="{'warn_future': true}"/>
                    </div>
                    <label for="od_purchase_lock_date"/>
                    <div class="d-flex">
                        <field name="od_purchase_lock_date" placeholder="Not locked" class="oe_inline" options="{'warn_future': true}"/>
                    </div>
                    <label for="od_cashbank_lock_date"/>
                    <div class="d-flex">
                        <field name="od_cashbank_lock_date" placeholder="Not locked" class="oe_inline" options="{'warn_future': true}"/>
                    </div>
                    <label for="od_inventory_lock_date"/>
                    <div class="d-flex">
                        <field name="od_inventory_lock_date" placeholder="Not locked" class="oe_inline" options="{'warn_future': true}"/>
                    </div>
                </xpath>
                <xpath expr="//form/sheet/group[1]/group[1]/div[hasclass('text-muted')]/i[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/sheet/group[1]/group[1]/div[hasclass('text-muted')]/i[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <field name="period_lock_date" position="attributes">
                    <attribute name="string">All Lock Date</attribute>
                </field>
                <xpath expr="//form/sheet/group[1]/group[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>