<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="od_view_stock_quant_in_date_pivot" model="ir.ui.view">
        <field name="name">od.stock.quant.in.date.pivot</field>
        <field name="model">od.stock.quant.in.date</field>
        <field name="arch" type="xml">
            <pivot string="Quantity by In-Date">
                <field name="location_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="od_view_stock_quant_in_date_list" model="ir.ui.view">
        <field name="name">od.stock.quant.in.date.list</field>
        <field name="model">od.stock.quant.in.date</field>
        <field name="arch" type="xml">
            <list string="Quantity by In-Date" create="0" edit="0" delete="0" default_order="in_date desc">
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="brand_id" optional="show"/>
                <field name="classification_id" optional="hide"/>
                <field name="group_id" optional="hide"/>
                <field name="type_id" optional="hide"/>
                <field name="location_id"/>
                <field name="warehouse_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="tracking" optional="hide"/>
                <field name="in_date"/>
                <field name="quantity" sum="Total"/>
                <field name="reserved_qty" sum="Total" optional="show"/>
                <field name="available_quantity" sum="Total" optional="show"/>
                <field name="uom_id" optional="hide"/>
                <field name="cost_method" optional="hide"/>
                <field name="value" sum="Total"/>
                <field name="currency_id" optional="hide" column_invisible="1"/>
                <field name="inventory_quantity_set" optional="hide"/>
                <field name="inventory_quantity" sum="Total" optional="hide"/>
                <field name="inventory_diff_quantity" sum="Total" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="od_view_stock_quant_in_date_search" model="ir.ui.view">
        <field name="name">od.stock.quant.in.date.search</field>
        <field name="model">od.stock.quant.in.date</field>
        <field name="arch" type="xml">
            <search string="Quantity by In-Date">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="warehouse_id"/>
                <field name="lot_id"/>
                <field name="brand_id"/>
                <field name="classification_id"/>
                <field name="group_id"/>
                <field name="categ_id"/>
                <field name="type_id"/>
                <field name="in_date"/>
                <filter string="Today" name="today"
                domain="[('in_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Yesterday" name="yesterday"
                domain="[('in_date', '=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="last_7_days"
                domain="[('in_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last 30 Days" name="last_30_days"
                domain="[('in_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                domain="[('in_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="In Stock" name="has_qty" domain="[('quantity', '&gt;', 0)]"/>
                <filter string="Reserved" name="has_reserved" domain="[('reserved_qty', '&gt;', 0)]"/>
                <filter string="Available" name="has_available" domain="[('available_quantity', '&gt;', 0)]"/>
                <filter string="Not Available" name="no_available" domain="[('available_quantity', '&lt;=', 0)]"/>
                <separator/>
                <filter string="Has Value" name="has_value" domain="[('value', '&gt;', 0)]"/>
                <filter string="No Value" name="no_value" domain="['|', ('value', '=', 0), ('value', '=', False)]"/>
                <separator/>
                <filter string="Inventory Counted" name="inventory_set" domain="[('inventory_quantity_set', '=', True)]"/>
                <filter string="Has Discrepancy" name="has_diff" domain="[('inventory_diff_quantity', '!=', 0)]"/>
                <separator/>
                <filter string="Tracked by Serial" name="tracking_serial" domain="[('tracking', '=', 'serial')]"/>
                <filter string="Tracked by Lot" name="tracking_lot" domain="[('tracking', '=', 'lot')]"/>
                <filter string="Not Tracked" name="tracking_none" domain="[('tracking', '=', 'none')]"/>
                <separator/>
                <filter string="Standard Cost" name="cost_standard" domain="[('cost_method', '=', 'standard')]"/>
                <filter string="FIFO" name="cost_fifo" domain="[('cost_method', '=', 'fifo')]"/>
                <filter string="Average Cost" name="cost_average" domain="[('cost_method', '=', 'average')]"/>
                <separator/>
                <filter string="With Lot/Serial" name="has_lot" domain="[('lot_id', '!=', False)]"/>
                <filter string="No Lot/Serial" name="no_lot" domain="[('lot_id', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Product Category" name="group_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Classification" name="group_classification" context="{'group_by': 'classification_id'}"/>
                    <filter string="Group" name="group_group" context="{'group_by': 'group_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Lot/Serial Number" name="group_lot" context="{'group_by': 'lot_id'}"/>
                    <filter string="Tracking" name="group_tracking" context="{'group_by': 'tracking'}"/>
                    <filter string="Costing Method" name="group_cost_method" context="{'group_by': 'cost_method'}"/>
                    <filter string="In Date" name="group_in_date" context="{'group_by': 'in_date'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_quant_in_date" model="ir.actions.act_window">
        <field name="name">Quantity by In-Date</field>
        <field name="res_model">od.stock.quant.in.date</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="od_view_stock_quant_in_date_search"/>
        <field name="context">{'search_default_has_qty': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                            No data yet.
            </p>
            <p>
                            Same idea as "Quantity by In-Date", but computed live from
                            stock.move.line with a FIFO window function instead of a
                            stored, incrementally-updated table. Only splits by product
                            and location (no lot/package/owner detail).
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_quant_in_date"
        name="Quantity by In-Date"
        action="action_stock_quant_in_date"
        parent="stock.menu_warehouse_report"
        sequence="101"/>

    <record id="od_stock_quant_in_date_sql_company_rule" model="ir.rule">
        <field name="name">Stock Quant In-Date: multi-company</field>
        <field name="model_id" ref="model_od_stock_quant_in_date"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>