<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         AVSS REMITTANCE ADVICE — EXTERNAL LAYOUT (Header + Footer)
    ============================================================ -->
    <template id="remittance_layout">

        <t t-set="company" t-value="o.company_id"/>

        <!-- ================= HEADER ================= -->
        <div class="header" style="display:block; width:100%; margin-bottom:15px;">
            <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important;">
                <tr>
                    <!-- Logo -->
                    <td style="width:130px; vertical-align:middle;">
                        <t t-if="company.logo">
                            <img t-att-src="image_data_uri(company.logo)" style="height:70px;"/>
                        </t>
                    </td>
                    <!-- Company Name + Contact -->
                    <td style="text-align:right; vertical-align:middle;">
                        <div style="font-size:22pt; line-height:1.2;">
                            <!--
                                "AVS" is hard-coded in Magneto font style.
                                "Security Systems LLC" in Calibri as per requirement.
                            -->
                            <span style="font-family:'Magneto', 'Brush Script MT', cursive; font-weight:bold; letter-spacing:2px;">AVS</span>
                            <span style="font-family:'Calibri', sans-serif; font-weight:bold; font-size:18pt; margin-left:8px;">Security Systems LLC</span>
                        </div>
                        <div style="font-family:'Calibri', sans-serif; font-size:10pt; margin-top:5px; color:#333;font-weight:bold;">
                            Tel: <t t-esc="company.phone or ''"/>
                            <t t-if="company.fax_no">, Fax: <t t-esc="company.fax_no"/></t>
                            , www.avssgroup.com
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <!-- ================= BODY ================= -->
        <div class="article" style="display:block; width:100%; clear:both;">
            <t t-out="0"/>
        </div>

        
    </template>


    <!-- ============================================================
         MAIN REMITTANCE ADVICE DOCUMENT
    ============================================================ -->
    <template id="remittance_advice_document">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="remittance_advice.remittance_layout">

                    <div class="page" style="font-family:'Calibri', sans-serif; font-size:10pt;">

                        <!-- ── Title ── -->
                        <div style="margin-bottom:14px;">
                            <table style="border-collapse:collapse; border:1px solid black;">
                                <tr>
                                    <td style="padding:5px 18px; font-weight:bold; font-size:14pt; font-family:'Calibri', sans-serif; letter-spacing:0.5px;">
                                        REMITTANCE ADVICE
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ── Company/Address (left) + Payment Date &amp; Total Paid (right) ── -->
                        <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important; margin-bottom:14px;">
                            <tr>
                                <!-- Left: Vendor / Partner address block -->
                                <td style="vertical-align:top; width:50%;">
                                    <table style="border-collapse:collapse; border:1px solid black; width:auto; min-width:200px;">
                                        <tr>
                                            <td style="padding:8px 12px; vertical-align:top; min-height:60px; line-height:1.6;">
                                                <div><strong>Company Address</strong></div>
                                                <div style="margin-top:4px;">
                                                    <t t-esc="o.partner_id.name or ''"/><br/>
                                                    <t t-if="o.partner_id.street">
                                                        <t t-esc="o.partner_id.street"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.street2">
                                                        <t t-esc="o.partner_id.street2"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.city">
                                                        <t t-esc="o.partner_id.city"/><br/>
                                                    </t>
                                                    <t t-if="o.partner_id.state_id or o.partner_id.country_id">
                                                        <t t-if="o.partner_id.state_id">
                                                            <t t-esc="o.partner_id.state_id.name"/>
                                                            <t t-if="o.partner_id.country_id">, </t>
                                                        </t>
                                                        <t t-if="o.partner_id.country_id">
                                                            <t t-esc="o.partner_id.country_id.name"/>
                                                        </t>
                                                    </t>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>

                                <!-- Right: Payment Date + Total Paid -->
                                <td style="vertical-align:top; width:35%; padding-left:12px;">
                                    <!-- Payment Date -->
                                    <table style="border-collapse:collapse; border:1px solid black; width:100%; margin-bottom:10px;">
                                        <tr>
                                            <td style="padding:6px 10px; font-weight:bold; border-right:1px solid black; white-space:nowrap; width:50%;">
                                                Payment Date:
                                            </td>
                                            <td style="padding:6px 10px; width:50%;">
                                                <t t-esc="o.date and o.date.strftime('%d/%m/%Y') or ''"/>
                                            </td>
                                        </tr>
                                    </table>
                                    <!-- Total Paid -->
                                    <table style="border-collapse:collapse; border:1px solid black; width:100%;">
                                        <tr>
                                            <td style="padding:6px 10px; border-right:1px solid black; width:50%;font-weight:bold;">
                                                Total paid in<br/>this batch:
                                            </td>
                                            <td style="padding:6px 10px; width:50%;">
                                                <t t-esc="'{:,.2f}'.format(o.amount)"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ── Payment Details: Bank / Ref / Currency ── -->
                        <table width="100%" style="border-collapse:collapse; border:1px solid black; margin-bottom:14px;">
                            <tr>
                                <td style="padding:5px 8px; border-bottom:1px solid black; border-right:1px solid black; font-weight:bold; width:16%;">Remitting Bank:</td>
                                <td style="padding:5px 8px; border-bottom:1px solid black; border-right:1px solid black; width:34%;"></td>
                                <td style="padding:5px 8px; border-bottom:1px solid black; border-right:1px solid black; font-weight:bold; width:14%;">Ch:no:</td>
                                <td style="padding:5px 8px; border-bottom:1px solid black; width:36%;"></td>
                            </tr>
                            <tr>
                                <td style="padding:5px 8px; border-bottom:1px solid black; border-right:1px solid black; font-weight:bold;">Payment Batch:</td>
                                <td style="padding:5px 8px; border-bottom:1px solid black; border-right:1px solid black;">
                                    <!-- Batch payment name if available -->
                                    <!-- <t t-if="o.batch_payment_id">
                                        <t t-esc="o.batch_payment_id.name or ''"/>
                                    </t> -->
                                </td>
                                <td style="padding:5px 8px; border-bottom:1px solid black; border-right:1px solid black; font-weight:bold;">Ch: date:</td>
                                <td style="padding:5px 8px; border-bottom:1px solid black;"></td>
                            </tr>
                            <tr>
                                <td style="padding:5px 8px; border-right:1px solid black; font-weight:bold;">Payment Ref:</td>
                                <td style="padding:5px 8px; border-right:1px solid black;">
                                    <!-- Memo field from payment -->
                                    <t t-esc="o.memo or ''"/>
                                </td>
                                <td style="padding:5px 8px; border-right:1px solid black; font-weight:bold;">currency:</td>
                                <td style="padding:5px 8px;">
                                    <t t-esc="o.currency_id.name or ''"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ── Reconciled Invoices Table ── -->
                        <table width="100%" style="border-collapse:collapse; border:1px solid black; margin-bottom:8px;">
                            <colgroup>
                                <col style="width:5%;"/>
                                <col style="width:12%;"/>
                                <col style="width:14%;"/>
                                <col style="width:14%;"/>
                                <col style="width:27%;"/>
                                <col style="width:14%;"/>
                                <col style="width:14%;"/>
                            </colgroup>
                            <thead>
                                <tr style="background-color:#e8e8e8;">
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">Sl<br/>no</td>
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">Invoice<br/>Date</td>
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">IN: no</td>
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">PO<br/>number</td>
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">Description</td>
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">Amount</td>
                                    <td style="border:1px solid black; padding:5px 4px; text-align:center; font-weight:bold;">Remark</td>
                                </tr>
                            </thead>
                            <tbody>

                                <!-- Loop through reconciled invoices -->
                                <t t-set="sr_no" t-value="0"/>
                                <t t-foreach="o.reconciled_invoice_ids" t-as="inv">
                                    <t t-set="sr_no" t-value="sr_no + 1"/>
                                    <tr>
                                        <td style="border:1px solid black; padding:4px 4px; text-align:center; vertical-align:top;">
                                            <t t-esc="sr_no"/>
                                        </td>
                                        <td style="border:1px solid black; padding:4px 6px; text-align:center; vertical-align:top;">
                                            <t t-esc="inv.invoice_date and inv.invoice_date.strftime('%d/%m/%Y') or ''"/>
                                        </td>
                                        <td style="border:1px solid black; padding:4px 6px; text-align:center; vertical-align:top;">
                                            <!-- Invoice Number -->
                                            <t t-esc="inv.name or ''"/>
                                        </td>
                                        <td style="border:1px solid black; padding:4px 6px; text-align:center; vertical-align:top;">
                                            <!-- Customer Reference (PO Number) from Invoice -->
                                            <t t-esc="inv.ref or ''"/>
                                        </td>
                                        <td style="border:1px solid black; padding:4px 6px; vertical-align:top;">
                                            <!-- Description: payment_reference or narration -->
                                            <!-- <t t-esc="inv.payment_reference or inv.invoice_origin or ''"/> -->
                                        </td>
                                        <td style="border:1px solid black; padding:4px 6px; text-align:right; vertical-align:top;">
                                            <t t-esc="'{:,.2f}'.format(inv.amount_total)"/>
                                        </td>
                                        <td style="border:1px solid black; padding:4px 6px; vertical-align:top;"></td>
                                    </tr>
                                </t>

                                <!-- Filler rows — minimum 10 rows always shown -->
                                <t t-set="filled" t-value="len(o.reconciled_invoice_ids)"/>
                                <t t-set="min_rows" t-value="10"/>
                                <t t-if="filled &lt; min_rows">
                                    <t t-foreach="range(min_rows - filled)" t-as="empty">
                                        <tr style="height:22px;">
                                            <td style="border-left:1px solid black; border-right:1px solid black;"></td>
                                            <td style="border-right:1px solid black;"></td>
                                            <td style="border-right:1px solid black;"></td>
                                            <td style="border-right:1px solid black;"></td>
                                            <td style="border-right:1px solid black;"></td>
                                            <td style="border-right:1px solid black;"></td>
                                            <td style="border-right:1px solid black;"></td>
                                        </tr>
                                    </t>
                                </t>

                                <!-- Total Amount Row -->
                                <tr>
                                    <td colspan="5" style="border:1px solid black; padding:5px 8px; text-align:center; font-weight:bold;">
                                        Total Amount
                                    </td>
                                    <td style="border:1px solid black; padding:5px 8px; text-align:right; font-weight:bold;">
                                        <t t-esc="'{:,.2f}'.format(o.amount)"/>
                                    </td>
                                    <td style="border:1px solid black; padding:5px 8px;"></td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </t>

            </t>
        </t>
    </template>

</odoo>
