<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 🔹 Manager Notification -->
        <record id="email_template_membership_manager" model="mail.template">
            <field name="name">Membership: Manager Notification</field>
            <field name="model_id" ref="slmq_customization.model_membership_membership"/>
            <field name="subject">New Membership - {{object.name}}</field>
            <field name="body_html" type="html">
            
                <p>Hi,</p>

                <p><b>A new membership application has been submitted with the following details:</b></p>

                <p>
                    <b>Registration No:</b> <t t-out="object.name"/><br/>
                    <b>Name:</b> <t t-out="object.partner_name"/><br/>
                    <b>Email:</b> <t t-out="object.email"/><br/>
                    <b>Phone:</b> <t t-out="object.phone"/>
                </p>

                 <p>
                    <a t-att-href="'/web#id=%s&amp;model=membership.membership&amp;view_type=form' % object.id"
                        style="padding:10px;background-color:#875A7B;color:white;text-decoration:none;border-radius:5px;">
                            View Membership
                    </a>
                </p>

                <br/>

                <p>Thank you,<br/>
                <b>SRI LANKAN MAJLIS – QATAR (SLMQ)</b></p>

            </field>
        </record>


        <!-- 🔹 Membership Created -->
        <record id="email_template_membership_created" model="mail.template">
            <field name="name">Membership Created</field>
            <field name="model_id" ref="slmq_customization.model_membership_membership"/>
            <field name="subject">Membership Created - {{object.name}}</field>
            <field name="body_html" type="html">

                <t t-if="ctx.get('is_parent')">
                    <p>Dear <t t-out="object.parent_id.partner_name or 'Member'"/>,</p>

                    <p>
                        A membership request has been submitted for 
                        <b><t t-out="object.partner_name or 'Member'"/></b> under your membership.
                    </p>

                    <p>
                        <b>Name:</b> <t t-out="object.partner_name"/><br/>
                        <b>Registration No:</b> <t t-out="object.name"/>
                    </p>

                    <p>Our team will review the request and keep you informed.</p>

                    <br/>

                    <p>
                        Thank you,<br/>
                        <b>SRI LANKAN MAJLIS – QATAR (SLMQ)</b>
                    </p>
                </t>

                <t t-else="">
                    <p>Dear <t t-out="object.partner_name"/>,</p>

                    <p>Your membership request has been successfully created.</p>

                    <p>
                        <b>Registration No:</b> <t t-out="object.name"/>
                    </p>

                    <p>We will review your request and get back to you soon.</p>

                    <br/>

                    <p>Thank you,<br/>
                    <b>SRI LANKAN MAJLIS – QATAR (SLMQ)</b></p>
                </t>

            </field>
        </record>


        <!-- 🔹 Membership Confirm -->
        <record id="email_template_membership_confirm" model="mail.template">
            <field name="name">Membership Confirmed</field>
            <field name="model_id" ref="slmq_customization.model_membership_membership"/>
            <field name="subject">Membership Approved - {{object.name}}</field>
            <field name="body_html" type="html">

                <p>Dear <t t-out="object.partner_name"/>,</p>

                <p>Your membership has been <b>approved</b>.</p>

                <p>
                    <b>Registration No:</b> <t t-out="object.name"/>
                </p>

                <p>
                    <b>Username:</b> <t t-out="ctx.get('login')"/><br/>
                    <b>Password:</b> <t t-out="ctx.get('password')"/>
                </p>

                <p>Please use these credentials to log in to the system.</p>

                <br/>

                <p>
                    Thank you,<br/>
                    <b>SRI LANKAN MAJLIS – QATAR (SLMQ)</b>
                </p>

            </field>
        </record>


        <!-- 🔹 Membership Reject -->
        <record id="email_template_membership_reject" model="mail.template">
            <field name="name">Membership Rejected</field>
            <field name="model_id" ref="slmq_customization.model_membership_membership"/>
            <field name="subject">Membership Rejected - {{object.name or 'N/A'}}</field>
            <field name="body_html" type="html">

                <p>Dear <t t-out="object.partner_name or 'Member'"/>,</p>

                <p>
                    We regret to inform you that your membership request has been 
                    <b>rejected</b>.
                </p>

                <p>
                    <b>Registration No:</b> <t t-out="object.name"/>
                </p>

                <p>
                    If you have any questions or would like further clarification, 
                    please feel free to contact us.
                </p>

                <br/>

                <p>
                    Thank you,<br/>
                    <b>SRI LANKAN MAJLIS – QATAR (SLMQ)</b>
                </p>

            </field>
        </record>

    </data>
</odoo>