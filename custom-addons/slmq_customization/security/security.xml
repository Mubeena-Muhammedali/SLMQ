<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_membership">
        <field name="name">Membership</field>
        <field name="sequence">50</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_membership">
        <field name="name">Membership</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="slmq_customization.module_membership"/>
    </record>

    <record id="group_membership_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_membership"/>
    </record>

    <record id="group_membership_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_membership"/>
        <field name="implied_ids" eval="[(4, ref('slmq_customization.group_membership_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('slmq_customization.group_membership_manager'))]"/>
    </record>

    
</odoo>