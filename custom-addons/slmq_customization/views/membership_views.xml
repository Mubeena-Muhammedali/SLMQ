<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_form" model="ir.ui.view">
        <field name="name">membership.form</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    <button name="action_draft" type="object" string="Reset to Draft" class="btn-primary" invisible="state != 'reject'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'draft'"/>
                </header>
                <sheet>
                   <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_children"
                                class="oe_stat_button" icon="fa-users" invisible="child_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text"><field name="child_count"/>Child</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_name" readonly="state != 'draft'"/>
                            <field name="email" readonly="state != 'draft'"/>
                            <field name="phone" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="member_type" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1" force_save="1" invisible="not partner_id"/>
                            <field name="is_child" readonly="state != 'draft'"/>
                            <field name="parent_id" invisible="not is_child" required="is_child" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_membership_tree" model="ir.ui.view">
        <field name="name">membership.list</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="member_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_membership_search" model="ir.ui.view">
        <field name="name">membership.search</field>
        <field name="model">membership.membership</field>
        <field name="arch" type="xml">
            <search string="Search Membership">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="partner_name"/>
                <field name="email"/>
                <field name="phone"/>

                <!-- Filters -->
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirm" domain="[('state','=','confirm')]"/>
                <filter string="Rejected" name="reject" domain="[('state','=','reject')]"/>

                <!-- Group By -->
                <group>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Member Type" name="group_member" context="{'group_by':'member_type'}"/>
                    <separator/>
                    <filter string="Parent" name="group_parent" context="{'group_by':'parent_id'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_membership" model="ir.actions.act_window">
        <field name="name">Membership</field>
        <field name="res_model">membership.membership</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_root" name="Membership" web_icon="slmq_customization,static/description/icon.png"/>
    <menuitem id="menu_members" name="Members" parent="menu_root" action="action_membership"/>
</odoo>