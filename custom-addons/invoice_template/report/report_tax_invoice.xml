<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <template id="avss_external_layout">

        <t t-set="company" t-value="o.company_id"/>

        <!-- WRAPPER -->
        <div style="width:100%;">

            <!-- ================= HEADER ================= -->
            <div class="header" style="display:block; width:100%; margin-bottom:15px;">

                <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important;">
                    <tr style="border-collapse:separate !important; border-spacing:0 !important;">
                        <td style="border-collapse:separate !important; border-spacing:0 !important;width:90px;">
                            <t t-if="company.logo">
                                <img t-att-src="image_data_uri(company.logo)" style="height:65px;"/>
                            </t>
                        </td>
                        <td style="text-align:right;border-collapse:separate !important; border-spacing:0 !important;">
                            <div style="font-size:16pt; font-weight:bold;">
                                <t t-esc="company.name"/>
                            </div>
                            <div style="font-size:12pt;">www.avssgroup.com</div>
                        </td>
                    </tr>
                </table>

                <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important;">
                    <tr style="border-collapse:separate !important; border-spacing:0 !important;">
                        <td style="font-size:14pt; font-weight:bold;border-collapse:separate !important; border-spacing:0 !important;">
                            Tax Invoice
                        </td>
                        <td style="text-align:right; font-weight:bold;border-collapse:separate !important; border-spacing:0 !important;">
                            TRN : <t t-esc="company.vat or ''"/>
                        </td>
                    </tr>
                </table>

            </div>
        </div>

        <!-- ================= BODY ================= -->
        <div class="article" style="display:block; width:100%; clear:both;">
            <t t-out="0"/>
        </div>

        <!-- ================= FOOTER ================= -->
        <div class="footer" style="display:block; width:100%; margin-top:10px;">
            
            <!-- ⚠️ THIS IS NOT TABLE BORDER -->
            <!-- If you want no line, remove this -->
            <div style="border-top:1px solid black;background-color: black;"></div>

            <div style="text-align:center; font-size:9pt;">
                <strong>
                    <t t-esc="company.name"/><br/>
                    <t t-esc="company.street or ''"/>
                    <t t-if="company.street2">, <t t-esc="company.street2"/></t>
                    <t t-if="company.city">, <t t-esc="company.city"/></t>
                    <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                    <t t-if="company.country_id">, <t t-esc="company.country_id.name"/></t>
                    <br/>
                    Tel: <t t-esc="company.phone or ''"/>
                    , Fax: <t t-esc="company.fax_no or ''"/>
                    , E-Mail: <t t-esc="company.email or ''"/>
                </strong>
            </div>
        </div>

    </template>


    <!-- ============================================================
         MAIN INVOICE TEMPLATE
    ============================================================ -->
    <template id="tax_invoice_document">
        <t t-call="web.html_container">
            
            <t t-foreach="docs" t-as="o">
                
                <t t-call="invoice_template.avss_external_layout">
                    <div class="page">
                    <!-- ── Customer + Invoice Details ── -->
                    <table width="100%" style="border-collapse:collapse; border:1px solid black; margin-bottom:4px; table-layout:fixed; font-size:11pt;">
                        <colgroup><col style="width:55%;"/><col style="width:45%;"/></colgroup>
                        <tr>
                            <td style="vertical-align:top; padding:0; border-right:1px solid black;">
                                <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important;">
                                    <tr>
                                        <td style="padding:5px 8px;">
                                            <strong>Company Name : <t t-esc="o.partner_id.name or ''"/></strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 8px; vertical-align:top; height:80px;">
                                            <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important;">
                                                <tr>
                                                    <td style="width:90px; vertical-align:top;"><strong>Address</strong></td>
                                                    <td style="vertical-align:top;"><strong>:
                                                        <t t-esc="o.partner_id.street or ''"/>
                                                        <t t-if="o.partner_id.street2">, <t t-esc="o.partner_id.street2"/></t>
                                                        <t t-if="o.partner_id.city">, <t t-esc="o.partner_id.city"/></t>
                                                        <t t-if="o.partner_id.state_id">, <t t-esc="o.partner_id.state_id.name"/></t>
                                                        <t t-if="o.partner_id.country_id">, <t t-esc="o.partner_id.country_id.name"/></t>
                                                    </strong></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 8px; border-bottom:1px solid black; border-right:none;">
                                            <strong>Tel : <t t-esc="o.partner_id.phone or ''"/></strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 8px; border-bottom:1px solid black; border-right:none;">
                                            <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important;">
                                                <tr>
                                                    <td style="width:55%;"><strong>TRN : <t t-esc="o.partner_id.vat or ''"/></strong></td>
                                                    <td><strong>Payment : <t t-esc="o.invoice_payment_term_id.name or ''"/></strong></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 8px;">
                                            <strong>Project : </strong>
                                            <t t-set="sale_orders" t-value="o.invoice_line_ids.mapped('sale_line_ids.order_id')"/>
                                            <t t-if="sale_orders">
                                                <t t-esc="sale_orders[0].project_id.name or ''"/>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="vertical-align:top; padding:0;">
                                <table width="100%" style="border-collapse:collapse; table-layout:fixed;">
                                    <colgroup><col style="width:48%;"/><col style="width:52%;"/></colgroup>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">Invoice No</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"><t t-esc="o.name or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">Date</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"><t t-esc="o.invoice_date and o.invoice_date.strftime('%d/%m/%Y') or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">JBIN No</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"><t t-esc="o.ref or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">Delivery / PPM No</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">LPO No</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">Qut / AMC Ref#</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid black; border-right:1px solid black; padding:5px 8px; font-weight:bold;">Customer ID</td>
                                        <td style="border-bottom:1px solid black; padding:5px 8px;"><t t-esc="o.partner_id.company_registry or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right:1px solid black; padding:5px 8px; font-weight:bold;">GRN No</td>
                                        <td style="padding:5px 8px;"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table width="100%" style="border-collapse:collapse; border:1px solid black; margin-bottom:1px; table-layout:fixed;">
                        <colgroup>
                            <col style="width:4%;"/>
                            <col style="width:33%;"/>
                            <col style="width:5%;"/>
                            <col style="width:6%;"/>
                            <col style="width:10%;"/>
                            <col style="width:13%;"/>
                            <col style="width:6%;"/>
                            <col style="width:10%;"/>
                            <col style="width:13%;"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">Sr.<br/>No.</td>
                                <td style="border:1px solid black; padding:3px 4px; text-align:center; font-size:11pt; font-weight:bold;">Particular</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">QTY</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">Unit</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">Rate</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">Amount<br/>Excl. of<br/>VAT (AED)</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">VAT<br/>(%)</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">VAT<br/>Amt<br/>(AED)</td>
                                <td style="border:1px solid black; padding:3px 2px; text-align:center; font-size:11pt; font-weight:bold;">Amount<br/>Inc. of<br/>VAT (AED)</td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sr_no" t-value="0"/>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <t t-if="line.display_type == 'product'">
                                    <t t-set="sr_no" t-value="sr_no + 1"/>
                                    <tr>
                                        <td style="border:1px solid black; padding:3px 2px; text-align:center; vertical-align:top; font-size:10pt;"><t t-esc="sr_no"/></td>
                                        <td style="border:1px solid black; padding:3px 4px; vertical-align:top; font-size:10pt;"><t t-esc="line.name"/></td>
                                        <td style="border:1px solid black; padding:3px 2px; text-align:center; vertical-align:top; font-size:10pt;">
                                            <t t-esc="int(line.quantity) if line.quantity == int(line.quantity) else line.quantity"/>
                                        </td>
                                        <td style="border:1px solid black; padding:3px 2px; text-align:center; vertical-align:top; font-size:10pt;">
                                            <t t-esc="line.product_uom_id.name if line.product_uom_id else ''"/>
                                        </td>
                                        <td style="border:1px solid black; padding:3px 4px; text-align:right; vertical-align:top; font-size:10pt;">
                                            <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                        </td>
                                        <td style="border:1px solid black; padding:3px 4px; text-align:right; vertical-align:top; font-size:10pt;">
                                            <t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                        </td>
                                        <td style="border:1px solid black; padding:3px 2px; text-align:center; vertical-align:top; font-size:10pt;">
                                            <t t-if="line.tax_ids">
                                                <t t-esc="'{:.0f} %'.format(sum(t.amount for t in line.tax_ids))"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid black; padding:3px 4px; text-align:right; vertical-align:top; font-size:10pt;">
                                            <t t-esc="'{:,.2f}'.format(line.price_total - line.price_subtotal)"/>
                                        </td>
                                        <td style="border:1px solid black; padding:3px 4px; text-align:right; vertical-align:top; font-size:10pt;">
                                            <t t-esc="'{:,.2f}'.format(line.price_total)"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <!-- Empty filler rows (only when lines ≤ 15) -->
                            <t t-set="filled_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
                            <t t-set="line_count" t-value="len(filled_lines)"/>
                            <t t-set="max_rows" t-value="15"/>
                            <t t-if="line_count &lt;= max_rows">
                                <t t-foreach="range(max_rows - line_count)" t-as="empty_row">
                                    <tr style="height:20px;">
                                        <td style="border-left:1px solid black; border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                        <td style="border-right:1px solid black;"></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- ── Amount in Words ── -->
                    <div style="margin:6px 0 4px 0; font-size:10pt;">
                        <strong>Amount In Words (AED) :</strong>
                        <span style="margin-left:5px;">
                            <strong><t t-esc="o._get_amount_in_words()"/></strong>
                        </span>
                    </div>

                    <!-- ── Bank Details + Totals ── -->
                    <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important; margin-top:5px; margin-bottom:2px;">
                        <tr>
                            <td style="width:60%; vertical-align:top; font-size:10pt; padding-right:10px;">
                                <div><strong><u>Bank Details :</u></strong></div>
                                <div style="margin-top:5px; line-height:1.6;">
                                    <div>
                                        <t t-set="bank" t-value="o.company_id.partner_id.bank_ids[0] if o.company_id.partner_id.bank_ids else False"/>
                                        <t t-if="bank">
                                            <div>Account Name: <t t-esc="bank.acc_holder_name or o.company_id.name"/></div>
                                            <div>Account Number: <t t-esc="bank.acc_number"/></div>
                                            <div>IBAN:</div>
                                            <div>Swift Code: <t t-esc="bank.bank_bic or ''"/></div>
                                            <div>Bank Name: <t t-esc="bank.bank_id.name or ''"/></div>
                                            <div>Branch and Bank Address: <t t-esc="bank.bank_id.city or ''"/>
                                                <t t-if="bank.bank_id.city and bank.bank_id.state.name">, </t>
                                                <t t-esc="bank.bank_id.state.name or ''"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </td>
                            <td style="width:40%; vertical-align:top;">
                                <table width="100%" style="border-collapse:collapse; border:1px solid black; font-size:10pt;">
                                    <tr>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; border-right:1px solid black;">Sub Total (AED)</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; text-align:right;"><t t-esc="'{:,.2f}'.format(o.amount_untaxed)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; border-right:1px solid black;">Discount</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; text-align:right;">0.00</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; border-right:1px solid black;">Gross Total (AED)</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; text-align:right;"><t t-esc="'{:,.2f}'.format(o.amount_untaxed)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; border-right:1px solid black;">VAT 5% (AED)</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid black; text-align:right;"><t t-esc="'{:,.2f}'.format(o.amount_tax)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:8px; border-right:1px solid black;"><strong>Net Amount (AED)</strong></td>
                                        <td style="padding:8px; text-align:right;"><strong><t t-esc="'{:,.2f}'.format(o.amount_total)"/></strong></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- ── Signature Section ── -->
                    <table width="100%" style="border-collapse:separate !important; border-spacing:0 !important; font-size:10pt; margin-top:4px;">
                        <tr>
                            <td style="padding:6px 0; width:50%;">Receiver Name :</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0;">Receiver Sign &amp; Stamp :</td>
                            <td style="text-align:right;">For <strong><t t-esc="o.company_id.name"/></strong></td>
                        </tr>
                    </table>
                    </div>

                </t>
                
            </t>
        </t>
    </template>

</odoo>