<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Custom Paper Format -->
    <record id="paperformat_tax_invoice" model="report.paperformat">
        <field name="name">Tax Invoice Paper</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>

        <!-- REMOVE TOP SPACE -->
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="orientation">Landscape</field>

        <!-- HEADER/FOOTER CONTROL -->
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>

        <!-- DPI -->
        <field name="dpi">90</field>
    </record>
    
    <!--  Register the PDF report action  -->
    <record id="tax_invoice_report_action" model="ir.actions.report">
        <field name="name">Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_template.tax_invoice_document</field>
        <field name="report_file">invoice_template.tax_invoice_document</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="invoice_template.paperformat_tax_invoice"/>
        <field name="binding_type">report</field>
    </record>

    
</odoo>
