<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.whatsapp</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='website_info_settings']" position="before">
        <h2>WhatsApp</h2>
        <div class="row mt16 o_settings_container" id="wa_settings">
          <div class="col-12 col-lg-6 o_setting_box">
            <div class="o_setting_left_pane">
              <field name="wa_enabled"/>
            </div>
            <div class="o_setting_right_pane">
              <label for="wa_enabled"/>
              <div class="text-muted">
                Display a floating WhatsApp chat button on your website
              </div>
              <div invisible="not wa_enabled" class="mt8">
                <div class="row">
                  <label for="wa_phone" class="col-lg-4 o_light_label"/>
                  <field name="wa_phone" placeholder="+261340000000"/>
                </div>
                <div class="row mt8">
                  <label for="wa_default_message" class="col-lg-4 o_light_label"/>
                  <field name="wa_default_message" placeholder="Hello! I have a question."/>
                </div>
                <div class="row mt8">
                  <label for="wa_tooltip" class="col-lg-4 o_light_label"/>
                  <field name="wa_tooltip" placeholder="Chat with us on WhatsApp"/>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6 o_setting_box" invisible="not wa_enabled">
            <div class="o_setting_left_pane"/>
            <div class="o_setting_right_pane">
              <span class="o_form_label">Appearance</span>
              <div class="text-muted">
                Customize the button look and position
              </div>
              <div class="mt8">
                <div class="row">
                  <label for="wa_position" class="col-lg-4 o_light_label"/>
                  <field name="wa_position"/>
                </div>
                <div class="row mt8">
                  <label for="wa_size" class="col-lg-4 o_light_label"/>
                  <field name="wa_size"/>
                </div>
                <div class="row mt8">
                  <label for="wa_color" class="col-lg-4 o_light_label"/>
                  <field name="wa_color" widget="color"/>
                </div>
                <div class="row mt8">
                  <label for="wa_pulse" class="col-lg-4 o_light_label"/>
                  <field name="wa_pulse"/>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6 o_setting_box" invisible="not wa_enabled">
            <div class="o_setting_left_pane">
              <field name="wa_business_hours"/>
            </div>
            <div class="o_setting_right_pane">
              <label for="wa_business_hours"/>
              <div class="text-muted">
                Only show the button during business hours
              </div>
              <div invisible="not wa_business_hours" class="mt8">
                <div class="row">
                  <label for="wa_hour_from" class="col-lg-4 o_light_label"/>
                  <field name="wa_hour_from" widget="float_time"/>
                </div>
                <div class="row mt8">
                  <label for="wa_hour_to" class="col-lg-4 o_light_label"/>
                  <field name="wa_hour_to" widget="float_time"/>
                </div>
                <div class="row mt8">
                  <label for="wa_days" class="col-lg-4 o_light_label"/>
                  <field name="wa_days" placeholder="1,2,3,4,5"/>
                </div>
                <div class="text-muted mt4">
                  Days: 1=Monday, 2=Tuesday, ..., 7=Sunday
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>

</odoo>
