<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Floating WhatsApp button injected on all website pages -->
  <template id="whatsapp_float_button" inherit_id="website.layout" name="WhatsApp Float Button">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
      <t t-set="wa" t-value="website"/>
      <div t-if="wa.wa_enabled and wa.wa_phone"
           id="itsm_wa_float"
           t-attf-class="itsm-wa-float itsm-wa-{{ wa.wa_position or 'bottom-right' }} itsm-wa-{{ wa.wa_size or 'medium' }}"
           t-att-data-phone="wa.wa_phone"
           t-att-data-message="wa.wa_default_message or ''"
           t-att-data-tooltip="wa.wa_tooltip or ''"
           t-att-data-color="wa.wa_color or '#25D366'"
           t-att-data-pulse="'1' if wa.wa_pulse else '0'"
           t-att-data-business-hours="'1' if wa.wa_business_hours else '0'"
           t-att-data-hour-from="wa.wa_hour_from or 8"
           t-att-data-hour-to="wa.wa_hour_to or 18"
           t-att-data-days="wa.wa_days or '1,2,3,4,5'"
           style="display:none;">

        <!-- Tooltip -->
        <span class="itsm-wa-tooltip" t-if="wa.wa_tooltip">
          <t t-esc="wa.wa_tooltip"/>
          <span class="itsm-wa-tooltip-close">&#215;</span>
        </span>

        <!-- Button -->
        <a class="itsm-wa-btn" href="#" role="button"
           aria-label="Chat on WhatsApp" rel="noopener noreferrer">
          <svg viewBox="0 0 32 32" class="itsm-wa-icon">
            <path d="M16.004 0h-.008C7.174 0 0 7.176 0 16c0 3.5 1.132 6.744 3.052 9.38L1.056 31.5l6.322-2.012C9.926 31.108 12.868 32 16.004 32 24.826 32 32 24.822 32 16S24.826 0 16.004 0zm9.342 22.616c-.39 1.1-1.936 2.014-3.168 2.28-.844.18-1.946.322-5.66-1.216-4.752-1.968-7.808-6.788-8.044-7.104-.228-.316-1.912-2.548-1.912-4.86s1.21-3.448 1.64-3.92c.43-.472.94-.59 1.254-.59.312 0 .626.002.898.016.288.014.676-.11 1.058.806.39.94 1.328 3.236 1.444 3.47.116.236.194.51.04.824-.156.316-.234.512-.468.788-.234.278-.492.62-.702.832-.234.234-.478.488-.206.958.272.468 1.212 2 2.602 3.242 1.786 1.594 3.29 2.088 3.758 2.322.468.234.742.196 1.014-.118.272-.314 1.172-1.37 1.484-1.84.312-.472.624-.39 1.054-.234.43.156 2.724 1.284 3.192 1.518.468.234.78.352.898.546.114.194.114 1.132-.278 2.232z"
                  fill="currentColor"/>
          </svg>
        </a>

        <!-- Pulse ring -->
        <span class="itsm-wa-pulse" t-if="wa.wa_pulse"/>
      </div>
    </xpath>
  </template>

</odoo>
