<odoo>

    <record id="seq_garage_estimation" model="ir.sequence">
        <field name="name">Garage Estimation</field>
        <field name="code">garage.estimation</field>
        <field name="prefix">EST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_garage_job" model="ir.sequence">
        <field name="name">Garage Job</field>
        <field name="code">garage.job</field>
        <field name="prefix">JOB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <data noupdate="1">
        <record id="garage_job_plan_default" model="account.analytic.plan">
            <field name="name">Garage Job Plan</field>
        </record>
    </data>
    
</odoo>