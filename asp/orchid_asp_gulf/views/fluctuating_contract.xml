<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="od_fluctuating_contract_tree_view">
            <field name="name">od.fluctuating.contract.tree</field>
            <field name="model">od.fluctuating.contract</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Fluctuating Services" default_order="id desc">
                    <field name="name"/>
                    <field name="contract_name"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="od_fluctuating_contract_form_view">
            <field name="name">od.fluctuating.contract.form</field>
            <field name="model">od.fluctuating.contract</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Fluctuating Services">
                    <header>
                        <button name="button_validate" string="Validate" invisible="state != 'draft'" class="oe_highlight" type="object"/>
                        <button name="button_reset" string="Reset to Draft" invisible="state != 'validate'" type="object"/>
                        <button name="button_approve" string="Approve" invisible="state != 'validate'" class="oe_highlight" type="object" confirm="Are you sure that you want to approve the record?"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="state != 'draft'"/>
                                <field name="contract_name" readonly="1"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <field name="remarks" placeholder="Remarks...."/>
                        <notebook>
                            <page string="Service Lines" name="fluctuating_line_ids">
                                <field name="fluctuating_line_ids" mode="list"  readonly="state != 'draft'">
                                    <list editable="top">
                                        <field name="contract_line_id"/>
                                        <field name="product_id" optional="hide"/>
                                        <field name="old_desc"/>
                                        <field name="new_desc"/>
                                        <field name="start_date"/>
                                        <field name="current_qty" readonly="1"/>
                                        <field name="frequency"/>
                                        <field name="new_qty"/>
                                        <field name="revised_qty"/>
                                        <field name="termination_date"
                                            invisible="revised_qty >= 0"
                                            required="revised_qty &lt; 0"/>

                                        <field name="termination_reason"
                                            invisible="revised_qty >= 0"
                                            required="revised_qty &lt; 0"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="form_id" invisible="1"/>
                                        <field name="contract_id" invisible="1"/>
                                        <field name="new_contract_line_id" invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="od_fluctuating_contract_filter_view">
            <field name="name">od.fluctuating.contract.filter</field>
            <field name="model">od.fluctuating.contract</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Contract">
                    <field name="name"/>
                    <group>
                        <filter name="contractid" string="Contract" context="{'group_by': 'name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_od_fluctuating_contract_view">
            <field name="name">Fluctuating Services</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">od.fluctuating.contract</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="od_fluctuating_contract_tree_view"/>
            <field name="search_view_id" ref="od_fluctuating_contract_filter_view"/>
        </record>

       
    </data>
</odoo>

