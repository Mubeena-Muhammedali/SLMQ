<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="sale_order_view_form_inherit_asp_gulf" model="ir.ui.view">
      <field name="name">sale.order.form.aspgulf</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <field name="partner_id" position="after">
          <field name="od_contact_id"
                readonly="state != 'draft'"
                context="{'default_parent_id': partner_id}"/>

          <field name="od_contract_id"
                invisible="state not in ['sale', 'done']"
                context="{'default_partner_id': partner_id}"/>
        </field>

        <field name="payment_term_id" position="after">

          <field name="od_exchange_rate"
                readonly="state != 'draft'"
                digits="[12,12]"/>

          <field name="print_options"
                readonly="state != 'draft'"/>

          <field name="od_incl_service_commitments"
                invisible="currency_id != 131"/>

          <field name="od_primary_quotation"
                readonly="state != 'draft'"/>

      </field>

        <page name="other_information" position="after">
          <page string="Terms and Conditions" name="terms_n_conditions">
            <field name="od_sale_terms" type="html" string="Sale Terms"/>
    
            <field name="od_service_commitments" string="Service Commitments &amp; Exclusions" type="html" placeholder="AED Proforma SERVICE COMMITMENTS &amp; EXCLUSIONS." invisible="currency_id != 131"/>
          </page>
        </page>
        <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/list/field[@name='name']" position="after">
          <field name="od_description_sale" widget="html" optional="hide"/>
        </xpath>
        <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/list/field[@name='price_unit']" position="after">
          <field name="od_frequency"/>
        </xpath>
        <field name="note" position="replace">
          <field name="note" nolabel="1" placeholder="notes..."/>
        </field>
        <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="after">
          <field name="od_disc_amount" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="replace">
          <field name="discount" string="Disc.%" groups="sale.group_discount_per_so_line" optional="show" widget="product_discount" readonly="1" force_save="1"/>
        </xpath>
        <button name="action_view_invoice" position="after">
          <button name="od_open_contracts" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Contract" invisible="state not in ['sale', 'done']">
        </button>
        <button name="%(sale.action_view_sale_advance_payment_inv)d" position="attributes">
          <attribute name="invisible">True</attribute>
        </button>
        </button>
        <field name="campaign_id" position="attributes">
          <attribute name="required">1</attribute>
          <attribute name="string">Channel</attribute>
        </field>
        <field name="medium_id" position="attributes">
          <attribute name="required">1</attribute>
          <attribute name="domain">[('od_channel_id','=',campaign_id)]</attribute>
        </field>
        <field name="source_id" position="attributes">
          <attribute name="required">1</attribute>
          <attribute name="domain">[('od_channel_id','=',campaign_id)]</attribute>
        </field>
        <xpath expr="//form/header/button[@name='action_draft']" position="replace">
           <button name="action_draft" type="object" string="Set to Quotation" 
            invisible="state != 'cancel'"/>
        </xpath>
      </field>
    </record> 

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
      <field name="name">Quotations</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">sale.order</field>
      <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
      <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
      <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
      <field name="domain">[('state', 'in', ('draft', 'sent', 'waiting','sale','done','cancel'))]</field>
      <field name="context">{'search_default_my_quotation': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create a new quotation, the first step of a new sale!
        </p><p>
          Once the quotation is confirmed by the customer, it becomes a sales order.<br/> You will be able to create an invoice and collect the payment.
        </p>
      </field>
    </record>
  </data>
</odoo>