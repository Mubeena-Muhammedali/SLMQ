<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <field name="invoice_date" position="after">
                <field name="od_exchange_rate"
                       readonly="state != 'draft'"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </field>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="od_frequency"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='sequence']" position="after">
                <field name="od_period_from"/>
                <field name="od_period_to"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='currency_id']" position="after">
                <field name="od_frequency" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='sequence']" position="after">
                <field name="od_period_from" invisible="1"/>
                <field name="od_period_to" invisible="1"/>
            </xpath>

            <field name="partner_shipping_id" position="after">
                <field name="move_type"
                       readonly="1"
                       force_save="1"
                       groups="base.group_no_one"/>

                <field name="od_contact_id"
                       invisible="move_type == 'entry'"
                       required="move_type in ('out_invoice', 'out_refund')"
                       options="{'no_create': True, 'no_create_edit': True}"/>

                <field name="od_contract_id"
                       readonly="1"
                       force_save="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True, 'no_create_edit': True}"/>

                <field name="od_contract_name"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
            <field name="ref" position="after">
                <field name="od_is_bank_voucher" invisible="1" />
                <field name="od_reveiew" invisible="1" readonly="state != 'draft'"/>
                <field name="od_check_date" invisible="1"/>
                <field name="od_check_to" invisible="1"/>
                <field name="od_acc_payee" invisible="1" force_save="1"/>
            </field>
            <xpath expr="//form/header/button[1]" position="attributes">
                <attribute name="invisible">
                    state not in ['draft', 'submit'] or auto_post or move_type != 'entry'
                </attribute>
            </xpath>
            <button name="action_post" position="after">
                <button name="od_button_submit" string="Submit" class="oe_highlight" type="object" groups="account.group_account_invoice" invisible="state != 'draft' or not od_is_bank_voucher or not od_reveiew"/>
            </button>

        </field>
    </record>

</odoo>
