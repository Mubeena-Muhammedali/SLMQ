<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="asp_sale_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12 text-center">
                                <h3><t t-if="o.print_options=='proforma'"><span style="color:#474646;"><strong>PROFORMA INVOICE</strong></span></t>
                                <t t-if="o.print_options=='sale'"><span style="color:#474646;"><strong>Quotation</strong></span></t></h3>
                            </div>
                        </div><br/>
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-6">
                                <div style="color:#474646;">
                                    <strong style="font-size:18px;">
                                        <!-- <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/> -->
                                        <span t-field="o.partner_id"/>
                                        <span t-if="o.partner_id.street">
                                            <br/><span t-field="o.partner_id.street"/>, 
                                        </span>
                                        <span t-if="o.partner_id.street2">
                                           <br/><span t-field="o.partner_id.street2"/>
                                        </span>
                                        <!-- <span t-if="o.partner_id.zip">
                                            &#160;<span t-field="o.partner_id.zip"/>,
                                        </span>
                                        <span t-if="o.partner_id.city">
                                            &#160;<span t-field="o.partner_id.city"/><br/>
                                        </span> -->
                                        <span t-if="o.partner_id.state_id">
                                            <br/><span t-field="o.partner_id.state_id.name"/>,
                                        </span>
                                        <span t-if="o.partner_id.country_id">
                                             <span t-field="o.partner_id.country_id"/>
                                        </span>
                                    </strong>
                                </div>
                                <div style="color:#474646;">
                                    <span><strong>Attn</strong></span>
                                    : <t t-if="o.od_contact_id and o.od_contact_id.title"><span t-field="o.od_contact_id.title"/></t><span t-field="o.od_contact_id.name"/>
                                    <t t-if="o.od_contact_id and o.od_contact_id.function">-<span t-field="o.od_contact_id.function"/></t>
                                </div>
                                <div style="color:#474646;">
                                    <span><strong>Contact</strong></span>
                                    : <t t-if="o.od_contact_id and o.od_contact_id.phone"><span t-field="o.od_contact_id.phone"/></t><t t-if="o.od_contact_id and o.od_contact_id.mobile"><t t-if="o.od_contact_id.phone"> | </t><span t-field="o.od_contact_id.mobile"/></t><t t-if="o.od_contact_id and o.od_contact_id.email"><t t-if="o.od_contact_id.phone or o.od_contact_id.mobile"> | </t><span t-field="o.od_contact_id.email"/></t>
                                </div>
                            </div>
                            <!-- <div class="col-5 col-offset-1" style="padding-left:6cm;">
                                <div style="color:#474646;">
                                    <span style="text-align:right;"><strong>Date</strong></span>
                                </div>
                                <div t-if="o.date_order" style="color:#474646;">
                                    <div t-esc="o.date_order.strftime('%d %B,%Y')"/>
                                </div>
                                <div style="color:#474646;">
                                    <span style="text-align:right;"><strong>Reference</strong></span>
                                </div>
                                <div t-if="o.name" style="color:#474646;">
                                    <div t-field="o.name"/>
                                </div>
                                <div style="color:#474646;">
                                    <span style="text-align:right;"><strong>From</strong></span>
                                </div>
                                <div t-if="o.user_id" style="color:#474646;">
                                    <div t-field="o.user_id"/>
                                </div>
                            </div> -->
                            <div class="col-5 col-offset-1" style="padding-left:3cm;">
                                <div style="color:#474646;">
                                    <span style="text-align:right;"><strong>Date</strong></span>
                                    <span style="padding-left:1cm;">: </span><span t-esc="o.date_order.strftime('%d %B %Y')"/>
                                </div>
                                <!-- <div t-if="o.date_order" style="color:#474646;">
                                    <div t-esc="o.date_order.strftime('%d %B,%Y')"/>
                                </div> -->
                                <div style="color:#474646;">
                                    <span style="text-align:right;"><strong>Reference</strong></span>
                                    : <span t-field="o.name"/>
                                </div>
                                <!-- <div t-if="o.name" style="color:#474646;">
                                    <div t-field="o.name"/>
                                </div> -->
                                <div style="color:#474646;">
                                    <span style="text-align:right;"><strong>From</strong></span>
                                    <span style="padding-left:1cm;">: </span><span t-field="o.user_id"/>
                                </div>
                                <!-- <div t-if="o.user_id" style="color:#474646;">
                                    <div t-field="o.user_id"/>
                                </div> -->
                            </div>
                        </div>
                        <br/>
                        <div>
                            <t t-set="display_discount" t-value="any(l.od_disc_amount for l in o.order_line)"/>
                            <t t-set="display_frequency" t-value="any(l.od_frequency for l in o.order_line)"/>
                            <table class="table table-sm" style="width:100%;border-left:1px solid black;border-right:1px solid black;border-top:1px solid black;border-bottom:1px solid black;">
                                <thead style="display: table-row-group">
                                    <tr>
                                        <th name="th_description" class="text-left" style="background-color:#DCDCDC;color:#474646;">Description</th>
                                        <th name="th_quantity" class="text-right" style="background-color:#DCDCDC;color:#474646;">Qty</th>
                                        <th name="th_priceunit" class="text-right" style="background-color:#DCDCDC;color:#474646;">Price</th>
                                        <th name="th_discount" t-if="display_discount" class="text-right" style="background-color:#DCDCDC;color:#474646;">
                                            <span>Disc.</span>
                                        </th>
                                        <th t-if="display_frequency" name="th_taxes" class="text-right" style="background-color:#DCDCDC;color:#474646;">Frq</th>
                                        <th name="th_subtotal" class="text-right" style="background-color:#DCDCDC;color:#474646;border-right:1px solid black;">
                                            <span>Amt (<span t-field="o.currency_id"/>)</span>
                                        </th>
                                    </tr>
                                </thead>
                                <t t-set="total_incl_discount" t-value="0"/>
                                <t t-set="total_discount" t-value="0"/>
                                <tbody>
                                    <t t-set="sl_no" t-value="0"/>
                                    
                                    <t t-foreach="o.order_line" t-as="l">
                                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if l.display_type == 'line_section' else 'font-italic o_line_note' if l.display_type == 'line_note' else ''">
                                            <t t-if="not l.display_type">
                                                <t t-set="sl_no" t-value="sl_no+1"/>
                                                <!-- <t t-set="disc_amt" t-value="0"/> -->
                                                <td name="td_name" style="border-bottom:1px solid white;">
                                                    <!-- <span style="color:#474646;" t-field="l.od_description_sale"/> -->
                                                    <span style="color:#474646;" t-field="l.name"/>
                                                </td>
                                                <td name="td_quantity" class="text-right" style="border-bottom:1px solid white;">
                                                    <span style="color:#474646;" t-esc="int(l.product_uom_qty)"/>
                                                </td>
                                                <td name="td_priceunit" class="text-right" style="border-bottom:1px solid white;">
                                                    <span style="color:#474646;" t-field="l.price_unit"/>
                                                </td>
                                                <td t-if="display_discount" class="text-right" style="border-bottom:1px solid white;;">
                                                    <!-- <t t-set="disc_amt" t-value="(l.price_unit *  (l.discount / 100.0))"/> -->
                                                    <span style="color:#474646;" t-esc="'{0:,.2f}'.format((l.od_disc_amount))"/>
                                                </td>
                                                <td t-if="display_frequency" class="text-right" style="border-bottom:1px solid white;;">
                                                    <span style="color:#474646;" t-esc="int(l.od_frequency)"/>
                                                </td>
                                                <td name="td_subtotal" class="text-right o_price_total" style="border-bottom:1px solid white;border-right:1px solid black;">
                                                    <!-- <span style="color:#474646;" t-esc="'{0:,.2f}'.format((l.price_subtotal))"/> -->
                                                    <t t-if="l.od_frequency">
                                                        <t t-set="line_sub_incl_discount" t-value="(l.product_uom_qty*l.price_unit*int(l.od_frequency))"/>
                                                        <t t-set="line_discount" t-value="(l.od_disc_amount*int(l.od_frequency))"/>
                                                    </t>
                                                    <t t-if="not l.od_frequency">
                                                        <t t-set="line_sub_incl_discount" t-value="(l.product_uom_qty*l.price_unit)"/>
                                                        <t t-set="line_discount" t-value="l.od_disc_amount"/>
                                                    </t>
                                                    <t t-set="total_incl_discount" t-value="total_incl_discount+line_sub_incl_discount"/>
                                                    <t t-set="total_discount" t-value="total_discount+line_discount"/>
                                                    <span style="color:#474646;" t-esc="'{0:,.2f}'.format((line_sub_incl_discount))"/>
                                                </td>
                                            </t>
                                            <t t-if="l.display_type == 'line_section'">
                                                <td name="td_section_line" style="border-right:1px solid black;" colspan="99">
                                                    <span t-field="l.name"/>
                                                </td>
                                            </t>
                                            <t t-if="l.display_type == 'line_note'">
                                                <td name="td_note_line" style="border-right:1px solid black;" colspan="99">
                                                    <span t-field="l.name"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                    <tr><td style="border-bottom:1px solid black;border-right:1px solid black;" colspan="99"/></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="clearfix" name="so_total_summary" style="border-top:1px solid white;">
                            <div id="total" class="row justify-content-end" name="total" style="border-top:1px solid white;">
                                <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ms-auto" style="border-top:1px solid white;">
                                    <table class="table table-sm" style="border-top:1px solid white;">
                                        <tr style="border-top:1px solid white;">
                                            <td name="td_amount_untaxed_label" style="border-bottom:1px solid white;border-top:1px solid black"><strong style=";color:#474646">Subtotal</strong></td>
                                            <td name="td_amount_untaxed" class="text-right" style="border-bottom:1px solid white;border-top:1px solid black;">
                                                <!-- <span style="color:#474646;border-bottom:1px solid white;" t-field="o.amount_untaxed"/> -->
                                                <span style="color:#474646;border-bottom:1px solid white;" t-esc="'{0:,.2f}'.format(total_incl_discount)"/><span t-field="o.currency_id"/>
                                            </td>
                                        </tr>
                                        <t t-if="display_discount">
                                            <tr class="o_total">
                                                    <td name="td_amount_total_label" style="border-bottom:1px solid white;background-color:#FFFFFF;border-right:1px solid black;"><strong style=";color:#474646">Discount</strong></td>
                                                    <td name="td_amount_total" style="color:#474646;border-bottom:1px solid white;background-color:#FFFFFF" class="text-right">
                                                        <span t-esc="'{0:,.2f}'.format(total_discount)"/><span t-field="o.currency_id"/>
                                                    </td>
                                            </tr>
                                            <tr class="o_total">
                                                    <td name="td_amount_total_label" style="border-bottom:1px solid white;background-color:#DCDCDC;;border-right:1px solid black;"><strong style=";color:#474646">Net Total</strong></td>
                                                    <td name="td_amount_total" style="color:#474646;border-bottom:1px solid white;background-color:#DCDCDC;" class="text-right">
                                                        <t t-esc="'{0:,.2f}'.format(total_incl_discount-total_discount)"/><span t-field="o.currency_id"/>
                                                    </td>
                                            </tr>
                                        </t>
                                        <t t-if="o.currency_id.name=='AED'">
                                            <t t-foreach="(o.tax_totals or {}).get('subtotals', [])" t-as="subtotal">
                                                <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                                                    <tr style="">
                                                        <td name="td_amount_by_group_label" style="border-bottom:1px solid white;">
                                                            <span style="color:#474646;" t-esc="tax_group['group_name']"/>
                                                        </td>
                                                        <td name="td_amount_by_group" class="text-right o_price_total" style="border-bottom:1px solid white;background-color:#FFFFFF;">
                                                            <span style="color:#474646;" t-out="tax_group['tax_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <tr class="o_total">
                                                <td name="td_amount_total_label" style="border-bottom:1px solid black;background-color:#DCDCDC;border-right:1px solid black;"><strong style="color:#474646">Total</strong></td>
                                                <td name="td_amount_total" style="color:#474646;border-bottom:1px solid black;background-color:#DCDCDC;" class="text-right">
                                                    <span t-field="o.amount_total"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            
                                            <tr style="">
                                                <td name="td_amount_untaxed_label" style="border-bottom:1px solid white;border-top:2px solid #DCDCDC;"><strong style="color:#474646;">In AED</strong></td>
                                                <td name="td_amount_untaxed" style="color:#474646;border-bottom:1px solid white;border-top:2px solid #DCDCDC;" class="text-right">
                                                <span style="color:#474646;" t-field="o.company_id.currency_id"/> <span t-esc="'{0:,.2f}'.format(o.amount_untaxed*o.od_exchange_rate)"/>
                                                </td>
                                            </tr>
                                            <t t-foreach="(o.tax_totals or {}).get('subtotals', [])" t-as="subtotal">
                                                <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                                                    <tr style="">
                                                        <td name="td_amount_by_group_label" style="border-bottom:1px solid white;">
                                                            <span style="color:#474646;" t-esc="tax_group['group_name']"/>
                                                        </td>
                                                        <td name="td_amount_by_group" class="text-right o_price_total" style="border-bottom:1px solid white;background-color:#FFFFFF;">
                                                            <span style="color:#474646;" t-field="o.company_id.currency_id"/> 
                                                            <span style="color:#474646;" t-esc="'{0:,.2f}'.format(tax_group['tax_amount_currency']*o.od_exchange_rate)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <tr class="o_total">
                                                <td name="td_amount_total_label" style="border-bottom:1px solid black;background-color:#DCDCDC;border-right:1px solid black"><strong style="color:#474646;">Net Total</strong></td>
                                                <td name="td_amount_total" class="text-right" style="border-bottom:1px solid black;background-color:#DCDCDC;">
                                                   <span style="color:#474646;" t-field="o.company_id.currency_id"/> <span style="color:#474646;" t-esc="'{0:,.2f}'.format(o.amount_total*o.od_exchange_rate)"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div t-if="o.note">
                            <span style="color:#474646;" t-field="o.note"/>
                        </div>
                        <!-- <br/>
                        <div t-if="o.note">
                            <span style="color:#474646;" t-field="o.note"/>
                        </div> -->
                        <br/>
                        <t t-if="o.od_sale_terms">
                            <!-- <div style="background-color:#B0C4DE;">
                                <b><span>Terms &amp; Conditions</span></b>
                            </div> -->
                            <div style="page-break-inside:avoid;">
                                <span style="color:#474646;" t-field="o.od_sale_terms"/>
                            </div>
                        </t>
                        <div style="color:#474646;page-break-inside:avoid;">
                            <br/><br/><b>Approved<br/><br/><br/>
                            Authorized Signatory
                            <!-- <b><span t-field="o.user_id"/><br/> -->
                            <!-- <span t-field="o.user_id.partner_id.function"/> -->
                            </b>
                        </div>
                        <!-- <br/><br/>
                        <div style="color:#474646;">
                            <div class="col-5; float-left">
                                <b>Authorized Signatory<br/><br/>
                                </b>
                            </div>
                            <div class="col-7; float-right">
                                 &#160;
                            </div>
                        </div> -->
                        <t t-if="o.od_incl_service_commitments and o.currency_id.id==131">
                            <p style="page-break-after:always;"/>
                            <!-- <div style="background-color:#B0C4DE;">
                                <b><span>SERVICE COMMITMENTS &amp; EXCLUSIONS</span></b>
                            </div>
                            <br/> -->
                            <span style="color:#474646;" t-field="o.od_service_commitments"/>
                        </t>
                    </div>
                    <!-- <div class="footer">
                        <div>
                            <hr style="border-top:2px solid #DCDCDC;"/>
                            <center style="color:#474646;">P. O. Box 71834 | Dubai | UAE | +971 391 6855 | sales@aspgulf.com | www.aspgulf.com</center>
                        </div>
                    </div> -->
                </t>
            </t>
        </t>
    </template>
</odoo>
                
