<?xml version="1.0"?>
<odoo>
	<record id="od_revenue_recognition_report_tree_view" model="ir.ui.view">
        <field name="name">od.revenue.recognition.report</field>
        <field name="model">od.revenue.recognition.report</field>
        <field name="arch" type="xml">
            <list string="Revenue Recognition Report" edit="0" create="0">
                <field name="date"/>
                <field name="revenue_date_from"/>
                <field name="revenue_date_to"/>
                <field name="contract_number"/>
                <field name="name"/>
                <field name="invoice"/>
                <field name="company_id" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
                <field name="revenue_line_id" invisible="1"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="account_id"/>
                <field name="revenue_account_id"/>
                <field name="debit" sum="Total"/>
                <field name="credit" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="od_revenue_recognition_report_action" model="ir.actions.act_window">
        <field name="name">Revenue Recognition Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">od.revenue.recognition.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="od_revenue_recognition_report_tree_view"/>
    </record>
</odoo>
