<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="asp_purchase_requisition">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12 text-center">
                                <span style="font-size:30px;"><strong>Purchase Requisition</strong></span><br/>
                                <span style="font-size:14px;">TRN:&#160;100203142300003</span>
                            </div>
                        </div><br/>
                        <div class="row">
                            <div class="col-6">
                                <div>
                                    <span><strong>Date</strong></span>
                                    <span style="padding-left:0.7cm;">: </span><span t-esc="o.date_order.strftime('%d-%b-%Y')"/>
                                </div>
                            </div>
                            <div class="col-1"/>
                            <div class="col-4 col-offset-1">
                                <div>
                                    <span style="text-align:right;"><strong>Order No</strong></span>
                                    <span>   : </span><span t-field="o.name"/>
                                </div>
                                
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div>
                                    <span><strong>Supplier</strong></span> : <span t-field="o.partner_id"/>
                                    <span t-if="o.partner_id.street">
                                        <br/><span style="padding-left:1.8cm;" t-field="o.partner_id.street"/>, 
                                    </span>
                                    <span t-if="o.partner_id.street2">
                                       <br/><span style="padding-left:1.8cm;" t-field="o.partner_id.street2"/>
                                    </span>
                                    <span t-if="o.partner_id.state_id">
                                        <br/><span style="padding-left:1.8cm;" t-field="o.partner_id.state_id.name"/>,
                                    </span>
                                    <span t-if="o.partner_id.country_id">
                                         <span t-field="o.partner_id.country_id"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-1"/>
                            <div class="col-4 col-offset-1">
                                <div>
                                    <span style="text-align:right;"><strong>CC</strong></span>
                                    <span style="padding-left:1.5cm;">: </span><span t-field="o.partner_id.ref"/>
                                </div>
                                <div>
                                    <span style="text-align:right;"><strong>Phone/Fax</strong></span>
                                    <span>: </span><span t-field="o.partner_id.phone"/>
                                </div>
                                <div>
                                    <span style="text-align:right;"><strong>SAM</strong></span>
                                    <span style="padding-left:1.2cm;">: </span><span t-field="o.partner_id.user_id"/>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-6">
                                <div>
                                    <span><strong>Attn</strong></span><span style="padding-left:0.8cm;">: </span><span t-field="o.od_contact_id.name"/>
                                </div>
                            </div>
                            <div class="col-1"/>
                            <div class="col-4 col-offset-1">
                                <div>
                                    <span style="text-align:right;"><strong>Mobile</strong></span>
                                    <span style="padding-left:0.8cm;">: </span><span t-field="o.od_contact_id.mobile"/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div>
                                    <span><strong>Reference&#160;</strong></span><span>: </span><span t-field="o.partner_ref"/>
                                </div>
                            </div>
                            <div class="col-1"/>
                            <div class="col-4 col-offset-1">
                                <div>
                                    &#160;
                                </div>
                            </div>
                        </div>
    
                        <br/>
                        <div>
                            <table class="table table-sm" style="width:100%;border-left:1px solid #DCDCDC;border-right:1px solid #DCDCDC;border-top:1px solid #DCDCDC;border-bottom:1px solid #DCDCDC;">
                                <thead>
                                    <tr>
                                        <th name="th_description" style="background-color:#DCDCDC;color:#474646;"><strong>No</strong></th>
                                        <th name="th_description" style="background-color:#DCDCDC;color:#474646;"><strong>Description</strong></th>
                                        <th name="th_quantity" style="background-color:#DCDCDC;color:#474646;" class="text-right"><strong>Qty</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl_no" t-value="0"/>
                                    <t t-foreach="o.order_line" t-as="order_line">
                                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if order_line.display_type == 'line_section' else 'font-italic o_line_note' if order_line.display_type == 'line_note' else ''">
                                            <t t-if="not order_line.display_type">
                                                <t t-set="sl_no" t-value="sl_no+1"/>
                                                
                                                <td class="text-center">
                                                    <t t-esc="sl_no"/>
                                                </td>
                                                <td id="product">
                                                    <span t-field="order_line.name"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="order_line.product_qty"/>
                                                    <span t-field="order_line.product_uom" groups="uom.group_uom"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td colspan="99" id="section">
                                                    <span t-field="order_line.name"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <p t-if="o.notes" >
                            <b>Terms &amp; Conditions:</b><br/><span t-field="o.notes"/>
                        </p>
                        <div class="oe_structure"/>
                        <span style="font-size:10px;">Note: System generated purchase order, no signature or stamp required.</span>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>




    