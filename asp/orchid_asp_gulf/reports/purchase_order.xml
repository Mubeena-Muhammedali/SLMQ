<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="asp_purchase_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- <template id="web_internal_layout_inherit_invoice_print" inherit_id="web.internal_layout">
