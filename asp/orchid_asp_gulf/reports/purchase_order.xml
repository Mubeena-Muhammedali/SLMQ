                <!-- <t t-call="web.internal_layout"> -->
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12 text-center">
                                <span style="font-size:30px;"><strong>Purchase Order</strong></span><br/>
                                <span style="font-size:14px;">TRN:&#160;100203142300003</span>
                            </div>
                        </div><br/>
                        <t t-if="o.state in ('purchase','done')">
                            <div class="row">
                                <div class="col-6">
                                    <div>
                                        <span><strong>Date</strong></span>
                                        <span style="padding-left:0.7cm;">: </span><span t-esc="o.date_order.strftime('%d-%b-%Y')"/>
                                    </div>
                                </div>
                                <div class="col-1"/>
                                <div class="col-4 col-offset-1">
                                    <div>
                                        <span style="text-align:right;"><strong>Order No</strong></span>
                                        <span>   : </span><span t-field="o.name"/>
                                    </div>
                                    
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div>
                                        <span><strong>Supplier</strong></span> : <span t-field="o.partner_id"/>
                                        <span t-if="o.partner_id.street">
                                            <br/><span style="padding-left:1.8cm;" t-field="o.partner_id.street"/>, 
                                        </span>
                                        <span t-if="o.partner_id.street2">
                                           <br/><span style="padding-left:1.8cm;" t-field="o.partner_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_id.state_id">
                                            <br/><span style="padding-left:1.8cm;" t-field="o.partner_id.state_id.name"/>,
                                        </span>
                                        <span t-if="o.partner_id.country_id">
                                             <span t-field="o.partner_id.country_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-1"/>
                                <div class="col-4 col-offset-1">
                                    <div>
                                        <span style="text-align:right;"><strong>CC</strong></span>
                                        <span style="padding-left:1.5cm;">: </span><span t-field="o.partner_id.ref"/>
                                    </div>
                                    <div>
                                        <span style="text-align:right;"><strong>Phone/Fax</strong></span>
                                        <span>: </span><span t-field="o.partner_id.phone"/>
                                    </div>
                                    <div>
                                        <span style="text-align:right;"><strong>SAM</strong></span>
                                        <span style="padding-left:1.2cm;">: </span><span t-field="o.partner_id.user_id"/>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <div class="row">
                                <div class="col-6">
                                    <div>
                                        <span><strong>Attn</strong></span><span style="padding-left:0.8cm;">: </span><span t-field="o.od_contact_id.name"/>
                                    </div>
                                </div>
                                <div class="col-1"/>
                                <div class="col-4 col-offset-1">
                                    <div>
                                        <span style="text-align:right;"><strong>Mobile</strong></span>
                                        <span style="padding-left:0.8cm;">: </span><span t-field="o.od_contact_id.phone"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div>
                                        <span><strong>Reference&#160;</strong></span><span>: </span><span t-field="o.partner_ref"/>
                                    </div>
                                </div>
                                <div class="col-1"/>
                                <div class="col-4 col-offset-1">
                                    <div>
                                        &#160;
                                    </div>
                                </div>
                            </div>
        
                            <br/>
                            <div>
                                <table class="table table-sm" style="width:100%;border-left:1px solid #DCDCDC;border-right:1px solid #DCDCDC;border-top:1px solid #DCDCDC;border-bottom:1px solid #DCDCDC;">
                                    <thead>
                                        <tr>
                                            <th name="th_description" style="background-color:#DCDCDC;color:#474646;"><strong>No</strong></th>
                                            <th name="th_description" style="background-color:#DCDCDC;color:#474646;"><strong>Description</strong></th>
                                            <th name="th_quantity" style="background-color:#DCDCDC;color:#474646;" class="text-right"><strong>Qty</strong></th>
                                            <th name="th_price_unit" style="background-color:#DCDCDC;color:#474646;" class="text-right"><strong>Price</strong></th>
                                            <th name="th_amount" style="background-color:#DCDCDC;color:#474646;" class="text-right"><strong>Amount</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sl_no" t-value="0"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                        <t t-foreach="o.order_line" t-as="line">
                                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">

                                                <t t-if="not line.display_type">
                                                    <t t-set="sl_no" t-value="sl_no+1"/>
                                                    
                                                    <td class="text-center">
                                                        <t t-esc="sl_no"/>
                                                    </td>
                                                    
                                                    <td id="product">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    
                                                    
                                                    <td class="text-right">
                                                        <span t-field="line.product_qty"/>
                                                        <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-field="line.price_unit"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                    </td>
                                                </t>
                                                <t t-if="line.display_type == 'line_section'">
                                                    <td colspan="99" id="section">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <t t-set="current_section" t-value="line"/>
                                                    <t t-set="current_subtotal" t-value="0"/>
                                                </t>
                                                <t t-if="line.display_type == 'line_note'">
                                                    <td colspan="99" id="note">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                </t>
                                            </tr>
                                            <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                                                <tr class="is-subtotal text-right">
                                                    <td colspan="99" id="subtotal">
                                                        <strong class="mr16">Subtotal</strong>
                                                        <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>

                                <div id="total" class="row justify-content-end">
                                    <div class="col-8">
                                        <tr>
                                            <td style="border-bottom:1px solid white;"><b>Total in words:<br/></b>
                                            
                                            <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/> Only</td>
                                        </tr>
                                    </div>
                                    <div class="col-4">
                                        <table class="table table-sm">
                                            <tr class="border-black">
                                                <td name="td_subtotal_label"><strong>Subtotal</strong></td>
                                                <td class="text-right">
                                                    <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                </td>
                                            </tr>
                                            <t t-if="o.currency_id.id==131">
                                                <tr>
                                                    <td name="td_taxes_label">Taxes</td>
                                                    <td class="text-right">
                                                        <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                    </td>
                                                </tr>
                                                <tr class="border-black o_total">
                                                    <td name="td_amount_total_label"><strong>Total</strong></td>
                                                    <td class="text-right">
                                                        <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t  t-if="(not (o.currency_id.id==131)) and (not o.od_print_po_currency)">
                                                <tr class="border-black">
                                                    <td name="td_subtotal_label" style="border-bottom:1px solid white;"><strong>In AED</strong></td>
                                                    <td class="text-right" style="border-bottom:1px solid white;">
                                                        <!-- <span t-esc="'{0:,.2f}'.format(o.amount_untaxed*o.od_exchange_rate)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.company_id.currency_id}"/> -->
                                                        <span t-field="o.company_id.currency_id"/> <span t-esc="'{0:,.2f}'.format(o.amount_untaxed*o.od_exchange_rate)"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td name="td_taxes_label">Taxes</td>
                                                    <td class="text-right">
                                                        <span t-field="o.company_id.currency_id"/> <span t-esc="'{0:,.2f}'.format(o.amount_tax*o.od_exchange_rate)"/>
                                                    </td>
                                                </tr>
                                                <tr class="border-black o_total">
                                                    <td name="td_amount_total_label" style="border-bottom:1px solid white;"><strong>Total</strong></td>
                                                    <td class="text-right" style="border-bottom:1px solid white;">
                                                        <span t-field="o.company_id.currency_id"/> <span t-esc="'{0:,.2f}'.format(o.amount_total*o.od_exchange_rate)"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t  t-if="(not (o.currency_id.id==131)) and (o.od_print_po_currency)">
                                                <tr>
                                                    <td name="td_taxes_label">Taxes</td>
                                                    <td class="text-right">
                                                        <span t-field="o.currency_id"/> <span t-esc="'{0:,.2f}'.format(o.amount_tax)"/>
                                                    </td>
                                                </tr>
                                                <tr class="border-black o_total">
                                                    <td name="td_amount_total_label" style="border-bottom:1px solid white;"><strong>Total</strong></td>
                                                    <td class="text-right" style="border-bottom:1px solid white;">
                                                        <span t-field="o.currency_id"/> <span t-esc="'{0:,.2f}'.format(o.amount_total)"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </div>
                                </div>
                                <p t-if="o.note" >
                                    <b>Terms &amp; Conditions:</b><br/><span t-field="o.note"/>
                                </p>
                                <div class="oe_structure"/>
                            </div>
                            <span style="font-size:10px;">Note: System generated purchase order, no signature or stamp required.</span>
                        </t>
                        <t t-else="">
                            <span>The order is not confirmed</span>
                        </t>
                    </div>
                    <!-- <div class="footer">
                        <div class="row">
                            <div class="col-6"/>
                            <div class="col-5 offset-1 text-right"><span>Page:</span><span class="page"/> of <span class="topage"/></div>
                        </div>
                        <div class="row">
                            <t t-foreach="o.company_id.header_image" t-as="images">
                                <t t-if="images.name == 'tax_invoice_footer'">
                                    <img style="padding-left:1cm;" t-if="images.img" t-att-src="'data:image/png;base64,%s' % to_text(images.img)"/>
                                </t>
                            </t>
                        </div>
                    </div>  -->              
                </t>
            </t>
        </t>
    </template>
</odoo>

            