                                            <t t-if="o.move_type=='out_refund'"><span  style="font-size:34px;">TAX CREDIT NOTE</span></t>
                                        </strong></span><br/>
                                        <span style="font-size:14px;padding-left:2cm;">ASPGulf TRN:&#160;100203142300003</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </xpath>
                </template>
                <t t-call="web.internal_layout"> -->
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12 text-center">
                                <span><strong>
                                    <t t-if="o.move_type=='out_invoice'"><span  style="font-size:30px;">TAX INVOICE</span></t>
                                    <t t-if="o.move_type=='out_refund'"><span  style="font-size:25px;">TAX CREDIT NOTE</span></t>
                                </strong></span><br/>
                                <span style="font-size:14px">TRN:&#160;100203142300003</span>
                            </div>
                        </div><br/>
                        <div class="oe_structure"/>
                        <div class="row">
                            <!-- <div class="col-6"> -->
                            <div class="col-7">
                                <div>
                                    <span><strong>Date</strong></span>
                                    <span>:&#160;</span><span t-esc="o.invoice_date.strftime('%d-%b-%Y')"/>
                                </div>
                            </div>
                            <!-- <div class="col-1"/> -->
                            <div class="col-2"/>
                            <!-- <div class="col-4 col-offset-1"> -->
                            <div class="col-5 col-offset-1">
                                <div>
                                    <span style="text-align:right;"><strong>Invoice No</strong></span>
                                    <span>:&#160;</span><span t-field="o.name"/>
                                </div>
                                <div>
                                    <span style="text-align:right;"><strong>CC</strong></span>
                                    <span style="padding-left:1.5cm;">:&#160;</span><span t-field="o.partner_id.ref"/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <!-- <div class="col-6"> -->
                            <div class="col-7">
                                <div>
                                    <span><strong>To</strong></span><span style="padding-left:0.5cm;">:&#160;</span><span t-field="o.partner_id"/>
                                    <span t-if="o.partner_id.street">
                                        <br/><span style="padding-left:1.2cm;" t-field="o.partner_id.street"/>, 
                                    </span>
                                    <span t-if="o.partner_id.street2">
                                       <br/><span style="padding-left:1.2cm;" t-field="o.partner_id.street2"/>
                                    </span>
                                    <span t-if="o.partner_id.state_id">
                                        <br/><span style="padding-left:1.2cm;" t-field="o.partner_id.state_id.name"/>,
                                    </span>
                                    <span t-if="o.partner_id.country_id">
                                         <span t-field="o.partner_id.country_id"/>
                                    </span>
                                </div>
                                <span><strong>TRN</strong></span><span style="padding-left:0.2cm;">: <span t-field="o.partner_id.vat"/></span>
                            </div>
                            <!-- <div class="col-1"/> -->
                            <div class="col-2"/>
                            <!-- <div class="col-4 col-offset-1"> -->
                            <div class="col-5 col-offset-1">
                                <div>
                                    <t t-if="o.move_type=='out_invoice'"><span style="text-align:right;"><strong>Ref No.</strong></span>
                                    <span style="padding-left:0.7cm;">:&#160;</span><span t-field="o.ref"/></t>
                                    <t t-else="">&#160;</t>
                                </div>
                                <div>
                                    <span style="text-align:right;"><strong>Phone/Fax</strong></span>
                                    <span>:&#160;</span><span t-field="o.partner_id.phone"/>
                                </div>
                                <div>
                                    <span style="text-align:right;"><strong>SAM</strong></span>
                                    <span style="padding-left:1.2cm;">:&#160;<span t-field="o.invoice_user_id"/></span>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div class="row">
                            <!-- <div class="col-6"> -->
                            <div class="col-7">
                                <div>
                                    <span><strong>Attn</strong></span><span style="padding-left:0.2cm;">:&#160;<span t-field="o.od_contact_id.name"/></span>
                                </div>
                            </div>
                            <!-- <div class="col-1"/> -->
                            <div class="col-2"/>
                            <!-- <div class="col-4 col-offset-1"> -->
                            <div class="col-5 col-offset-1">
                                <div>
                                    <span style="text-align:right;"><strong>Mobile</strong></span>
                                    <span style="padding-left:0.8cm;">:&#160;</span><span t-field="o.od_contact_id.phone"/>
                                </div>
                            </div>
                        </div>
    
                        <br/>
                        <div>
                            
                            <table class="table table-sm" style="width:100%;border-top:1px solid black;border-right:1px solid black;">
                                <thead style="display: table-row-group">
                                    <tr>
                                        <th name="th_description" class="text-left" style="background-color:#DCDCDC;border-right:1px solid black;border-left:1px solid black;border-top:1px solid black;width:2%;"><center>No</center></th>
                                        <th name="th_description" class="text-left" style="background-color:#DCDCDC;border-left:1px solid black;border-top:1px solid black;width:57%;">Description</th>
                                        <th name="th_priceunit" class="text-right" style="background-color:#DCDCDC;border-left:1px solid black;border-top:1px solid black;width:12%;"><center>Unit Price</center></th>
                                        <th name="th_quantity" class="text-right" style="background-color:#DCDCDC;border-left:1px solid black;border-top:1px solid black;width:8%;"><center>Qty</center></th>
                                        <th name="th_quantity" class="text-right" style="background-color:#DCDCDC;border-left:1px solid black;border-top:1px solid black;width:8%;"><center>Frq</center></th>
                                        <th name="th_subtotal" class="text-right" style="background-color:#DCDCDC;border-left:1px solid black;border-top:1px solid black;width:40%;">
                                            <span><center>Total Price</center></span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl_no" t-value="0"/>
                                    <t t-foreach="o.invoice_line_ids" t-as="l">
                                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if l.display_type == 'line_section' else 'font-italic o_line_note' if l.display_type == 'line_note' else ''">
                                            <!-- <t t-if="l.display_type == 'product'"> -->
                                                <t t-set="sl_no" t-value="sl_no+1"/>
                                                <td name="td_name" style="border-bottom:1px solid black;border-left:1px solid black;border-right:1px solid black;border-top:1px solid black;">
                                                    <center><span t-esc="sl_no"/></center>
                                                </td>
                                                <td name="td_name" style="border-bottom:1px solid black;border-right:1px solid black;border-top:1px solid black;">
                                                    <!-- <b><span t-field="l.product_id.name"/></b><br/> -->
                                                    <!-- <t t-if="l.od_period_from and l.od_period_to"><b>Service Period:<span  t-esc="l.od_period_from.strftime('%d-%b-%Y')"/>&#160;To:&#160;<span t-esc="l.od_period_to.strftime('%d-%b-%Y')"/></b><br/></t> -->
                                                    <t t-if="l.od_period_from and l.od_period_to">
                                                        <t t-if="l.od_contract_line_id">
                                                            <t t-set="mcl" t-value="l.od_contract_line_id"/>
                                                            <t t-foreach="l.od_contract_line_id" t-as="mc">
                                                                <t t-set="mcl" t-value="mc"/>
                                                            </t>
                                                            <!-- <t t-if="not l.od_contract_line_id.billing_cycle=='one_time'"> -->
                                                            <t t-if="not mcl.billing_cycle=='one_time'">
                                                                <b>Service Period:<span  t-esc="l.od_period_from.strftime('%d-%b-%Y')"/>&#160;To:&#160;<span t-esc="l.od_period_to.strftime('%d-%b-%Y')"/></b><br/>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <b>Service Period:<span  t-esc="l.od_period_from.strftime('%d-%b-%Y')"/>&#160;To:&#160;<span t-esc="l.od_period_to.strftime('%d-%b-%Y')"/></b><br/>
                                                        </t>
                                                    </t>
                                                    <!-- <span t-field="l.name"/> -->
                                                    <t t-if="isinstance(l.name, str)">
                                                       <t t-set="string_to_output" t-value="l.name.split('\n')" />
                                                       <t t-foreach="string_to_output" t-as="string_line">
                                                          <span t-esc="string_line"/>
                                                          <br />
                                                       </t>
                                                    </t>
                                                </td>
                                                <td name="td_priceunit" class="text-right" style="border-bottom:1px solid black;border-right:1px solid black;border-top:1px solid black;">
                                                    <t t-if="o.move_type=='out_invoice'"><span t-field="l.price_unit"/></t>
                                                    <t t-if="o.move_type=='out_refund'"><t t-esc="l.price_unit*(-1)"/></t>
                                                </td>
                                                <td name="td_quantity" class="text-right" style="border-bottom:1px solid black;border-right:1px solid black;border-top:1px solid black;">
                                                    <center>
                                                        <t t-if="o.move_type=='out_invoice'"><span t-esc="int(l.quantity)"/></t>
                                                        <t t-if="o.move_type=='out_refund'"><span t-esc="int(l.quantity*(-1))"/></t>
                                                    </center>
                                                </td>
                                                <td name="td_quantity" class="text-right" style="border-bottom:1px solid black;border-right:1px solid black;border-top:1px solid black;">
                                                    <center>
                                                        <t t-if="o.move_type=='out_invoice'"><span t-esc="int(l.od_frequency)"/></t>
                                                        <t t-if="o.move_type=='out_refund'"><span t-esc="int(l.od_frequency*(-1))"/></t>
                                                    </center>
                                                </td>
                                                
                                                <td name="td_subtotal" class="text-right o_price_total" style="background-color:#DCDCDC;border-bottom:1px solid black;border-top:1px solid black;">
                                                    <t t-if="o.move_type=='out_invoice'"><span t-esc="'{0:,.2f}'.format((l.price_subtotal))"/></t>
                                                    <t t-if="o.move_type=='out_refund'"><span t-esc="'{0:,.2f}'.format((l.price_subtotal*(-1)))"/></t>
                                                </td>
                                            <!-- </t>
                                            <t t-if="l.display_type == 'line_section'">
                                                <td name="td_section_line" colspan="99">
                                                    <span t-field="l.name"/>
                                                </td>
                                            </t>
                                            <t t-if="l.display_type == 'line_note'">
                                                <td name="td_note_line" colspan="99">
                                                    <span t-field="l.name"/>
                                                </td>
                                            </t> -->
                                        </tr>
                                    </t>
                                    <tr>
                                        <td colspan="2" style="border-bottom:1px solid white;"><b>Total in words:</b></td>
                                        <td colspan="3" style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;text-align:right;"><b>Total&#160;(<span t-field="o.currency_id"/>)</b></td>
                                        <td style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;text-align:right;"><b>
                                            <t t-if="o.move_type=='out_invoice'"><span t-esc="'{0:,.2f}'.format((o.amount_untaxed))"/></t>
                                            <t t-if="o.move_type=='out_refund'"><span t-esc="'{0:,.2f}'.format((o.amount_untaxed*(-1)))"/></t>
                                        </b></td>
                                    </tr>
                                    
                                    <tr>
                                        <td colspan="2" style="border-bottom:1px solid white;"><span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>&#160;Only</td>
                                        
                                        <td colspan="3" style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;text-align:right;"><b>VAT(5%)</b></td>
                                        <td style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;text-align:right;">
                                            <b>
                                                <t t-if="o.move_type=='out_invoice'"><span t-esc="'{0:,.2f}'.format(o.amount_tax)"/></t>
                                                <t t-if="o.move_type=='out_refund'"><span t-esc="'{0:,.2f}'.format(o.amount_tax*(-1))"/></t>
                                            </b>
                                        </td>
                                        
                                    </tr>
                                    <tr>
                                        <td colspan="2"></td>
                                        <td colspan="3" style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;text-align:right;"><b>Net Total(<span t-field="o.currency_id"/>)</b></td>
                                        <td style="border-left:1px solid black;border-right:1px solid black;border-bottom:1px solid black;text-align:right;">
                                            <b>
                                                <t t-if="o.move_type=='out_invoice'"><span t-esc="'{0:,.2f}'.format(o.amount_total)"/></t>
                                                <t t-if="o.move_type=='out_refund'"><span t-esc="'{0:,.2f}'.format(o.amount_total*(-1))"/></t>
                                            </b>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="row" t-if="o.ref and o.move_type=='out_refund'">
                            <div class="col-12">
                                <div>
                                    <span style="text-align:right;"><strong>Remarks</strong></span>
                                    <span>:&#160;</span><br/><span t-field="o.ref"/><br/>
                                </div>
                            </div>
                        </div>
                        <t t-if="o.ref and o.move_type=='out_refund'"><br/></t>
                        <div class="row" style="page-break-inside:avoid;">
                            <div class="col-6">
                                <div>
                                    <span><strong>Bank Details:</strong></span><br/>
                                    <!-- <span>ASP Gulf<br/>
                                    A/C No.: 01049-68164-97<br/>
                                    Mashreq Bank DIC Branch, Dubai<br/>
                                    Swift Code: BOMLAEAD<br/>
                                    IBAN: AE460330000010496816497</span> -->
                                    <span t-field="o.partner_bank_id.acc_holder_name"/><br/>
                                    A/C No.:&#160;<span t-field="o.partner_bank_id.acc_number"/><br/>
                                    <span t-field="o.partner_bank_id.bank_id.name"/>&#160;<span t-field="o.partner_bank_id.bank_id.od_bank_branch"/><br/>
                                    Swift Code:&#160;<span t-field="o.partner_bank_id.bank_id.bic"/><br/>
                                    IBAN:&#160;<span t-field="o.partner_bank_id.bank_id.od_bank_iban"/>
                                </div><br/>
                                <div t-if="o.invoice_payment_term_id">
                                    <span><strong>Terms &amp; Conditions: </strong></span> <span t-field="o.invoice_payment_term_id"/>
                                </div>
                            </div>
                        </div>
                        <span style="font-size:10px;">Note:&#160;System generated invoice, no signature or stamp required.</span>
                    </div>
                    <!-- <div class="footer">
                        <div class="row">
                            <div class="col-6"/>
                            <div class="col-5 offset-1 text-right"><span>Page:</span><span class="page"/> of <span class="topage"/></div>
                        </div>
                        <div class="row">
                            <t t-foreach="o.company_id.header_image" t-as="images">
                                <t t-if="images.name == 'tax_invoice_footer'">
                                    <img style="padding-left:1cm;" t-if="images.img" t-att-src="image_data_uri(images.img)"/>
                                </t>
                            </t>
                        </div>
                    </div>    -->            
                </t>
            </t>
        </t>
    </template>
</odoo>

            
