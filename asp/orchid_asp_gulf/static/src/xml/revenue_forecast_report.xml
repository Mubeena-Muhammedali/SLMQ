<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="orchid_asp_gulf.RevenueForecastReport">
        <div class="o_revenue_forecast_report"/>
    </t>

    <t t-name="orchid_asp_gulf.RevenueForecastReportContent">
        <div class="o_rfr p-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <h3 class="m-0">Revenue Forecast Report</h3>
                    <div class="text-muted small mt-1">
                        FY <t t-esc="state.start_date"/> to <t t-esc="state.end_date"/>
                        <span class="mx-2">|</span>
                        Rows <t t-esc="state.pager.from"/>-<t t-esc="state.pager.to"/> of <t t-esc="state.pager.total"/>
                    </div>
                </div>
                <div class="o_rfr_total">
                    <span>Total</span>
                    <strong><t t-esc="widget._fmt(state.grand_total)"/></strong>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap align-items-end gap-2">
                        <div class="o_rfr_field">
                            <label class="form-label mb-1 small text-muted">From</label>
                            <input type="date" class="form-control form-control-sm o_rfr_start" t-att-value="state.start_date"/>
                        </div>
                        <div class="o_rfr_field">
                            <label class="form-label mb-1 small text-muted">To</label>
                            <input type="date" class="form-control form-control-sm o_rfr_end" t-att-value="state.end_date"/>
                        </div>
                        <div class="o_rfr_field o_rfr_w220">
                            <label class="form-label mb-1 small text-muted">Customer</label>
                            <select class="form-control form-control-sm o_rfr_partner">
                                <option value="">All Customers</option>
                                <t t-foreach="state.partners" t-as="partner">
                                    <option t-att-value="partner.id" t-att-selected="partner.id == state.partner_id">
                                        <t t-esc="partner.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="o_rfr_field o_rfr_w300">
                            <label class="form-label mb-1 small text-muted">Contract</label>
                            <select class="form-control form-control-sm o_rfr_contract">
                                <option value="">All Contracts</option>
                                <t t-foreach="state.contracts" t-as="contract">
                                    <option t-att-value="contract.id" t-att-selected="contract.id == state.contract_id">
                                        <t t-esc="contract.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="o_rfr_field o_rfr_w220">
                            <label class="form-label mb-1 small text-muted">Category</label>
                            <select class="form-control form-control-sm o_rfr_category">
                                <option value="">All Categories</option>
                                <t t-foreach="state.categories" t-as="category">
                                    <option t-att-value="category.id" t-att-selected="category.id == state.category_id">
                                        <t t-esc="category.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="o_rfr_field o_rfr_w220">
                            <label class="form-label mb-1 small text-muted">Rev Type</label>
                            <select class="form-control form-control-sm o_rfr_rev_type">
                                <option value="">All</option>
                                <t t-foreach="state.rev_types" t-as="rev_type">
                                    <option t-att-value="rev_type" t-att-selected="rev_type === state.rev_type">
                                        <t t-esc="rev_type"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="o_rfr_field o_rfr_w260">
                            <label class="form-label mb-1 small text-muted">Search</label>
                            <input type="text" class="form-control form-control-sm o_rfr_search" placeholder="Customer / Contract / Rev Type" t-att-value="state.search"/>
                        </div>
                        <div class="o_rfr_field o_rfr_w90">
                            <label class="form-label mb-1 small text-muted">Rows</label>
                            <select class="form-control form-control-sm o_rfr_rows">
                                <option value="20" t-att-selected="state.pager.page_size === 20">20</option>
                                <option value="50" t-att-selected="state.pager.page_size === 50">50</option>
                                <option value="100" t-att-selected="state.pager.page_size === 100">100</option>
                                <option value="200" t-att-selected="state.pager.page_size === 200">200</option>
                                <option value="500" t-att-selected="state.pager.page_size === 500">500</option>
                                <option value="1000" t-att-selected="state.pager.page_size === 1000">1000</option>
                            </select>
                        </div>
                        <div class="ml-auto d-flex gap-2">
                            <button type="button" class="btn btn-success btn-sm o_rfr_export">Excel Download</button>
                            <button type="button" class="btn btn-primary btn-sm o_rfr_reload">Reload</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="o_rfr_pager d-flex justify-content-end align-items-center gap-2 mb-2">
                <span class="small text-muted">
                    Rows <t t-esc="state.pager.from"/>-<t t-esc="state.pager.to"/> of <t t-esc="state.pager.total"/>
                </span>
                <button t-if="state.pager.page &gt; 1" type="button" class="btn btn-primary btn-sm o_rfr_prev">Prev</button>
                <button t-if="state.pager.page &lt;= 1" type="button" class="btn btn-secondary btn-sm" disabled="disabled">Prev</button>
                <span class="small font-weight-bold">Page <t t-esc="state.pager.page"/> / <t t-esc="state.pager.pages"/></span>
                <button t-if="state.pager.page &lt; state.pager.pages" type="button" class="btn btn-primary btn-sm o_rfr_next">Next</button>
                <button t-if="state.pager.page &gt;= state.pager.pages" type="button" class="btn btn-secondary btn-sm" disabled="disabled">Next</button>
            </div>

            <div class="table-responsive o_rfr_scroll">
                <table class="table table-sm table-hover table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="o_rfr_sticky_col o_rfr_client">Client</th>
                            <th class="o_rfr_rev">Rev Type</th>
                            <t t-foreach="state.months" t-as="month">
                                <th class="text-right o_rfr_month"><t t-esc="month.label"/></th>
                            </t>
                            <th class="text-right o_rfr_month">Total</th>
                            <th class="o_rfr_actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="!rows.length">
                            <tr>
                                <td t-att-colspan="state.months.length + 4" class="text-center text-muted py-4">No data</td>
                            </tr>
                        </t>
                        <t t-foreach="rows" t-as="row">
                            <tr>
                                <td class="o_rfr_sticky_col">
                                    <button type="button" class="btn btn-link p-0 mr-2 o_rfr_toggle" t-att-data-key="row.key">
                                        <t t-if="state.unfolded[row.key]">▾</t>
                                        <t t-else="">▸</t>
                                    </button>
                                    <span class="o_rfr_client_name" t-esc="row.partner_name"/>
                                </td>
                                <td><t t-esc="row.rev_type"/></td>
                                <t t-foreach="state.months" t-as="month">
                                    <td class="text-right"><t t-esc="widget._fmt(row.months[month.key])"/></td>
                                </t>
                                <td class="text-right font-weight-bold"><t t-esc="widget._fmt(row.total)"/></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-link btn-sm p-0 o_rfr_open_contracts" t-att-data-key="row.key">Contracts</button>
                                </td>
                            </tr>
                            <t t-if="state.unfolded[row.key]">
                                <tr class="table-light">
                                    <td t-att-colspan="state.months.length + 4" class="p-0">
                                        <div class="p-2">
                                            <t t-if="state.loading[row.key]">
                                                <div class="text-muted">Loading...</div>
                                            </t>
                                            <t t-else="">
                                                <t t-set="detail_lines" t-value="state.details[row.key] || []"/>
                                                <t t-if="!detail_lines.length">
                                                    <div class="text-muted">No lines</div>
                                                </t>
                                                <t t-else="">
                                                    <div class="table-responsive o_rfr_detail_scroll">
                                                        <table class="table table-sm table-bordered mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th>Contract</th>
                                                                    <th>Service</th>
                                                                    <th>Cycle</th>
                                                                    <t t-foreach="state.months" t-as="month">
                                                                        <th class="text-right"><t t-esc="month.label"/></th>
                                                                    </t>
                                                                    <th class="text-right">Total</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <t t-foreach="detail_lines" t-as="line">
                                                                    <tr>
                                                                        <td>
                                                                            <div class="font-weight-bold"><t t-esc="line.contract_number"/></div>
                                                                            <div class="small text-muted"><t t-esc="line.contract_name"/></div>
                                                                        </td>
                                                                        <td><t t-esc="line.service_name"/></td>
                                                                        <td><t t-esc="line.billing_cycle"/></td>
                                                                        <t t-foreach="state.months" t-as="month">
                                                                            <td class="text-right"><t t-esc="widget._fmt(line.months[month.key])"/></td>
                                                                        </t>
                                                                        <td class="text-right font-weight-bold"><t t-esc="widget._fmt(line.total)"/></td>
                                                                    </tr>
                                                                </t>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="o_rfr_sticky_col">Total</th>
                            <th></th>
                            <t t-foreach="state.months" t-as="month">
                                <th class="text-right"><t t-esc="widget._fmt(state.totals[month.key])"/></th>
                            </t>
                            <th class="text-right"><t t-esc="widget._fmt(state.grand_total)"/></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="o_rfr_pager d-flex justify-content-end align-items-center gap-2 mt-2">
                <span class="small text-muted">
                    Rows <t t-esc="state.pager.from"/>-<t t-esc="state.pager.to"/> of <t t-esc="state.pager.total"/>
                </span>
                <button t-if="state.pager.page &gt; 1" type="button" class="btn btn-primary btn-sm o_rfr_prev">Prev</button>
                <button t-if="state.pager.page &lt;= 1" type="button" class="btn btn-secondary btn-sm" disabled="disabled">Prev</button>
                <span class="small font-weight-bold">Page <t t-esc="state.pager.page"/> / <t t-esc="state.pager.pages"/></span>
                <button t-if="state.pager.page &lt; state.pager.pages" type="button" class="btn btn-primary btn-sm o_rfr_next">Next</button>
                <button t-if="state.pager.page &gt;= state.pager.pages" type="button" class="btn btn-secondary btn-sm" disabled="disabled">Next</button>
            </div>
        </div>
    </t>
</templates>
